+#define SGPU_SESSION_DEPTH 4u
+#define SGPU_SESSION_OWNER 1u
+#define SGPU_SESSION_WRITE4 1u
+#define SGPU_SESSION_BUDGET_US 2000000u
+enum sgpu_session_state { SG_SESSION_OFF, SG_SESSION_READY, SG_SESSION_ACTIVE,
