  * protects this saturating per-boot count; no BO, pager or GPU state changes. */
 static uint32_t mockfs_santoni_trace_events;

+/* CPU-only trace traffic, including callers refused before admission. A
+ * dedicated mutex serializes saturating counts and immutable first refusal
+ * stages; caller identity/ABI/quota never depend on these observations.
+ * Lock order is mount -> diagnostic only. No diagnostic critical section
+ * enters VFS, acquires the mount/session mutex, or prints. The snapshot is
+ * coherent at copy time; a zero snapshot says nothing about later traffic.
+ * Mutex/API return on hardware and scheduler progress remain unproven. */
+static LCK_GRP_DECLARE(mockfs_santoni_diag_group, "santoni-trace-diag");
+static LCK_MTX_DECLARE(mockfs_santoni_diag_lock, &mockfs_santoni_diag_group);
+static struct sgpu_launch_trace_diag mockfs_santoni_trace_diag;
+
+/* Diagnostic mutex held by the caller. */
+static void __attribute__((noinline))
+mockfs_santoni_diag_inc(uint32_t *field)
+{
+    if (*field!=UINT32_MAX) ++*field;
+}
+
+/* outcome: 0 private-mount attempt, 1 accepted, 2 refused. A wrong-mount
+ * trace ioctl records seen/refused without inventing a private-mount attempt. */
+static void __attribute__((noinline))
+mockfs_santoni_diag_note(bool is_open, uint32_t outcome, uint32_t stage)
+{
+    struct sgpu_launch_trace_diag *d=&mockfs_santoni_trace_diag;
+    lck_mtx_lock(&mockfs_santoni_diag_lock);
+    uint32_t *seen=is_open?&d->seen_open:&d->seen_ioctl;
+    *seen=1;
+    if (outcome==0) {
+        mockfs_santoni_diag_inc(is_open?&d->open_attempts:&d->ioctl_attempts);
+    } else if (outcome==1) {
+        mockfs_santoni_diag_inc(is_open?&d->open_accepted:&d->ioctl_accepted);
+    } else {
+        uint32_t *first=is_open?&d->open_refuse_stage:&d->ioctl_refuse_stage;
+        if (!*first) *first=stage;
+        mockfs_santoni_diag_inc(is_open?&d->open_refused:&d->ioctl_refused);
+    }
+    lck_mtx_unlock(&mockfs_santoni_diag_lock);
+}
+
+/* Preserve the existing refusal errno; the first serialized denial wins. */
+static int __attribute__((noinline))
+mockfs_santoni_diag_refuse(bool is_open, uint32_t stage, int error)
+{
+    mockfs_santoni_diag_note(is_open,2,stage);
+    return error;
+}
+
+void
+santoni_gpu_user_launch_trace_snapshot(struct sgpu_launch_trace_diag *out)
+{
+    if (!out) return;
+    lck_mtx_lock(&mockfs_santoni_diag_lock);
+    *out=mockfs_santoni_trace_diag;
+    lck_mtx_unlock(&mockfs_santoni_diag_lock);
+}
