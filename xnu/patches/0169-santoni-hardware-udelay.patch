Subject: [PATCH 0169] santoni: busy-wait microsecond hardware edges and polls

Ordinary XNU delay() may schedule when cpu_idle_latency is zero. Use
a counter/YIELD wait for the existing 1-20 us SDHCI, GPIO-I2C and SPMI
polls. Preserve the duration and sleepability of all millisecond waits.
This corrects delay semantics; physical regression verification remains
required. No changes to GPIO wiring, report parsing or rail programming.

diff --git a/bsd/dev/santoni_sdhci.c b/bsd/dev/santoni_sdhci.c
--- a/bsd/dev/santoni_sdhci.c
+++ b/bsd/dev/santoni_sdhci.c
@@ -45,6 +45,7 @@
 #include <sys/proc.h>
 #include <sys/uio.h>
 #include <mach/vm_param.h>
+#include <mach/mach_time.h>
 #include <libkern/copyio.h>
 #include <miscfs/devfs/devfs.h>
 #include <kern/locks.h>
@@ -68,6 +69,24 @@
 extern ppnum_t pmap_find_phys(pmap_t pmap, addr64_t va);
 /* osfmk/arm/machine_routines.h, not exported to the BSD layer */
 extern vm_offset_t ml_io_map(vm_offset_t phys_addr, vm_size_t size);
+
+/*
+ * Hardware pulse/poll delay: never enter the scheduler and never use WFE.
+ * SweetCPU supplies no powergate_latency, so ml_delay_should_spin() is false
+ * on this port and ordinary delay(1..20) can block once per register/bit.
+ * ARM machine_delay_until() also uses WFE, which depends on an event stream.
+ * A counter deadline plus YIELD gives the GPIO bus a real short busy wait.
+ * Millisecond reset/rail waits and the polling thread's sleep stay sleepable.
+ */
+static void
+santoni_udelay(uint32_t usecs)
+{
+	uint64_t deadline;
+	clock_interval_to_deadline(usecs, NSEC_PER_USEC, &deadline);
+	while (mach_absolute_time() < deadline) {
+		__builtin_arm_yield();
+	}
+}
 
 /* ------------------------------------------------- SDHCI standard registers */
 #define SDHCI_BLOCK_SIZE        0x04
