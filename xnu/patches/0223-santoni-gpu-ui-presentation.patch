+        printf("SANTONI GPU: UI COPY RESULT pass=%u phase=%u error=%u seq=%u frames=%u wptr=%u exposed=%u busy=%u\n",
+            result==1?1u:0u,state.phase,state.error,state.sequence,state.frames,state.wptr,
+            state.exposed?1u:0u,state.busy?1u:0u);
