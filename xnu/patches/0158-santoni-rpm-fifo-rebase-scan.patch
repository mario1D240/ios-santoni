-		(void)santoni_smd_rx_drain();
-		if (!santoni_smd.resp_ready) {
-			delay(1000);
+
+	for (int attempt = 0; attempt < 2; attempt++) {
+		santoni_smd.resp_ready = false;
+		if (!santoni_smd_send(msg, sizeof(msg))) {
+			return false;
+		}
+		for (int ms = 0; ms < 700 && !santoni_smd.resp_ready; ms++) {
+			(void)santoni_smd_rx_drain();
+			if (!santoni_smd.resp_ready) {
+				delay(1000);
+			}
+		}
+		if (santoni_smd.resp_ready) {
+			break;
+		}
+		printf("SANTONI RPM: L%u: no answer (attempt %d)\n", ldo,
+		    attempt);
+		if (attempt == 0) {
+			/* Where does reply magic actually live? */
+			unsigned hits = 0;
+			for (uint32_t off = 0;
+			    off + 4u <= RPM_MSGRAM_SIZE && hits < 6u;
+			    off += 4u) {
+				uint32_t w = *(volatile uint32_t *)
+				    (santoni_smd.msgram + off);
+				if (w == RPM_MSG_REQ || w == RPM_MSG_MSG_ID) {
+					printf("SANTONI RPM: scan %#x: "
+					    "magic %08x\n", off, w);
+					hits++;
+				}
+			}
+			uint32_t gm = *(volatile uint32_t *)(santoni_smd.msgram +
