@@ -0,0 +1,35 @@
+#ifndef SANTONI_GRAPHICS_VM32_DRAFT_H
+#define SANTONI_GRAPHICS_VM32_DRAFT_H
+#include "santoni_gpu_graphics.h"
+/* Engineering virtual aperture only: next32MiB-aligned window after the
+ * tested legacy render aperture. This is NOT a physical/DTS/TZ carveout. */
+#define GVM_BYTES SGPU_GRAPHICS_WIDE_BYTES
+#define GVM_BASE SGPU_GRAPHICS_WIDE_VA
+#define GVM_PAGES (GVM_BYTES/SGPU_PAGE)
+#define GVM_L3_PAGES (GVM_PAGES/512u)
+#define GVM_TABLE_PAGES (GVM_L3_PAGES+1u)
+#define GVM_FENCE_PAGE GVM_L3_PAGES
+#define GVM_L2_FIRST (GVM_BASE>>21)
+#define GVM_PTE_RW UINT64_C(0x0060000000000e47)
+struct gvm_memory {uint8_t *va;uint64_t pa[GVM_TABLE_PAGES];uintptr_t cookie;uint32_t bytes;};
+struct gvm_ops {
+    void *context;
+    /* Must prove a fresh private allocator lease, never a public/retired alias. */
+    bool (*owned_private)(void *,const struct gvm_memory *);
+    uint64_t (*page_pa)(void *,const struct gvm_memory *,uint32_t);
+    bool (*reserved_pa)(void *,uint64_t);
+};
+enum gvm_error { GVM_OK,GVM_INPUT,GVM_OWNER,GVM_PAGE,GVM_RESERVED,GVM_NONZERO,GVM_CHANGED,GVM_ROOT };
+struct gvm {
+    struct gvm_memory memory;struct gvm_ops ops;
+    uint64_t ptes[GVM_PAGES],l2[GVM_L3_PAGES];
+    uint32_t error;bool prepared;
+};
+/* RAM-only construction/verification. No MMIO/SMC/table publication/free.
+ * Adapter must independently stop CP, fault SID0, disable CB and check every
+ * publication/flush before using proposed descriptors on hardware. */
+bool gvm_prepare(struct gvm *,const struct gvm_memory *,const struct gvm_ops *);
+bool gvm_verify(struct gvm *);
+bool gvm_propose_l2(struct gvm *,const uint64_t *,uint64_t *);
+bool gvm_index(const struct gvm *,uint32_t,uint32_t *);
+#endif
