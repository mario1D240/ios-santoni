+enum sgpu_session_reason { SG_SESSION_NONE, SG_SESSION_QUOTA, SG_SESSION_CLOSE,
+    SG_SESSION_FAILURE };
+enum sgpu_request_state { SG_REQUEST_EMPTY, SG_REQUEST_QUEUED, SG_REQUEST_ACTIVE,
