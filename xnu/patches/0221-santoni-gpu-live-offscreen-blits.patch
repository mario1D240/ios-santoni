 #undef SG_RENDER_FN

+bool __attribute__((noinline)) sgpu_render_validate(const struct sgpu_render_memory *m)
+{ return sgpu_render_memory_valid(m); }
+
+/* Live full-size copy diagnostic. The legacy TTBR, firmware, ring, marker
+ * and G3 mappings remain owned and unchanged. Four unused L2 entries point
+ * to the prepared 8MiB pixel window, starting after the legacy 2MiB window.
+ * One worker only; no queue/client is published, no live backing is freed.
+ */
+static struct {
+    bool attempted, linked;
+    struct sgpu_render_arena arena;
+    struct sgpu_render_live_result result;
+    struct sgpu_render_plane source, destination;
+    uint32_t commands[SGPU_RENDER_WORDS];
+    uint64_t legacy_l3[SGPU_PAGE / 8];
+} sgpu_render_live;
+
+static bool __attribute__((noinline)) sgpu_render_live_fail(uint32_t error)
+{
+    struct sgpu_render_live_result *r = &sgpu_render_live.result;
+    struct probe *p = &session_core.p;
+    if (!r->error) {
+        r->error = error;
+        r->failure = p->report ? p->report->failure : (struct sgpu_failure){0};
+    }
+    r->exposed = sgpu_render_live.arena.exposed;
+    sgpu_render_abort(&sgpu_render_live.arena, SG_RENDER_FAULT);
+    sgpu_session_stop();
+    return false;
+}
+
+static bool __attribute__((noinline)) sgpu_render_live_tables(bool linked)
+{
+    struct sgpu_render_arena *a = &sgpu_render_live.arena;
+    struct sgpu_memory *old = &session_core.p.memory;
+    if (!sgpu_memory_validate(old) || !sgpu_render_tables_valid(a) ||
+        sgpu_render_overlap(old->va, SGPU_POOL_BYTES, a->memory.tables, SGPU_RENDER_TABLE_PAGES * SGPU_PAGE) ||
+        sgpu_render_overlap(old->va, SGPU_POOL_BYTES, a->memory.pixels, a->memory.pages * SGPU_PAGE)) return false;
+    /* New PAs must not alias ANY retained bootstrap page, including tables. */
+    for (unsigned i = 0; i < SGPU_POOL_PAGES; i++) {
+        for (unsigned j = 0; j < SGPU_RENDER_TABLE_PAGES; j++)
+            if (old->pa[i] == a->memory.table_pa[j]) return false;
+        for (unsigned j = 0; j < a->memory.pages; j++)
+            if (old->pa[i] == a->memory.pa[j]) return false;
+    }
+    const uint64_t *l1 = (const uint64_t *)(const void *)old->va;
+    const uint64_t *l2 = (const uint64_t *)(const void *)(old->va + SGPU_PAGE);
+    const uint64_t *l3 = (const uint64_t *)(const void *)(old->va + 2 * SGPU_PAGE);
+    for (unsigned i = 0; i < SGPU_PAGE / 8; i++) {
+        if (l3[i] != sgpu_render_live.legacy_l3[i]) return false;
+        if (l1[i] != (i == 0 ? old->pa[1] | 3 : 0)) return false;
+        uint64_t want = i == (SGPU_VA_BASE >> 21) ? old->pa[2] | 3 : 0;
+        if (linked && i >= (SGPU_RENDER_VA >> 21) && i < (SGPU_RENDER_VA >> 21) + 4)
+            want = a->memory.table_pa[2 + i - (SGPU_RENDER_VA >> 21)] | 3;
+        if (l2[i] != want) return false;
+    }
+    return true;
+}
+
+static bool __attribute__((noinline)) sgpu_render_live_state(uint32_t wptr, uint32_t me, uint32_t cb, uint32_t route)
+{
+    struct probe *p = &session_core.p;
+    if (!p->gpu_live || !p->gpu_owned || !p->gpu_resumed || !p->smmu_live ||
+        !p->dma_exposed || !p->commands_started || p->restoring) return false;
+    const uint32_t values[][3] = {
+        {SG_GPU,SG_TRUST,0},{SG_GPU,SG_RB_RPTR,wptr},{SG_GPU,SG_RB_WPTR,wptr},
+        {SG_GPU,SG_ME_CNTL,me},{SG_GPU,SG_INT_MASK,0},
+        {SG_GPU,SG_RB_BASE,SGPU_RING_VA},{SG_GPU,SG_RB_BASE_HI,0},
+        {SG_GPU,SG_RB_CNTL,BIT(27)|(2u<<8)|9u},
+        {SG_GPU,SG_PM4_BASE,SGPU_PM4_VA},{SG_GPU,SG_PM4_BASE+4,0},
+        {SG_GPU,SG_PFP_BASE,SGPU_PFP_VA},{SG_GPU,SG_PFP_BASE+4,0},
+        {SG_SMMU,SG_CB,cb},{SG_SMMU,SG_S2CR0,route},{SG_SMMU,SG_GR1_CBA2R0,1},
+        {SG_SMMU,SG_GR1_CBAR0,0x1f300u},{SG_SMMU,SG_CB_TTBCR,0x00802560u},
+        {SG_SMMU,SG_CB_TTBCR2,0x38010u},{SG_SMMU,SG_CB_MAIR0,0xff44u},
+        {SG_SMMU,SG_CB_MAIR0+4,0},{SG_SMMU,SG_CB_TTBR0,(uint32_t)p->memory.pa[0]},
+        {SG_SMMU,SG_CB_TTBR0+4,0x10000u}};
+    for (unsigned i = 0; i < COUNT(values); i++)
+        if (!sgpu_stock_check32(p, (enum sgpu_block)values[i][0], values[i][1], values[i][2])) return false;
+    if ((read32(p,SG_SMMU,0x20)&BIT(27)) && !sgpu_stock_check32(p,SG_SMMU,SG_SMR0,BIT(31))) return false;
+    faults(p);
+    return !has_fault(p->report) && poll(p, SG_GPU, SG_STATUS, SG_IDLE_MASK, 0, 10000);
+}
+
+static bool __attribute__((noinline)) sgpu_render_live_link(void)
+{
+    struct probe *p = &session_core.p;
+    struct sgpu_render_arena *a = &sgpu_render_live.arena;
+    struct sgpu_render_live_result *r = &sgpu_render_live.result;
+    r->phase = SG_LIVE_TABLES;
+    if (!sgpu_render_live_tables(false) || !sgpu_render_live_state(170,0,0x1127,0))
+        return sgpu_render_live_fail(SG_BAD_MEMORY);
+    trace(p, "RENDER owned link; legacy TTBR/control mappings retained", SGPU_RENDER_VA, a->memory.pages, 0);
+    /* Recheck after every diagnostic callback, before taking the CP/CB offline. */
+    if (!sgpu_render_live_tables(false) || !sgpu_render_live_state(170,0,0x1127,0))
+        return sgpu_render_live_fail(SG_BAD_MEMORY);
+    r->phase = SG_LIVE_HALT;
+    a->exposed = r->exposed = true; /* conservative retention before any handoff write */
+    if (!checked_write32(p, SG_GPU, SG_ME_CNTL, ~0u, SG_CP_STOP_MASK) ||
+        !poll(p, SG_GPU, SG_STATUS, SG_IDLE_MASK, 0, 10000) ||
+        !checked_write32(p, SG_SMMU, SG_S2CR0, ~0u, SG_S2CR_FAULT) ||
+        !checked_write32(p, SG_SMMU, SG_CB, ~0u, 0x1126u) ||
+        !sgpu_render_live_state(170,3,0x1126,SG_S2CR_FAULT)) return sgpu_render_live_fail(SG_BAD_SMMU);
+    r->phase = SG_LIVE_LINK;
+    if (!sgpu_render_live_tables(false)) return sgpu_render_live_fail(SG_BAD_MEMORY);
+    p->ops->clean(p->ops->ctx, a->memory.tables, SGPU_RENDER_TABLE_PAGES * SGPU_PAGE);
+    uint64_t *l2 = (uint64_t *)(void *)(p->memory.va + SGPU_PAGE);
+    for (unsigned i = 0; i < 4; i++)
+        l2[(SGPU_RENDER_VA >> 21) + i] = a->memory.table_pa[2 + i] | 3;
+    sgpu_render_live.linked = true;
+    p->ops->clean(p->ops->ctx, l2, SGPU_PAGE);
+    if (!sgpu_render_live_tables(true)) return sgpu_render_live_fail(SG_BAD_MEMORY);
+    r->phase = SG_LIVE_TLB;
+    /* vendor arm-smmu.c arm_smmu_tlb_inv_context/arm_smmu_tlb_sync:
+     * ASID maintenance commands are checked by TLBSYNC -> TLBSTATUS, not an
+     * echoed command value. These TWO command registers alone use readable
+     * mask zero; all CP/CB configuration and RPTR/WPTR checks use full masks.
+     * ASID1 is read back from the unchanged owned TTBR high word above.
+     */
+    if (!checked_write32(p, SG_SMMU, SG_CB_TLBIASID, 0, 1) ||
+        !checked_write32(p, SG_SMMU, SG_CB_TLBSYNC, 0, 0) ||
+        !poll(p, SG_SMMU, SG_CB_TLBSTATUS, 1, 0, 10000)) return sgpu_render_live_fail(SG_TLB_TIMEOUT);
+    r->phase = SG_LIVE_ENABLE;
+    if (!sgpu_render_live_tables(true) || !sgpu_render_live_state(170,3,0x1126,SG_S2CR_FAULT) ||
+        !checked_write32(p, SG_SMMU, SG_CB, ~0u, 0x1127u) ||
+        !sgpu_render_live_state(170,3,0x1127,SG_S2CR_FAULT) ||
+        !checked_write32(p, SG_SMMU, SG_S2CR0, ~0u, 0) ||
+        !sgpu_render_live_state(170,3,0x1127,0) ||
+        !checked_write32(p, SG_GPU, SG_ME_CNTL, ~0u, 0) ||
+        !sgpu_render_live_state(170,0,0x1127,0)) return sgpu_render_live_fail(SG_BAD_SMMU);
+    return true;
+}
+
+static bool __attribute__((noinline)) sgpu_render_live_pattern(uint8_t *source, uint8_t *destination,
+    uint32_t pass, uint32_t width, uint32_t height, uint32_t stride)
+{
+    if (!source || !destination || !width || !height || width > 4096 || height > 4096 ||
+        stride < width * 4 || (stride & 63) || (uint64_t)stride * height > SGPU_RENDER_BO_BYTES) return false;
+    for (unsigned y = 0; y < height; y++) {
+        for (unsigned x = 0; x < width; x++) {
+            unsigned i = y * stride + x * 4;
+            source[i] = (uint8_t)(x * 13 + pass * 17);
+            source[i+1] = (uint8_t)(y * 11 + pass * 23);
+            source[i+2] = (uint8_t)((x + y) * 7 + pass * 31);
+            source[i+3] = 0xff;
+        }
+        for (unsigned i = width * 4; i < stride; i++)
+            source[y * stride + i] = 0x3c;
+    }
+    for (unsigned i = 0; i < height * stride; i++) destination[i] = 0xa5;
+    return true;
+}
+
+static bool __attribute__((noinline)) sgpu_render_live_compare(const uint8_t *source,
+    const uint8_t *destination, uint32_t width, uint32_t height, uint32_t stride)
+{
+    if (!source || !destination || !width || !height || width > 4096 || height > 4096 ||
+        stride < width * 4 || (stride & 63) || (uint64_t)stride * height > SGPU_RENDER_BO_BYTES) return false;
+    for (unsigned y = 0; y < height; y++)
+        for (unsigned i = 0; i < stride; i++) {
+            uint8_t want = i < width * 4 ? source[y * stride + i] : 0xa5;
+            if (((const volatile uint8_t *)destination)[y * stride + i] != want) return false;
+        }
+    return true;
+}
+
+static bool __attribute__((noinline)) sgpu_render_live_job(uint32_t pass)
+{
+    struct sgpu_render_arena *a = &sgpu_render_live.arena;
+    struct sgpu_render_live_result *r = &sgpu_render_live.result;
+    struct probe *p = &session_core.p;
+    uint8_t *source = NULL, *destination = NULL;
+    r->phase = SG_LIVE_SUBMIT;
+    r->publish_attempted = false;
+    if (!sgpu_render_live_tables(true) || !sgpu_render_live_state(r->wptr,0,0x1127,0) ||
+        !sgpu_render_cpu(a,1,sgpu_render_live.source.handle,0,SGPU_RENDER_BYTES,&source) ||
+        !sgpu_render_cpu(a,1,sgpu_render_live.destination.handle,0,SGPU_RENDER_BYTES,&destination))
+        return sgpu_render_live_fail(SG_BAD_MEMORY);
+    if (!sgpu_render_live_pattern(source,destination,pass,SGPU_RENDER_WIDTH,SGPU_RENDER_HEIGHT,SGPU_RENDER_STRIDE))
+        return sgpu_render_live_fail(SG_BAD_MEMORY);
+    uint32_t words = sgpu_render_begin(a,1,&sgpu_render_live.source,&sgpu_render_live.destination,
+        sgpu_render_live.commands,SGPU_RENDER_WORDS);
+    if (words != 73 || r->wptr > SGPU_PAGE/4 - 1 - words || !sgpu_render_live_tables(true) ||
+        !sgpu_render_live_state(r->wptr,0,0x1127,0)) return sgpu_render_live_fail(SG_BAD_MEMORY);
+    uint32_t *ring = (uint32_t *)(void *)(p->memory.va + 3 * SGPU_PAGE);
+    for (unsigned i = 0; i < words; i++) ring[r->wptr+i] = sgpu_render_live.commands[i];
+    r->sequence = a->busy;
+    r->wptr += words;
+    r->publish_attempted = true;
+    r->submitted++;
+    if (!consume(p,r->wptr)) return sgpu_render_live_fail(p->report->error ? p->report->error : SG_COMMAND_TIMEOUT);
+    r->phase = SG_LIVE_FENCE;
+    if (!sgpu_render_wait(a)) return sgpu_render_live_fail(
+        a->error == SG_RENDER_TIMEOUT ? SG_COMMAND_TIMEOUT : SG_FAULT);
+    if (!sgpu_render_live_tables(true) || !sgpu_render_live_state(r->wptr,0,0x1127,0))
+        return sgpu_render_live_fail(SG_BAD_MEMORY);
+    r->phase = SG_LIVE_COMPARE;
+    if (!sgpu_render_live_compare(source,destination,SGPU_RENDER_WIDTH,SGPU_RENDER_HEIGHT,SGPU_RENDER_STRIDE))
+        return sgpu_render_live_fail(SG_MARKER_MISMATCH);
+    r->completed++;
+    r->pixels += SGPU_RENDER_WIDTH * SGPU_RENDER_HEIGHT;
+    trace(p, "RENDER full BGRA copy/readback completed", pass, r->sequence, r->pixels);
+    return true;
+}
+
+bool __attribute__((noinline)) sgpu_render_live_start(const struct sgpu_ops *ops, uint32_t mode,
+    uint32_t enabled, const uint8_t *blob, size_t length, const struct sgpu_render_memory *memory,
+    struct sgpu_report *boot, struct sgpu_render_live_result *out)
+{
+    if (!ops || !memory || !boot || !out || enabled != 1 || mode != 3 ||
+        ops->stock_unsecure != 1 || ops->stock_pixels != 1 || ops->g3 != 1 || ops->session != 1 ||
+        sgpu_render_live.attempted || memory->pages != SGPU_RENDER_LIVE_PAGES ||
+        !sgpu_render_memory_valid(memory)) return false;
+    sgpu_render_live.attempted = true;
+    sgpu_render_live.result = (struct sgpu_render_live_result){.requested=true,.phase=SG_LIVE_BOOT};
+    bool passed = false;
+    if (!sgpu_session_start(ops,mode,blob,length,boot)) {
+        sgpu_render_live.result.error = boot->error && boot->error != SG_STOCK_HELD ? boot->error : SG_BAD_MODE;
+        goto done;
+    }
+    struct probe *p = &session_core.p;
+    sgpu_render_live.result.started = true;
+    sgpu_render_live.result.phase = SG_LIVE_READY;
+    if (!sgpu_session_prepare()) { (void)sgpu_render_live_fail(SG_BAD_MODE); goto done; }
+    const uint64_t *legacy = (const uint64_t *)(const void *)(p->memory.va + 2 * SGPU_PAGE);
+    for (unsigned i = 0; i < SGPU_PAGE / 8; i++) sgpu_render_live.legacy_l3[i] = legacy[i];
+    sgpu_session_stop(); /* no queue/client is ever published; legacy BOs remain mapped */
+    p->report->stage = SGPU_RENDER_LIVE_STAGE;
+    if (!sgpu_render_init(&sgpu_render_live.arena,memory,&session_core.ops)) {
+        (void)sgpu_render_live_fail(SG_BAD_MEMORY); goto done;
+    }
+    uint32_t source = sgpu_render_new(&sgpu_render_live.arena,1,SGPU_RENDER_BYTES);
+    uint32_t destination = sgpu_render_new(&sgpu_render_live.arena,1,SGPU_RENDER_BYTES);
+    if (!source || !destination) { (void)sgpu_render_live_fail(SG_BAD_MEMORY); goto done; }
+    sgpu_render_live.source = (struct sgpu_render_plane){source,0,SGPU_RENDER_WIDTH,
+        SGPU_RENDER_HEIGHT,SGPU_RENDER_STRIDE,SG_RENDER_BGRA8};
+    sgpu_render_live.destination = sgpu_render_live.source;
+    sgpu_render_live.destination.handle = destination;
+    sgpu_render_live.result.wptr = 170;
+    if (!sgpu_render_live_link() || !sgpu_render_live_job(1) || !sgpu_render_live_job(2)) goto done;
+    sgpu_render_live.result.phase = SG_LIVE_DONE;
+    sgpu_render_live.result.passed = passed = true;
+done:
+    sgpu_render_live.result.exposed = sgpu_render_live.arena.exposed;
+    *out = sgpu_render_live.result;
+    return passed;
+}
+
 #endif
