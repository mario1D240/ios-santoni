     if (stopped && smmu.changed) report->smmu_restored = smmu_restore(&p, &smmu);
@@ -845,6 +861,6 @@
         if (!report->error) report->error = SG_ROLLBACK_FAILED;
         passed = false;
     }
-    return passed;
