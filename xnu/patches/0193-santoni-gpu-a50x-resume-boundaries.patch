         !checked_write32(p, SG_GPU, SG_ISDB_CNT, ~0u, 0x182u)) return false;
+    p->gpu_resumed = true;
+    return true;
+}
+
+static void __attribute__((noinline)) sgpu_a505_init(struct probe *p, uint32_t pfp_version)
+{
+    /* Register configuration follows checked resume, reset and translation setup. */
     static const uint32_t regs[][2] = {
         {0xc124,3}, {0x24c,1}, /* VBIF RR, RBBM AHB error reporting */
         {0x3a58,2}, /* UCHE_CACHE_WAYS */
