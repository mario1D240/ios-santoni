+     * Keep the original consume() and every legacy/UI producer unchanged. */
+    p->ops->clean(p->ops->ctx,ring,SGPU_PAGE);
+    if (!sgpu_graphics_hw_tables() || !sgpu_graphics_hw_state(previous,0,0x1127,0) ||
+        !sgpu_graphics_hw_tables()) {sgpu_graphics_hw_fail(SG_BAD_MEMORY);goto done;}
+    if (!checked_write32(p,SG_GPU,SG_RB_WPTR,~0u,pos+n) ||
+        !poll(p,SG_GPU,SG_RB_RPTR,~0u,pos+n,POLL_US) ||
+        !poll(p,SG_GPU,SG_STATUS,SG_BUSY_MASK,0,POLL_US)) {sgpu_graphics_hw_fail(SG_COMMAND_TIMEOUT);goto done;}
+    ok=true;
+done:
+    p->report=saved;return ok;
+}
+void __attribute__((noinline)) sgpu_graphics_hw_snapshot(struct sgpu_graphics_hw_result *out)
+{
+    if(out)*out=(struct sgpu_graphics_hw_result){.error=sgpu_graphics_hw.error,.wptr=sgpu_graphics_hw.wptr,
+        .pending=sgpu_graphics_hw.pending,.ready=sgpu_graphics_hw_ready(),.failed=sgpu_graphics_hw.failed,
+        .exposed=sgpu_graphics_hw.exposed,.failure=sgpu_graphics_hw.report.failure};
+}
+
 #endif
diff --git a/bsd/dev/santoni_gpu_graphics.c b/bsd/dev/santoni_gpu_graphics.c
new file mode 100644
index 0000000..dc20059
--- /dev/null
+++ b/bsd/dev/santoni_gpu_graphics.c
@@ -0,0 +1,314 @@
+#include "santoni_gpu_graphics.h"
+#include <string.h>
+
+#if defined(ARM64_BOARD_CONFIG_SANTONI)
+/* Exact PTE_FLAGS in santoni_gpu_core.c: descriptor3, AttrIdx1, SH2, AF,
+ * nG and PXN/UXN. Keep both high execute-never bits, not just low attributes.
+ * AP3 is read-only and AP1 is writable in the programmed 4K Santoni tables. */
+#define CLIENT_PTE_FLAGS (3ull|(1ull<<2)|(2ull<<8)|(1ull<<10)|(1ull<<11)|(3ull<<53))
+#define CLIENT_PTE_RO (CLIENT_PTE_FLAGS|(3ull<<6))
+#define CLIENT_PTE_RW (CLIENT_PTE_FLAGS|(1ull<<6))
+#define CLIENT_FN __attribute__((noinline))
+
+static bool CLIENT_FN sgpu_graphics_admitted(const struct sgpu_graphics *c, uint64_t owner)
+{
+    return c && c->initialized && !c->closed && !c->quarantined &&
+        owner && owner == c->owner;
+}
+static struct sgpu_graphics_bo *CLIENT_FN sgpu_graphics_lookup(struct sgpu_graphics *c, uint32_t handle)
+{
+    if (!handle) return NULL;
+    for (unsigned i=0;i<SGPU_GRAPHICS_BOS;i++)
+        if (c->bo[i].live && c->bo[i].handle==handle) return &c->bo[i];
+    return NULL;
+}
+static bool CLIENT_FN sgpu_graphics_fail(struct sgpu_graphics *c, uint32_t error)
+{
+    if (!c->error) c->error=error;
+    c->quarantined=true;
+    for (unsigned i=0;i<SGPU_GRAPHICS_BOS;i++)
+        if (c->bo[i].live && c->bo[i].exposed) c->bo[i].quarantine=true;
+    return false;
+}
+bool CLIENT_FN sgpu_graphics_init(struct sgpu_graphics *c, uint64_t owner,
+    const struct sgpu_graphics_ops *ops)
+{
+    if (!c || !owner || !ops || !ops->ready || !ops->allocate || !ops->release ||
+        !ops->page_pa || !ops->reserved_pa || !ops->map || !ops->unmap || !ops->pte ||
+        !ops->clean || !ops->invalidate || !ops->prepare_ibs || !ops->validate_ib || !ops->publish ||
+        !ops->invalidate_fence || !ops->fence || !ops->faulted || !ops->idle ||
+        !ops->now_us || !ops->wait_us || !ops->ready(ops->ctx)) return false;
+    /* Caller supplies fresh, zeroed state. Reinitialization could lose leases. */
+    if (c->initialized || c->retained_pages || c->owner ||
+        (ops->fence_pa&(SGPU_PAGE-1)) || ops->fence_pa<SGPU_DMA_MIN ||
+        ops->fence_pa>SGPU_DMA_END-SGPU_PAGE || !ops->reserved_pa(ops->ctx,ops->fence_pa) ||
+        !ops->idle(ops->ctx) || ops->faulted(ops->ctx) ||
+        ops->pte(ops->ctx,SGPU_RENDER_VA)!=(ops->fence_pa|CLIENT_PTE_RW)) return false;
+    for (uint32_t i=1;i<SGPU_RENDER_MAX_PAGES;i++)
+        if (ops->pte(ops->ctx,SGPU_RENDER_VA+i*SGPU_PAGE)) return false;
+    ops->invalidate_fence(ops->ctx);
+    if (ops->fence(ops->ctx)) return false;
+    memset(c,0,sizeof(*c));c->ops=*ops;c->owner=owner;
+    c->next_handle=1;c->va_used[0]=2;c->initialized=true;
+    return true;
+}
+static uint32_t CLIENT_FN sgpu_graphics_run(const uint8_t *used, uint32_t count,
+    uint32_t start, uint32_t pages)
+{
+    if (!pages || pages>count-start) return count;
+    for (uint32_t i=start;i<=count-pages;i++) {
+        uint32_t j=0;
+        for (;j<pages;j++) if (used[i+j]) break;
+        if (j==pages) return i;
+        i+=j;
+    }
+    return count;
+}
+static bool CLIENT_FN sgpu_graphics_memory_valid(const struct sgpu_graphics *c,
+    const struct sgpu_graphics_memory *m, uint32_t pages)
+{
+    if (!m->va || ((uintptr_t)m->va&(SGPU_PAGE-1)) || !m->pa ||
+        ((uintptr_t)m->pa&7) || !m->cookie ||
+        m->pages!=pages || pages>SGPU_GRAPHICS_PAGES) return false;
+    uintptr_t va=(uintptr_t)m->va,pa=(uintptr_t)m->pa;
+    uintptr_t length=(uintptr_t)pages*SGPU_PAGE,pa_length=(uintptr_t)pages*8;
+    if (va>UINTPTR_MAX-length || pa>UINTPTR_MAX-pa_length ||
+        (va<pa+pa_length && pa<va+length)) return false;
+    for (unsigned i=0;i<SGPU_GRAPHICS_BOS;i++) if (c->bo[i].live) {
+        uintptr_t old=(uintptr_t)c->bo[i].memory.va,bytes=(uintptr_t)c->bo[i].pages*SGPU_PAGE;
+        if (va<old+bytes && old<va+length) return false;
+    }
+    for (uint32_t i=0;i<pages;i++) {
+        uint64_t pa=m->pa[i];
+        if ((pa&(SGPU_PAGE-1)) || pa<SGPU_DMA_MIN || pa>SGPU_DMA_END-SGPU_PAGE ||
+            c->ops.page_pa(c->ops.ctx,m,i)!=pa || c->ops.reserved_pa(c->ops.ctx,pa)) return false;
+        for (uint32_t j=0;j<i;j++) if (m->pa[j]==pa) return false;
+        for (uint32_t j=0;j<SGPU_GRAPHICS_PAGES;j++)
+            if (c->physical_used[j] && c->pa[j]==pa) return false;
+    }
+    return true;
+}
+static uint32_t CLIENT_FN sgpu_graphics_allocate(struct sgpu_graphics *c,
+    uint32_t bytes, uint32_t flags, bool private_ib)
+{
+    if (!bytes || bytes>SGPU_RENDER_BO_BYTES || (flags!=SGPU_GRAPHICS_RO && flags!=SGPU_GRAPHICS_RW) ||
+        c->active || !c->next_handle || c->next_handle==UINT32_MAX) return 0;
+    if (!c->ops.ready(c->ops.ctx)) {sgpu_graphics_fail(c,SG_GRAPHICS_OFF);return 0;}
+    uint32_t pages=(bytes+SGPU_PAGE-1)/SGPU_PAGE;
+    unsigned slot=0;
+    while (slot<SGPU_GRAPHICS_BOS && c->bo[slot].live) slot++;
+    uint32_t first=sgpu_graphics_run(c->va_used,SGPU_RENDER_MAX_PAGES,1,pages+1);
+    uint32_t physical=sgpu_graphics_run(c->physical_used,SGPU_GRAPHICS_PAGES,0,pages);
+    if (slot==SGPU_GRAPHICS_BOS || first==SGPU_RENDER_MAX_PAGES || physical==SGPU_GRAPHICS_PAGES) return 0;
+    struct sgpu_graphics_memory m={0};
+    if (!c->ops.allocate(c->ops.ctx,pages*SGPU_PAGE,private_ib,&m)) return 0;
+    if (!sgpu_graphics_memory_valid(c,&m,pages)) {c->ops.release(c->ops.ctx,&m);return 0;}
+    uint32_t handle=c->next_handle++;
+    struct sgpu_graphics_bo *b=&c->bo[slot];
+    *b=(struct sgpu_graphics_bo){.memory=m,.handle=handle,.bytes=bytes,.first=first,
+        .pages=pages,.physical=physical,.flags=flags,.live=true,.private_ib=private_ib};
+    for (uint32_t i=0;i<pages;i++) {
+        c->pa[physical+i]=m.pa[i];c->physical_used[physical+i]=1;c->va_used[first+i]=1;
+    }
+    c->va_used[first+pages]=2;c->retained_pages+=pages;
+    memset(m.va,0,pages*SGPU_PAGE);
+    c->ops.clean(c->ops.ctx,m.va,pages*SGPU_PAGE);
+    if (!c->ops.ready(c->ops.ctx)) {sgpu_graphics_fail(c,SG_GRAPHICS_OFF);return 0;}
+    uint32_t va=SGPU_RENDER_VA+first*SGPU_PAGE,guard=va+pages*SGPU_PAGE;
+    /* Preserve owned backing before the first potentially live map callback. */
+    b->exposed=true;
+    uint64_t attr=flags==SGPU_GRAPHICS_RO?CLIENT_PTE_RO:CLIENT_PTE_RW;
+    if (!c->ops.map(c->ops.ctx,va,&c->pa[physical],pages,attr,guard)) {
+        sgpu_graphics_fail(c,SG_GRAPHICS_MAP);return 0;
+    }
+    for (uint32_t i=0;i<pages;i++) if (c->ops.pte(c->ops.ctx,va+i*SGPU_PAGE)!=(c->pa[physical+i]|attr)) {
+        sgpu_graphics_fail(c,SG_GRAPHICS_MAP);return 0;
+    }
+    if (c->ops.pte(c->ops.ctx,guard)) {sgpu_graphics_fail(c,SG_GRAPHICS_MAP);return 0;}
+    return handle;
+}
+uint32_t CLIENT_FN sgpu_graphics_new(struct sgpu_graphics *c, uint64_t owner, uint32_t bytes, uint32_t flags)
+{
+    return sgpu_graphics_admitted(c,owner)?sgpu_graphics_allocate(c,bytes,flags,false):0;
+}
+bool CLIENT_FN sgpu_graphics_info(const struct sgpu_graphics *c, uint64_t owner,
+    uint32_t handle, struct sgpu_graphics_range *out)
+{
+    if (!out || !sgpu_graphics_admitted(c,owner)) return false;
+    for (unsigned i=0;i<SGPU_GRAPHICS_BOS;i++) {
+        const struct sgpu_graphics_bo *b=&c->bo[i];
+        if (b->live && !b->private_ib && b->handle==handle) {
+            *out=(struct sgpu_graphics_range){handle,SGPU_RENDER_VA+b->first*SGPU_PAGE,b->bytes,b->flags};
+            return true;
+        }
+    }
+    return false;
+}
+static bool CLIENT_FN sgpu_graphics_bo_valid(struct sgpu_graphics *c, struct sgpu_graphics_bo *b)
+{
+    uint64_t attr=b->flags==SGPU_GRAPHICS_RO?CLIENT_PTE_RO:CLIENT_PTE_RW;
+    uint32_t va=SGPU_RENDER_VA+b->first*SGPU_PAGE;
+    for (uint32_t i=0;i<b->pages;i++)
+        if (c->ops.page_pa(c->ops.ctx,&b->memory,i)!=c->pa[b->physical+i] ||
+            c->ops.pte(c->ops.ctx,va+i*SGPU_PAGE)!=(c->pa[b->physical+i]|attr))
+            return sgpu_graphics_fail(c,SG_GRAPHICS_PAGES_CHANGED);
+    if (c->ops.pte(c->ops.ctx,va+b->pages*SGPU_PAGE)) return sgpu_graphics_fail(c,SG_GRAPHICS_MAP);
+    return true;
+}
+bool CLIENT_FN sgpu_graphics_cpu(struct sgpu_graphics *c, uint64_t owner, uint32_t handle,
+    uint32_t offset, uint32_t bytes, uint8_t **out)
+{
+    if (!out || !bytes || !sgpu_graphics_admitted(c,owner) || c->active) return false;
+    if (!c->ops.ready(c->ops.ctx)) return sgpu_graphics_fail(c,SG_GRAPHICS_OFF);
+    struct sgpu_graphics_bo *b=sgpu_graphics_lookup(c,handle);
+    if (!b || b->private_ib || offset>b->bytes || bytes>b->bytes-offset || !sgpu_graphics_bo_valid(c,b)) return false;
+    c->ops.invalidate(c->ops.ctx,b->memory.va+offset,bytes);*out=b->memory.va+offset;
+    return true;
+}
+static bool CLIENT_FN sgpu_graphics_retire(struct sgpu_graphics *c, struct sgpu_graphics_bo *b)
+{
+    if (c->active || b->quarantine) return false;
+    if (!c->ops.ready(c->ops.ctx)) return sgpu_graphics_fail(c,SG_GRAPHICS_OFF);
+    uint32_t va=SGPU_RENDER_VA+b->first*SGPU_PAGE;
+    if (!c->ops.unmap(c->ops.ctx,va,b->pages,va+b->pages*SGPU_PAGE)) return sgpu_graphics_fail(c,SG_GRAPHICS_UNMAP);
+    for (uint32_t i=0;i<=b->pages;i++)
+        if (c->ops.pte(c->ops.ctx,va+i*SGPU_PAGE)) return sgpu_graphics_fail(c,SG_GRAPHICS_UNMAP);
+    for (uint32_t i=0;i<b->pages;i++) {
+        c->physical_used[b->physical+i]=0;c->pa[b->physical+i]=0;c->va_used[b->first+i]=0;
+    }
+    c->va_used[b->first+b->pages]=0;c->retained_pages-=b->pages;
+    c->ops.release(c->ops.ctx,&b->memory);memset(b,0,sizeof(*b));return true;
+}
+bool CLIENT_FN sgpu_graphics_free(struct sgpu_graphics *c, uint64_t owner, uint32_t handle)
+{
+    if (!sgpu_graphics_admitted(c,owner) || c->active) return false;
+    struct sgpu_graphics_bo *b=sgpu_graphics_lookup(c,handle);
+    return b && !b->private_ib && sgpu_graphics_retire(c,b);
+}
+static bool CLIENT_FN sgpu_graphics_drop_snapshots(struct sgpu_graphics *c)
+{
+    for (uint32_t i=0;i<c->snapshot_count;i++) {
+        struct sgpu_graphics_bo *b=sgpu_graphics_lookup(c,c->snapshots[i]);
+        if (!b || !sgpu_graphics_retire(c,b)) return false;
+    }
+    c->snapshot_count=0;return true;
+}
+uint32_t CLIENT_FN sgpu_graphics_submit(struct sgpu_graphics *c, uint64_t owner,
+    const struct sgpu_graphics_ib *ibs, uint32_t ni, const uint32_t *handles, uint32_t nb)
+{
+    if (!sgpu_graphics_admitted(c,owner) || c->active || !ibs || !handles || !ni ||
+        ni>SGPU_GRAPHICS_IBS || !nb || nb>SGPU_GRAPHICS_BOS-SGPU_GRAPHICS_IBS || c->submitted==UINT32_MAX) return 0;
+    if (!c->ops.ready(c->ops.ctx)) {sgpu_graphics_fail(c,SG_GRAPHICS_OFF);return 0;}
+    struct sgpu_graphics_ib input[SGPU_GRAPHICS_IBS];uint32_t ids[SGPU_GRAPHICS_BOS];
+    struct sgpu_graphics_range ranges[SGPU_GRAPHICS_BOS];
+    struct sgpu_graphics_command commands[SGPU_GRAPHICS_IBS];
+    struct sgpu_graphics_snapshot snapshots[SGPU_GRAPHICS_IBS];
+    uint32_t snapshot_sources[SGPU_GRAPHICS_IBS],command_snapshot[SGPU_GRAPHICS_IBS];
+    memcpy(input,ibs,ni*sizeof(input[0]));memcpy(ids,handles,nb*sizeof(ids[0]));
+    for (uint32_t i=0;i<nb;i++) {
+        if (!sgpu_graphics_info(c,owner,ids[i],&ranges[i])) return 0;
+        for (uint32_t j=0;j<i;j++) if (ids[i]==ids[j]) return 0;
+        if (!sgpu_graphics_bo_valid(c,sgpu_graphics_lookup(c,ids[i]))) return 0;
+    }
+    for (uint32_t i=0;i<ni;i++) {
+        struct sgpu_graphics_bo *b=sgpu_graphics_lookup(c,input[i].handle);
+        bool listed=false;for (uint32_t j=0;j<nb;j++) if (ids[j]==input[i].handle) listed=true;
+        if (!listed || !b || b->private_ib || b->bytes>SGPU_GRAPHICS_IB_BYTES ||
+            !input[i].bytes || input[i].bytes>SGPU_GRAPHICS_IB_BYTES ||
+            ((input[i].offset|input[i].bytes)&3) || input[i].offset>b->bytes || input[i].bytes>b->bytes-input[i].offset) return 0;
+    }
+    c->snapshot_count=0;
+    for (uint32_t i=0;i<ni;i++) {
+        struct sgpu_graphics_bo *source=sgpu_graphics_lookup(c,input[i].handle);
+        uint32_t index=0;
+        for (;index<c->snapshot_count;index++) if (snapshot_sources[index]==input[i].handle) break;
+        if (index==c->snapshot_count) {
+            uint32_t handle=sgpu_graphics_allocate(c,source->bytes,SGPU_GRAPHICS_RO,true);
+            if (!handle) {if (!c->quarantined) sgpu_graphics_drop_snapshots(c);return 0;}
+            c->snapshots[c->snapshot_count++]=handle;snapshot_sources[index]=input[i].handle;
+            struct sgpu_graphics_bo *snapshot=sgpu_graphics_lookup(c,handle);
+            /* Copy the entire command BO once. State groups outside a root's
+             * execute interval must also be immutable; they can be relocated
+             * within this one private copy. Root offsets/lengths stay bounded. */
+            memcpy(snapshot->memory.va,source->memory.va,source->bytes);
+            snapshots[index]=(struct sgpu_graphics_snapshot){SGPU_RENDER_VA+source->first*SGPU_PAGE,
+                SGPU_RENDER_VA+snapshot->first*SGPU_PAGE,source->bytes,(uint32_t *)(void *)snapshot->memory.va};
+        }
+        command_snapshot[i]=index;
+        commands[i]=(struct sgpu_graphics_command){snapshots[index].gpu_va+input[i].offset,input[i].bytes};
+    }
+    if (!c->ops.prepare_ibs(c->ops.ctx,snapshots,c->snapshot_count,commands,ni,ranges,nb)) {sgpu_graphics_drop_snapshots(c);return 0;}
+    for (uint32_t i=0;i<ni;i++) {
+        struct sgpu_graphics_bo *snapshot=sgpu_graphics_lookup(c,c->snapshots[command_snapshot[i]]);
+        if (!c->ops.validate_ib(c->ops.ctx,(const uint32_t *)(const void *)(snapshot->memory.va+input[i].offset),
+            input[i].bytes/4,ranges,nb)) {sgpu_graphics_drop_snapshots(c);return 0;}
+    }
+    /* Allocator/map/validator callbacks may have changed another mapping.
+     * Repeat exact original PA/PTE/guard checks immediately before publication. */
+    for (uint32_t i=0;i<nb;i++) if (!sgpu_graphics_bo_valid(c,sgpu_graphics_lookup(c,ids[i]))) return 0;
+    for (uint32_t i=0;i<c->snapshot_count;i++)
+        if (!sgpu_graphics_bo_valid(c,sgpu_graphics_lookup(c,c->snapshots[i]))) return 0;
+    uint32_t seq=c->submitted+1;c->submitted=seq;c->active=seq;
+    for (uint32_t i=0;i<nb;i++) {
+        struct sgpu_graphics_bo *b=sgpu_graphics_lookup(c,ids[i]);b->last_sequence=seq;
+        c->ops.clean(c->ops.ctx,b->memory.va,b->pages*SGPU_PAGE);
+    }
+    for (uint32_t i=0;i<c->snapshot_count;i++) {
+        struct sgpu_graphics_bo *b=sgpu_graphics_lookup(c,c->snapshots[i]);b->last_sequence=seq;
+        c->ops.clean(c->ops.ctx,b->memory.va,b->pages*SGPU_PAGE);
+    }
+    for (uint32_t i=0;i<nb;i++) if (!sgpu_graphics_bo_valid(c,sgpu_graphics_lookup(c,ids[i]))) return 0;
+    for (uint32_t i=0;i<c->snapshot_count;i++) {
+        struct sgpu_graphics_bo *b=sgpu_graphics_lookup(c,c->snapshots[i]);
+        if (!sgpu_graphics_bo_valid(c,b)) return 0;
+    }
+    for (uint32_t i=0;i<ni;i++) {
+        struct sgpu_graphics_bo *b=sgpu_graphics_lookup(c,c->snapshots[command_snapshot[i]]);
+        if (!c->ops.validate_ib(c->ops.ctx,(const uint32_t *)(const void *)(b->memory.va+input[i].offset),
+            input[i].bytes/4,ranges,nb)) {sgpu_graphics_fail(c,SG_GRAPHICS_COMMAND);return 0;}
+    }
+    if (!c->ops.ready(c->ops.ctx)) {sgpu_graphics_fail(c,SG_GRAPHICS_OFF);return 0;}
+    if (!c->ops.publish(c->ops.ctx,commands,ni,seq)) {sgpu_graphics_fail(c,SG_GRAPHICS_PUBLISH);return 0;}
+    return seq;
+}
+bool CLIENT_FN sgpu_graphics_wait(struct sgpu_graphics *c, uint64_t owner, uint32_t sequence)
+{
+    if (!sgpu_graphics_admitted(c,owner) || !sequence || sequence>c->submitted) return false;
+    if (sequence<=c->completed) return true;
+    if (sequence!=c->active) return false;
+    if (!c->ops.ready(c->ops.ctx)) return sgpu_graphics_fail(c,SG_GRAPHICS_OFF);
+    uint64_t start=c->ops.now_us(c->ops.ctx);
+    for (uint32_t i=0;i<SGPU_GRAPHICS_WAIT_READS;i++) {
+        c->ops.invalidate_fence(c->ops.ctx);
+        uint32_t fence=c->ops.fence(c->ops.ctx);
+        if (c->ops.faulted(c->ops.ctx)) return sgpu_graphics_fail(c,SG_GRAPHICS_FAULT);
+        if (fence>c->active) return sgpu_graphics_fail(c,SG_GRAPHICS_FENCE);
+        uint64_t now=c->ops.now_us(c->ops.ctx);
+        if (now<start || now-start>=SGPU_RENDER_WAIT_US) return sgpu_graphics_fail(c,SG_GRAPHICS_TIMEOUT);
+        if (fence==c->active && c->ops.idle(c->ops.ctx)) {
+            for (unsigned j=0;j<SGPU_GRAPHICS_BOS;j++) if (c->bo[j].live && c->bo[j].last_sequence==sequence) {
+                if (!sgpu_graphics_bo_valid(c,&c->bo[j])) return false;
+                if (c->bo[j].flags==SGPU_GRAPHICS_RW)
+                    c->ops.invalidate(c->ops.ctx,c->bo[j].memory.va,c->bo[j].pages*SGPU_PAGE);
+            }
+            c->completed=sequence;c->active=0;
+            return sgpu_graphics_drop_snapshots(c);
+        }
+        c->ops.wait_us(c->ops.ctx,100);
+    }
+    return sgpu_graphics_fail(c,SG_GRAPHICS_TIMEOUT);
+}
+void CLIENT_FN sgpu_graphics_abort(struct sgpu_graphics *c, uint64_t owner, uint32_t error)
+{
+    if (c && c->initialized && owner && owner==c->owner && error && error<=SG_GRAPHICS_OFF)
+        sgpu_graphics_fail(c,error);
+}
+bool CLIENT_FN sgpu_graphics_close(struct sgpu_graphics *c, uint64_t owner)
+{
+    if (!c || !c->initialized || !owner || owner!=c->owner || c->closed) return false;
+    if (c->quarantined || (c->active && !sgpu_graphics_wait(c,owner,c->active))) {c->closed=true;return false;}
+    for (unsigned i=0;i<SGPU_GRAPHICS_BOS;i++) if (c->bo[i].live)
+        if (!sgpu_graphics_retire(c,&c->bo[i])) {c->closed=true;return false;}
+    c->closed=true;return true;
+}
+#endif
diff --git a/bsd/dev/santoni_gpu_graphics.h b/bsd/dev/santoni_gpu_graphics.h
new file mode 100644
index 0000000..d4d0d48
--- /dev/null
+++ b/bsd/dev/santoni_gpu_graphics.h
@@ -0,0 +1,103 @@
+/* Owner-bound A505 rendering contracts. All platform/GPU work is in callbacks. */
+#ifndef SANTONI_GPU_GRAPHICS_H
+#define SANTONI_GPU_GRAPHICS_H
+#include "santoni_gpu_core.h"
+
+/* Engineering limits within the existing programmed Santoni eight-MiB window.
+ * These are not A530 limits or hardware throughput measurements. */
+#define SGPU_GRAPHICS_BOS 64u
+#define SGPU_GRAPHICS_IBS 8u
+#define SGPU_GRAPHICS_IB_BYTES (16u*SGPU_PAGE)
+#define SGPU_GRAPHICS_PAGES SGPU_RENDER_LIVE_PAGES
+#define SGPU_GRAPHICS_RO 1u
+#define SGPU_GRAPHICS_RW 2u
+#define SGPU_GRAPHICS_WAIT_READS 2001u
+
+struct sgpu_graphics_memory {
+    uint8_t *va;
+    const uint64_t *pa;
+    uintptr_t cookie; /* allocator-owned identity, never an input user pointer */
+    uint32_t pages;
+};
+struct sgpu_graphics_bo {
+    struct sgpu_graphics_memory memory;
+    uint32_t handle, bytes, first, pages, physical, flags, last_sequence;
+    bool live, private_ib, exposed, quarantine;
+};
+struct sgpu_graphics_ib { uint32_t handle, offset, bytes; };
+struct sgpu_graphics_range { uint32_t handle, gpu_va, bytes, flags; };
+struct sgpu_graphics_command { uint32_t gpu_va, bytes; };
+struct sgpu_graphics_snapshot {
+    uint32_t source_va,gpu_va,bytes;
+    uint32_t *words; /* private kernel alias, accessible only during preparation */
+};
+enum sgpu_graphics_error {
+    SG_GRAPHICS_OK, SG_GRAPHICS_MAP, SG_GRAPHICS_PAGES_CHANGED, SG_GRAPHICS_COMMAND,
+    SG_GRAPHICS_PUBLISH, SG_GRAPHICS_FAULT, SG_GRAPHICS_FENCE, SG_GRAPHICS_TIMEOUT,
+    SG_GRAPHICS_UNMAP, SG_GRAPHICS_OFF
+};
+struct sgpu_graphics_ops {
+    void *ctx;
+    uint64_t fence_pa; /* fresh owned page, writable GPU / read-only user view */
+    /* The adapter must enforce explicit opt-in, one owner and the same mutex
+     * as all GPU producers. A ready callback does not certify hardware. */
+    bool (*ready)(void *);
+    /* CPU alias and PA metadata stay owned/stable until release; scattered
+     * physical pages are valid. page_pa must resolve actual current mappings. */
+    /* Private allocations must never reuse storage exposed through user maps,
+     * including retired user mappings. The kind is generated by the core. */
+    bool (*allocate)(void *, uint32_t, bool, struct sgpu_graphics_memory *);
+    void (*release)(void *, struct sgpu_graphics_memory *);
+    uint64_t (*page_pa)(void *, const struct sgpu_graphics_memory *, uint32_t);
+    bool (*reserved_pa)(void *, uint64_t);
+    /* Map/unmap callbacks must stop CP, route SID0 to fault, disable CB,
+     * update checked PTEs, TLBI/TLBSYNC, and verify state before resuming.
+     * A failed callback is potentially exposed; core retains all mappings.
+     * The final argument is an unmapped guard VA, not an allocated page. */
+    bool (*map)(void *, uint32_t, const uint64_t *, uint32_t, uint64_t, uint32_t);
+    bool (*unmap)(void *, uint32_t, uint32_t, uint32_t);
+    uint64_t (*pte)(void *, uint32_t);
+    void (*clean)(void *, const void *, uint32_t);
+    void (*invalidate)(void *, const void *, uint32_t);
+    /* Called after ALL IBs have private copies, before validation/cache publish.
+     * The adapter can relocate nested command references into those copies;
+     * it must reject cycles and unlisted/unowned command targets. */
+    bool (*prepare_ibs)(void *, const struct sgpu_graphics_snapshot *, uint32_t,
+                        const struct sgpu_graphics_command *, uint32_t,
+                        const struct sgpu_graphics_range *, uint32_t);
+    /* The adapter must validate the immutable snapshot's A505 packets and
+     * every address against these owner ranges; no permissive default exists.
+     * Nested IBs, registers and unsupported packets require explicit proof.
+     * This generic contract itself does not authorize raw Mesa commands. */
+    bool (*validate_ib)(void *, const uint32_t *, uint32_t,
+                        const struct sgpu_graphics_range *, uint32_t);
+    bool (*publish)(void *, const struct sgpu_graphics_command *, uint32_t, uint32_t);
+    void (*invalidate_fence)(void *);
+    uint32_t (*fence)(void *);
+    bool (*faulted)(void *);
+    bool (*idle)(void *);
+    uint64_t (*now_us)(void *);
+    void (*wait_us)(void *, uint32_t);
+};
+struct sgpu_graphics {
+    struct sgpu_graphics_ops ops;
+    uint64_t owner;
+    struct sgpu_graphics_bo bo[SGPU_GRAPHICS_BOS];
+    uint64_t pa[SGPU_GRAPHICS_PAGES];
+    uint8_t physical_used[SGPU_GRAPHICS_PAGES], va_used[SGPU_RENDER_MAX_PAGES];
+    uint32_t next_handle, submitted, completed, active, error, retained_pages;
+    uint32_t snapshots[SGPU_GRAPHICS_IBS], snapshot_count;
+    bool initialized, closed, quarantined;
+};
+bool sgpu_graphics_init(struct sgpu_graphics *, uint64_t, const struct sgpu_graphics_ops *);
+uint32_t sgpu_graphics_new(struct sgpu_graphics *, uint64_t, uint32_t, uint32_t);
+bool sgpu_graphics_info(const struct sgpu_graphics *, uint64_t, uint32_t, struct sgpu_graphics_range *);
+bool sgpu_graphics_cpu(struct sgpu_graphics *, uint64_t, uint32_t, uint32_t, uint32_t, uint8_t **);
+bool sgpu_graphics_free(struct sgpu_graphics *, uint64_t, uint32_t);
+uint32_t sgpu_graphics_submit(struct sgpu_graphics *, uint64_t,
+    const struct sgpu_graphics_ib *, uint32_t, const uint32_t *, uint32_t);
+bool sgpu_graphics_wait(struct sgpu_graphics *, uint64_t, uint32_t);
+/* Adapter's asynchronous fault/publication failure; first error never changes. */
+void sgpu_graphics_abort(struct sgpu_graphics *, uint64_t, uint32_t);
+bool sgpu_graphics_close(struct sgpu_graphics *, uint64_t);
+#endif
