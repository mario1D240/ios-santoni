+static bool __attribute__((noinline)) sgpu_pas_cache_preflight(uint32_t mode)
+{
+    uint32_t enabled = 0, zap = 0, scm = 0;
+    if (mode != 3) return false;
+    (void)PE_parse_boot_argn("santonigpu_cache", &enabled, sizeof(enabled));
+    if (enabled != 1) return false;
+    (void)PE_parse_boot_argn("santonigpu_zap", &zap, sizeof(zap));
+    (void)PE_parse_boot_argn("santonigpu_scm", &scm, sizeof(scm));
+    if (zap != 1 || scm != 0) {
+        printf("SANTONI GPU: PAS cache preflight rejected conflicting/missing opt-in; NO SCM\n");
+        return true;
+    }
+    trace(NULL, "before PAS cache preflight; owned test spans, NO SCM", 8192, 8192, 0x100000);
+    sgpu_pas_cache_trial_run(&sgpu_cache_trial);
+    printf("SANTONI GPU: PAS CACHE RESULT pass=%u forward=%u cleanup=%u retained=%u uncertain=%u; NO SCM, NO GPU CONTINUATION\n",
+        !sgpu_cache_trial.forward_error && !sgpu_cache_trial.cleanup_error ? 1u : 0u,
+        sgpu_cache_trial.forward_error, sgpu_cache_trial.cleanup_error,
+        sgpu_cache_trial.metadata.memory.bytes + sgpu_cache_trial.image.memory.bytes,
+        sgpu_cache_trial.metadata.uncertain || sgpu_cache_trial.image.uncertain ? 1u : 0u);
+    return true;
+}
