+/* Cold-only mappings: no live PTE writes/unmap/TLB reuse in this first wave. */
+static bool __attribute__((noinline)) sgpu_g3_prepare(struct probe *p, struct sgpu_g3 *g,
+    const struct sgpu_firmware *fw)
+{
+    if (p->ops->g3 != 1 || p->ops->stock_pixels != 1 || p->ops->stock_unsecure != 1 || p->dma_exposed)
+        return false;
+    uint32_t first = 7 + (fw->pm4_bytes + SGPU_PAGE - 1) / SGPU_PAGE +
+        (fw->pfp_bytes + SGPU_PAGE - 1) / SGPU_PAGE;
+    if (first > SGPU_POOL_PAGES - 3 || !sgpu_g3_init(g,&p->memory,first)) return false;
+    uint32_t temporary=sgpu_g3_new(g,1,4,SG_G3_DATA);
+    if (!temporary || !sgpu_g3_free(g,1,temporary)) return false;
+    if (!sgpu_g3_new(g,1,128,SG_G3_IB) || !sgpu_g3_new(g,1,16,SG_G3_DATA) ||
+        !sgpu_g3_new(g,1,64,SG_G3_FENCE) || sgpu_g3_lookup(g,1,temporary)) return false;
+    g->sealed=true; /* no further allocation/free even if startup later fails */
+    return true;
+}
+
+static uint32_t __attribute__((noinline)) sgpu_g3_wait(struct probe *p, uint8_t *fence, uint32_t seq)
+{
+    uint64_t start=p->ops->now_us(p->ops->ctx);
+    for (unsigned i=0;i<=POLL_US/100;i++) {
+        p->ops->invalidate(p->ops->ctx,fence,64);
+        uint32_t got=*(volatile uint32_t *)(void *)fence;
+        if (got==seq) return got;
+        if (p->ops->now_us(p->ops->ctx)-start>=POLL_US) break;
+        if (i!=POLL_US/100) wait_us(p,100);
+    }
+    if (!p->report->error) p->report->error=SG_COMMAND_TIMEOUT;
+    return 0;
+}
