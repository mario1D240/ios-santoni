 {
+    p->gpu_resumed = false;
     /* A50x regulator path: halt SP input before changing HWCG, then release it. */
     if (!checked_write32(p, SG_GPU, SG_CLOCK_CNTL, ~0u, 0x55)) return false;
     /* A50x (ONE SP) HWCG values, not the A530 multi-SP table. */
     static const uint32_t hwcg[][2] = {
