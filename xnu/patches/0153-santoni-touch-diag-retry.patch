+/* One-line bring-up status for the boot console: rpm votes, PMIC read-back. */
+static struct {
+	int l10, l5;                  /* 0 not voted, 1 ok, -1 failed */
+	uint8_t l5_en, l10_en;        /* PMIC enable reg, 0xff = read failed */
+} santoni_diag;
+
 static void
 santoni_pmic_report(void)
 {
@@ -3192,9 +3198,15 @@
