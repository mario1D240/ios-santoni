+/* CPU-only queue contracts. Adapter serializes every call with one mutex.
+ * Only take/commit/finish are called by the hardware-owning worker. */
+static bool session_terminal(const struct sgpu_session_queue *q)
+{ return q->status.state == SG_SESSION_CLOSED || q->status.state == SG_SESSION_FAULTED; }
+
+bool sgpu_session_queue_init(struct sgpu_session_queue *q)
+{
+    if (!q || q->initialized) return false;
+    *q = (struct sgpu_session_queue){.initialized=true,
+        .status={.state=SG_SESSION_READY,.last_sequence=2,.wptr=170}};
+    return true;
+}
+
+uint32_t sgpu_session_enqueue(struct sgpu_session_queue *q, uint32_t owner,
+    uint32_t kind, const uint32_t value[4], uint32_t *id)
+{
+    if (!q || !value || !id || owner != SGPU_SESSION_OWNER || kind != SGPU_SESSION_WRITE4)
+        return SG_SESSION_BAD_REQUEST;
+    if (!q->initialized) return SG_SESSION_NOT_READY;
+    if (session_terminal(q) || q->close_requested) return SG_SESSION_IS_CLOSED;
+    if (q->status.admitted >= SGPU_SESSION_LIMIT) return SG_SESSION_AT_QUOTA;
+    if (q->status.outstanding >= SGPU_SESSION_DEPTH) return SG_SESSION_FULL;
+    uint32_t slot=q->status.admitted;
+    struct sgpu_session_entry next={.result={.state=SG_REQUEST_QUEUED}};
+    for (unsigned i=0;i<4;i++) next.value[i]=value[i];
+    q->entry[slot]=next;
+    q->status.admitted++; q->status.outstanding++;
+    *id=slot+1;
+    return SG_SESSION_OK;
+}
+
+static void session_cancel_queued(struct sgpu_session_queue *q)
+{
+    for (unsigned i=0;i<q->status.admitted;i++) {
+        if (q->entry[i].result.state == SG_REQUEST_QUEUED) {
+            q->entry[i].result.state=SG_REQUEST_CANCELLED;
+            q->status.cancelled++; q->status.outstanding--;
+        }
+    }
+}
+
+static void session_queue_settle(struct sgpu_session_queue *q)
+{
+    if (q->close_requested) session_cancel_queued(q);
+    if (q->status.active || q->status.outstanding || session_terminal(q)) return;
+    if (q->close_requested || q->status.admitted == SGPU_SESSION_LIMIT) {
+        q->status.state=SG_SESSION_CLOSED;
+        q->status.reason=q->close_requested ? SG_SESSION_CLOSE : SG_SESSION_QUOTA;
+    } else q->status.state=SG_SESSION_READY;
+}
+
+bool sgpu_session_take(struct sgpu_session_queue *q, struct sgpu_session_request *out)
+{
+    if (!q || !out || !q->initialized || q->status.active || session_terminal(q)) return false;
+    session_queue_settle(q);
+    if (session_terminal(q)) return false;
+    for (unsigned i=0;i<q->status.admitted;i++) {
+        if (q->entry[i].result.state != SG_REQUEST_QUEUED) continue;
+        q->entry[i].result.state=SG_REQUEST_ACTIVE;
+        q->status.active=i+1; q->status.state=SG_SESSION_ACTIVE;
+        *out=(struct sgpu_session_request){.id=i+1};
+        for (unsigned j=0;j<4;j++) out->value[j]=q->entry[i].value[j];
+        return true;
+    }
+    return false;
+}
+
+bool sgpu_session_commit(struct sgpu_session_queue *q, uint32_t id)
+{
+    if (!q || !id || id>q->status.admitted || q->status.active!=id || session_terminal(q) ||
+        q->entry[id-1].result.state!=SG_REQUEST_ACTIVE) return false;
+    if (q->close_requested) {
+        q->entry[id-1].result.state=SG_REQUEST_CANCELLED;
+        q->status.active=0; q->status.cancelled++; q->status.outstanding--;
+        session_queue_settle(q);
+        return false;
+    }
+    q->entry[id-1].result.state=SG_REQUEST_COMMITTED;
+    q->status.committed++;
+    return true;
+}
+
+bool sgpu_session_finish(struct sgpu_session_queue *q, uint32_t id,
+    const struct sgpu_session_result *result)
+{
+    if (!q || !result || !id || id>q->status.admitted || q->status.active!=id || session_terminal(q))
+        return false;
+    uint32_t prior=q->entry[id-1].result.state;
+    if (prior!=SG_REQUEST_COMMITTED && !(prior==SG_REQUEST_ACTIVE && result->error && !result->publish_attempted))
+        return false;
+    /* A completed record needs actual publication and exactly four compared words. */
+    if (!result->error && (!result->publish_attempted || result->writes!=4 ||
+        result->sequence!=q->status.last_sequence+1 || result->wptr!=q->status.wptr+SG_G3_BATCH_WORDS))
+        return false;
+    q->entry[id-1].result=*result;
+    q->status.active=0; q->status.outstanding--;
+    if (result->publish_attempted) q->status.submitted++;
+    if (result->error) {
+        q->entry[id-1].result.state=SG_REQUEST_FAILED;
+        q->status.failed++;
+        if (!q->status.error) {
+            q->status.error=result->error; q->status.first_failed_id=id;
+            q->status.failure=result->failure;
+        }
+        q->status.state=SG_SESSION_FAULTED; q->status.reason=SG_SESSION_FAILURE;
+        session_cancel_queued(q);
+    } else {
+        q->entry[id-1].result.state=SG_REQUEST_COMPLETE;
+        q->status.completed++; q->status.writes+=result->writes;
+        q->status.last_sequence=result->sequence; q->status.wptr=result->wptr;
+        q->status.state=SG_SESSION_READY;
+        session_queue_settle(q);
+    }
+    return true;
+}
