+enum sgpu_session_rc { SG_SESSION_OK, SG_SESSION_NOT_READY, SG_SESSION_BAD_REQUEST,
+    SG_SESSION_FULL, SG_SESSION_AT_QUOTA, SG_SESSION_IS_CLOSED };
+enum sgpu_session_phase { SG_SESSION_BOOT, SG_SESSION_READINESS, SG_SESSION_CONTENTS,
