+}
+static bool __attribute__((noinline)) sgpu_graphics_hw_resume(void)
+{
+    struct probe *p=&session_core.p;uint32_t wptr=sgpu_graphics_hw.wptr;
+    if (!sgpu_graphics_hw_tables() || !checked_write32(p,SG_SMMU,SG_CB_TLBIASID,0,1) ||
+        !checked_write32(p,SG_SMMU,SG_CB_TLBSYNC,0,0) ||
+        !poll(p,SG_SMMU,SG_CB_TLBSTATUS,1,0,10000))return sgpu_graphics_hw_fail(SG_TLB_TIMEOUT);
+    if (!sgpu_graphics_hw_state(wptr,3,0x1126,SG_S2CR_FAULT) || !sgpu_graphics_hw_tables() ||
+        !checked_write32(p,SG_SMMU,SG_CB,~0u,0x1127) ||
+        !sgpu_graphics_hw_state(wptr,3,0x1127,SG_S2CR_FAULT) ||
+        !checked_write32(p,SG_SMMU,SG_S2CR0,~0u,0) ||
+        !sgpu_graphics_hw_state(wptr,3,0x1127,0) ||
+        !checked_write32(p,SG_GPU,SG_ME_CNTL,SG_CP_LIVE_READBACK_MASK,0) ||
+        !sgpu_graphics_hw_state(wptr,0,0x1127,0) || !sgpu_graphics_hw_tables())return sgpu_graphics_hw_fail(SG_BAD_SMMU);
+    return true;
+}
+bool __attribute__((noinline)) sgpu_graphics_hw_begin(uint32_t mode,uint32_t enabled)
+{
+    struct probe *p=&session_core.p;struct sgpu_render_memory *m=&sgpu_render_live.arena.memory;
+    if (mode!=3 || enabled!=1 || sgpu_graphics_hw.initialized || sgpu_graphics_hw.failed ||
+        sgpu_ui.ready || sgpu_ui.failed || sgpu_ui.imported || !sgpu_render_live.result.passed ||
+        !sgpu_render_live.linked || sgpu_render_live.result.phase!=SG_LIVE_DONE ||
+        sgpu_render_live.arena.busy || sgpu_render_live.arena.error || !p->report ||
