-		if (cpu >= 0 && (unsigned int)cpu < SWEET_SMP_MAX_CPUS) {
-			kprintf("SWEET GIC: cpu=%d mpidr=0x%llx gic_iface=%u\n", cpu,
-			    mpidr & 0xffffffULL, sweet_gic_cpu_iface((unsigned int)cpu));
+		if (cpu < 0 || (unsigned int)cpu >= SWEET_SMP_MAX_CPUS) {
+			panic("SWEET GIC: unknown logical CPU for MPIDR 0x%llx", mpidr);
+		}
+		if (sweet_vtimer_intid < 16 || sweet_vtimer_intid >= 32) {
+			panic("SWEET GIC: virtual timer INTID %u is not a PPI", sweet_vtimer_intid);
+		}
+		uint32_t target = sweet_gic_local_target(gicd);
+		/* startAll starts CPUs serially; reject duplicate banked target reports. */
+		for (unsigned int other = 0; other < SWEET_SMP_MAX_CPUS; other++) {
+			if (other != (unsigned int)cpu &&
+			    __atomic_load_n(&sweet_cpu_targets[other], __ATOMIC_ACQUIRE) == target) {
+				panic("SWEET GIC: CPUs %u and %d share target 0x%x", other, cpu, target);
+			}
+		}
+		*(volatile uint32_t *)(gicc_base + 0x000) = 0;
+		*(volatile uint32_t *)(gicd + 0x180) = 0xffffffffU; /* ICENABLER0 */
+		*(volatile uint32_t *)(gicd + 0x380) = 0xffffffffU; /* ICACTIVER0 */
+		/* Secure-owned group bits may be RAZ/WI from NS; do not infer ownership
+		 * from readback. Request Group 1 wherever firmware permits writes. */
+		*(volatile uint32_t *)(gicd + 0x080) = 0xffffffffU;
+		for (unsigned int offset = 0; offset < 32; offset += 4) {
+			*(volatile uint32_t *)(gicd + 0x400 + offset) = 0xa0a0a0a0U;
 		}
 		*(volatile uint32_t *)(gicc_base + 0x004) = 0xff; /* PMR: accept 0xa0 */
 		*(volatile uint32_t *)(gicc_base + 0x008) = 0x00; /* BPR */
-		/* set-enable only: PPI virt timer + SGI1 (no other CPU's bits are cleared) */
-		*(volatile uint32_t *)(gicd_base + 0x100 + (sweet_vtimer_intid / 32) * 4) =
-		    (1U << (sweet_vtimer_intid % 32)) | (1U << (SWEET_IPI_SGI % 32));
+		*(volatile uint32_t *)(gicd + 0x100) =
+		    (1U << sweet_vtimer_intid) | (1U << SWEET_IPI_SGI);
+		__builtin_arm_dsb(DSB_SY);
 		*(volatile uint32_t *)(gicc_base + 0x000) = 0x01; /* CTLR: enable */
+		__builtin_arm_dsb(DSB_SY);
 		__builtin_arm_isb(ISB_SY);
+		__atomic_store_n(&sweet_cpu_targets[cpu], target, __ATOMIC_RELEASE);
+		kprintf("SWEET GIC: cpu=%d mpidr=0x%llx target=0x%02x gic_iface=%u\n", cpu,
+		    mpidr & 0xffffffULL, target, sweet_gic_cpu_iface((unsigned int)cpu));
 	}
 #endif /* SANTONI */
 }
