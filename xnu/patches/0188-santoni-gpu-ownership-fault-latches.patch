+    p->report->interrupt_status |= read32(p, SG_GPU, SG_INT_STATUS);
     if (!p->smmu_live) {
+        if (!p->report->error && (p->report->interrupt_status & SG_ERROR_IRQ_MASK))
+            p->report->error = SG_FAULT;
         trace(p, "GPU status/IRQ; SMMU layout not verified", p->report->status,
             p->report->interrupt_status, 0);
         return;
     }
