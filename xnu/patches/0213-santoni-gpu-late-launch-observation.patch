diff --git a/bsd/dev/santoni_gpu.c b/bsd/dev/santoni_gpu.c
index 7c66d55..73dcfcc 100644
--- a/bsd/dev/santoni_gpu.c
+++ b/bsd/dev/santoni_gpu.c
@@ -953,6 +953,15 @@ static bool __attribute__((noinline)) sgpu_user_publish(void)
     sgpu_user_published=true;
     lck_mtx_unlock(&sgpu_session_lock);
     printf("SANTONI GPU: USER ready /dev/santonigpu; root, one task, WRITE4; no user DMA maps; NO UI\n");
+    if (sg.mode==3) {
+        /* Report after publication and mutex release, beside the late USER line.
+         * The existing CPU-only getters do not prove child entry or completion:
