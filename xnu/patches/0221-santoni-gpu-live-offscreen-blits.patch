 void sgpu_render_abort(struct sgpu_render_arena *, uint32_t);

+#define SGPU_RENDER_VA (SGPU_VA_BASE + 0x200000u)
+#define SGPU_RENDER_WIDTH 720u
+#define SGPU_RENDER_HEIGHT 1280u
+#define SGPU_RENDER_STRIDE 3072u
+#define SGPU_RENDER_BYTES (SGPU_RENDER_HEIGHT * SGPU_RENDER_STRIDE)
+#define SGPU_RENDER_LIVE_PAGES (2u * SGPU_RENDER_BYTES / SGPU_PAGE)
+#define SGPU_RENDER_LIVE_STAGE 12u
+enum sgpu_render_live_phase { SG_LIVE_OFF, SG_LIVE_MEMORY, SG_LIVE_BOOT,
+    SG_LIVE_READY, SG_LIVE_TABLES, SG_LIVE_HALT, SG_LIVE_LINK, SG_LIVE_TLB,
+    SG_LIVE_ENABLE, SG_LIVE_SUBMIT, SG_LIVE_FENCE, SG_LIVE_COMPARE, SG_LIVE_DONE };
+struct sgpu_render_live_result {
+    uint32_t phase, error, submitted, completed, sequence, wptr, pixels;
+    bool requested, started, exposed, publish_attempted, passed;
+    struct sgpu_failure failure;
+};
+/* Once-only kernel diagnostic. The adapter owns the new backing; the core
+ * retains the existing bootstrap allocation and all exposed render backing.
+ * No producer, userspace mapping or display call may share this worker. */
+bool sgpu_render_live_start(const struct sgpu_ops *, uint32_t, uint32_t,
+    const uint8_t *, size_t, const struct sgpu_render_memory *,
+    struct sgpu_report *, struct sgpu_render_live_result *);
+
 /* Register offsets are BYTES, from MSM4.9 a5xx_reg.h (which uses WORDS). */
 #define SG_RB_BASE 0x2000u
 #define SG_RB_BASE_HI 0x2004u
