diff --git a/bsd/dev/santoni_gpu_launch.h b/bsd/dev/santoni_gpu_launch.h
index 5b339ee..7c8733d 100644
--- a/bsd/dev/santoni_gpu_launch.h
+++ b/bsd/dev/santoni_gpu_launch.h
@@ -15,4 +15,24 @@ void santoni_gpu_user_launch_exec_result(int);
 bool santoni_gpu_user_launch_mount_args(const void *, struct sgpu_launch_mount *);
 bool santoni_gpu_user_launch_mount_published(void);
 bool santoni_gpu_user_launch_trace_ready(uint64_t, uint32_t, uint32_t);
+
+/* Read-only CPU observation of the private-vnode trace path. Every scalar is a
+ * saturating per-boot count or an explicit seen flag; none is a timestamp,
+ * address or caller pointer. A dedicated mutex protects the coherent copy and
+ * first serialized refusal. Zero values describe copy time only, not later
+ * execution. Refusal stages are recorded at their first point
+ * of denial so an absent observation stays distinct from a status0 outcome. */
+struct sgpu_launch_trace_diag {
+    uint32_t open_attempts, open_accepted, open_refused;
+    uint32_t ioctl_attempts, ioctl_accepted, ioctl_refused;
+    /* First refusal stage: 0 none/attempted; 1 trace command on a vnode that is
+     * not the private trace mount (ioctl only); 2 open flag or record
+     * precondition; 3 caller-context/access; 4 fixed ABI validation;
+     * 5 event quota exhausted. open/ioctl attempts count only callers that
+     * already reached the private mount; a stage-1 ioctl still sets seen_ioctl
+     * because the trace command itself was observed. */
+    uint32_t open_refuse_stage, ioctl_refuse_stage;
+    uint32_t seen_open, seen_ioctl;
+};
+void santoni_gpu_user_launch_trace_snapshot(struct sgpu_launch_trace_diag *);
 #endif
