+/* Worker-only, under the queue mutex, after an internal commit/result rejection.
+ * Preserve completed records and any publication evidence; settle every pending
+ * record before terminal state. No GPU access, release or invented completion. */
+void sgpu_session_fault_pending(struct sgpu_session_queue *q,
+    const struct sgpu_session_result *result)
+{
+    if (!q || !q->initialized || session_terminal(q)) return;
+    struct sgpu_session_result failed=result ? *result : (struct sgpu_session_result){0};
+    failed.state=SG_REQUEST_FAILED;
+    failed.writes=0;
+    if (!failed.error) {
+        failed.error=SG_BAD_MODE;
+        failed.phase=SG_SESSION_ACCOUNTING;
+    }
+    for (unsigned i=0;i<q->status.admitted;i++) {
+        uint32_t state=q->entry[i].result.state;
+        if (state!=SG_REQUEST_ACTIVE && state!=SG_REQUEST_COMMITTED) continue;
+        q->entry[i].result=failed;
+        q->status.failed++;
+        q->status.outstanding--;
+        if (failed.publish_attempted) q->status.submitted++;
+        if (!q->status.error) {
+            q->status.error=failed.error; q->status.first_failed_id=i+1;
+            q->status.failure=failed.failure;
+        }
+    }
+    session_cancel_queued(q);
+    q->status.active=0;
+    if (!q->status.error) q->status.error=failed.error;
+    q->status.state=SG_SESSION_FAULTED;
+    q->status.reason=SG_SESSION_FAILURE;
+}
+
+bool sgpu_session_get(const struct sgpu_session_queue *q, uint32_t owner, uint32_t id,
+    struct sgpu_session_result *out)
+{
+    if (!q || !out || !q->initialized || owner!=SGPU_SESSION_OWNER || !id || id>q->status.admitted)
+        return false;
+    *out=q->entry[id-1].result;
+    return true;
+}
