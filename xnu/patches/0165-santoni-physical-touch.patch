Subject: [PATCH] santoni: honor physical touch and RPM wire contracts

Apply after 0164. Propagate every bitbang clock timeout and retain the
first failing stage. Identify firmware before choosing its report format;
read all five generic FT slots, including UP after count/INT deassertion.
Validate SMEM allocations and Linux partition layout, consume partial SMD
packets header-first, and accept only complete matching RPM FIFO replies.
Auxiliary SMEM bases must match an explicit mapped bank and stay within it.
Message-RAM dumps are diagnostic, not fresh ACKs; the unestablished GLINK
experiment is no longer called by the SMD voting path. Retry both supplies.

Host contract checks are not physical rail, touch, or kernel verification.
The working HID auto-swipe and unrelated storage/boot/display code are unchanged.

diff --git a/bsd/dev/santoni_sdhci.c b/bsd/dev/santoni_sdhci.c
--- a/bsd/dev/santoni_sdhci.c
+++ b/bsd/dev/santoni_sdhci.c
@@ -2911,16 +2911,19 @@
  * SANTONI physical buttons and touchscreen handler.
  *
  * Volume Up is TLMM GPIO 91 (active low, register 0x0105b004).
- * The touch controller is an EDT M06-class FocalTech part ("edt,edt-ft5406"
- * in the santoni device tree) on blsp1_i2c3: GPIO 10 SDA, GPIO 11 SCL,
+ * The FocalTech controller ("edt,edt-ft5406" in the device tree) is on
+ * blsp1_i2c3: GPIO 10 SDA, GPIO 11 SCL,
  * GPIO 64 reset (active low), GPIO 65 INT (active low), address 0x38.
- * VCC is PM8937 L10 (2.85 V) and IOVCC is L5 (1.8 V).  Nothing in the
- * boot chain votes L10, so after a fastboot boot the controller sits
- * unpowered and never ACKs; santoni_rpm_ldo() asks the RPM to enable it
+ * VCC is PM8937 L10 (2.85 V) and IOVCC is L5 (1.8 V). Their boot-time
+ * electrical state is not established by an I2C NACK or GPIO input.
+ * santoni_rpm_ldo() asks the RPM to enable both supplies
  * over the rpm_requests SMD channel (mainline qcom_smd-regulator does the
  * same).  This driver still never writes a PMIC register directly.
  *
- * M06 command 0xf9 returns the whole report in one read:
+ * Firmware identification, not the DT compatible, selects the format.
+ * Generic FT reports are 33 bytes at 0x00, with five 6-byte slots (UP
+ * slots are present even when the active count is zero). M06 command
+ * 0xf9 returns the whole report in one read:
  *   aa aa 1a | 2 bytes | 5 * {event/xhi, xlo, id/yhi, ylo} | xor crc
  * Event 0 (down) carries bogus coordinates and is skipped, 1 is up and
  * 2 is contact/move (Linux edt-ft5x06.c, EDT_M06).
@@ -2946,6 +2949,12 @@
 #define FT5435_EVENT_CONTACT    2
 #define FT5435_EVENT_RESERVED   3
 
+static struct {
+	const char *stage, *error;
+	uint8_t reg;
+	size_t byte;
+} santoni_i2c_diag;
+
 #define SPMI_CORE_PHYS          0x0200f000UL
 #define SPMI_OBS_PHYS           0x02c00000UL
 #define SPMI_APID_MAX           256
@@ -3001,46 +3010,51 @@
 }
 
 /*
- * Release SCL and wait until it really reads high: the TLMM pull-up is
- * weak (~30 uA) so edges are slow, and the controller may stretch the
- * clock.  Proceed anyway after ~40 us so a stuck line cannot hang boot.
+ * Open-drain SCL: wait at most 40 us for a high input. A timeout aborts
+ * the transaction; SDA low without a clock is not an ACK. Keep the
+ * existing conservative timings; analogue rise times are unmeasured.
  */
 static bool
 santoni_i2c_scl_high(vm_offset_t tlmm)
 {
 	tlmm_gpio_in_cfg(tlmm, PIN_SCL, TLMM_PULL_UP);
-	for (int i = 0; i < 40; i++) {
+	for (int i = 0; i <= 40; i++) {
 		if (tlmm_gpio_get(tlmm, PIN_SCL)) {
 			return true;
 		}
-		delay(1);
-	}
+		if (i < 40) delay(1);
+	}
+	santoni_i2c_diag.error = "SCL timeout";
 	return false;
 }
 
-static void
+static bool
 santoni_i2c_start(vm_offset_t tlmm)
 {
 	tlmm_gpio_in(tlmm, PIN_SDA);
-	santoni_i2c_scl_high(tlmm);
-	/* tBUF/tSU;STA >= 4.7 us; hold 20 us so the weak 30 uA pull-up
-	 * fully charges the bus before we pull SDA low. */
+	if (!santoni_i2c_scl_high(tlmm)) return false;
 	delay(20);
+	if (!tlmm_gpio_get(tlmm, PIN_SDA)) {
+		santoni_i2c_diag.error = "SDA stuck low";
+		return false;
+	}
 	tlmm_gpio_out_low(tlmm, PIN_SDA);
 	delay(5);
 	tlmm_gpio_out_low(tlmm, PIN_SCL);
 	delay(5);
-}
-
-static void
+	return true;
+}
+
+static bool
 santoni_i2c_stop(vm_offset_t tlmm)
 {
 	tlmm_gpio_out_low(tlmm, PIN_SDA);
 	delay(5);
-	santoni_i2c_scl_high(tlmm);
+	bool ok = santoni_i2c_scl_high(tlmm);
 	delay(5);
 	tlmm_gpio_in(tlmm, PIN_SDA);
 	delay(5);
+	return ok;
 }
 
