 			printf("SANTONI PMIC: %s read failed (SPMI)\n",
 			    rails[i].name);
 		}
+		if (i == 0) {
+			santoni_diag.l5_en = en;
+		} else {
+			santoni_diag.l10_en = en;
+		}
 	}
 }
 
