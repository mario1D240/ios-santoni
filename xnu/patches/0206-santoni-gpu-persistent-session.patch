+static bool session_poll(enum sgpu_block block, uint32_t off, uint32_t mask,
+    uint32_t expected, uint32_t budget, uint32_t phase)
+{
+    uint64_t begin,now;
+    if (budget>POLL_US || !session_time(phase,&begin)) return false;
+    for (unsigned i=0;i<=budget/100;i++) {
+        if (!session_time(phase,&now)) return false;
+        uint32_t got=read32(&session_core.p,block,off);
+        if (!session_time(phase,&now)) return false;
+        if (now-begin>budget) return session_fail(SG_COMMAND_TIMEOUT,phase);
+        if ((got&mask)==expected) return true;
+        if (now-begin>=budget || i==budget/100) {
+            sgpu_failure(&session_core.p,SG_FAIL_POLL,block,off,mask,expected,0,0,got,
+                (uint32_t)(now-begin),budget);
+            return session_fail(SG_COMMAND_TIMEOUT,phase);
+        }
+        uint64_t left=SGPU_SESSION_BUDGET_US-(now-session_core.start_us);
+        if (left>budget-(now-begin)) left=budget-(now-begin);
+        wait_us(&session_core.p,left<100 ? (uint32_t)left : 100);
+    }
+    return session_fail(SG_COMMAND_TIMEOUT,phase);
+}
