Subject: [PATCH 0167] santoni: discover GICv2 targets and initialize private IRQ state per CPU

Apply after 0165/0166. No PSCI, MPIDR, timer ID, cache policy or touch changes.
Reference: Linux irq-gic.c gic_get_cpumask/gic_dist_init/gic_cpu_init/
gic_handle_irq and irq-gic-common.c gic_cpu_config. GICv2 banked targets
are one-hot bytes, not logical CPU IDs; SGI EOI retains the source token.
The host regressions exercise these actual C/C++ routines with banked MMIO,
not a duplicate driver. Hardware performance/firmware behavior remain unverified.

--- a/pexpert/arm/pe_fiq.c
+++ b/pexpert/arm/pe_fiq.c
@@ -210,19 +210,39 @@
 
 #if defined(SANTONI)
 /*
- * GICv2 CPU-interface id per logical CPU on Qualcomm MSM8937 (santoni):
- * Cluster 1 (MPIDR 0x100..0x103) is mapped as cpu0..cpu3 -> GIC interfaces 4..7.
- * Cluster 0 (MPIDR 0x000..0x003) is mapped as cpu4..cpu7 -> GIC interfaces 0..3.
+ * GICv2 TargetList bits are CPU-interface IDs, not MPIDR or logical CPU IDs.
+ * Like Linux irq-gic.c:gic_get_cpumask(), fold all four target bytes and scan
+ * the eight banked ITARGETSR words. In particular, bits 5..7 are valid targets.
  */
+static uint32_t sweet_cpu_targets[SWEET_SMP_MAX_CPUS]; /* zero: not initialized */
+
+static uint32_t
+sweet_gic_local_target(vm_offset_t gicd)
+{
+	uint32_t mask = 0;
+	for (unsigned int offset = 0; offset < 32; offset += 4) {
+		uint32_t word = *(volatile uint32_t *)(gicd + 0x800 + offset);
+		word |= word >> 16;
+		word |= word >> 8;
+		mask = word & 0xffU;
+		if (mask != 0) {
+			break;
+		}
+	}
+	if (mask == 0 || (mask & (mask - 1)) != 0) {
+		panic("SWEET GIC: invalid banked CPU target mask 0x%x", mask);
+	}
+	return mask;
+}
+
 uint32_t
 sweet_gic_cpu_iface(unsigned int cpu)
 {
-	if (cpu < 4) {
-		return 4 + cpu;
-	} else if (cpu < SWEET_SMP_MAX_CPUS) {
-		return cpu - 4;
-	}
-	return 0xffffffffU;
+	if (cpu >= SWEET_SMP_MAX_CPUS) {
+		return 0xffffffffU;
+	}
+	uint32_t mask = __atomic_load_n(&sweet_cpu_targets[cpu], __ATOMIC_ACQUIRE);
+	return mask != 0 ? (uint32_t)__builtin_ctz(mask) : 0xffffffffU;
 }
 #endif /* SANTONI */
 
