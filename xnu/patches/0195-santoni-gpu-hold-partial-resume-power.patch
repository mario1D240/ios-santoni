+            stopped = false;
+            trace(&p, "partial A50x resume; power held until reboot", report->stage,
+                report->failure.offset, p.saved_count);
+        } else {
+            stopped = poll(&p, SG_GPU, SG_STATUS, SG_BUSY_MASK, 0, 10000);
+        }
     } else if (p.gx_touched) {
