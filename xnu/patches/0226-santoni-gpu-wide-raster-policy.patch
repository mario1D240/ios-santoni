+        !pitch || pitch>UINT32_MAX || !layer || layer>UINT32_MAX || (uint64_t)(right+1)*4>pitch || pitch*(bottom+1)>layer ||
+        !sgpu_raster_owned(c,VALUE(c,RB_MRT_0_BASE_LO),layer,true,&c->target_handle))return sgpu_raster_failure(c,RASTER_TARGET);
+    /* fd5_gmem.c:fd5_emit_sysmem_prep uses inclusive framebuffer endpoints
+     * for both window and resolve. This restricted bypass profile requires
+     * exact equality, rather than accepting an unrelated resolve rectangle. */
+    if(!HAVE(c,RB_RESOLVE_CNTL_1) || !HAVE(c,RB_RESOLVE_CNTL_2) ||
+        VALUE(c,RB_RESOLVE_CNTL_1)!=tl || VALUE(c,RB_RESOLVE_CNTL_2)!=br)return sgpu_raster_failure(c,RASTER_TARGET);
+    if(!clear) {
+        if(!HAVE(c,GRAS_SC_SCREEN_SCISSOR_TL_0) || !HAVE(c,GRAS_SC_SCREEN_SCISSOR_BR_0))return sgpu_raster_failure(c,RASTER_TARGET);
+        uint32_t stl=VALUE(c,GRAS_SC_SCREEN_SCISSOR_TL_0),sbr=VALUE(c,GRAS_SC_SCREEN_SCISSOR_BR_0);
+        if(!sgpu_raster_rectangle_inside(stl,sbr,tl,br))return sgpu_raster_failure(c,RASTER_TARGET);
+        /* fd5_emit.c writes the same scissor endpoints to both banks. The
+         * unknown WINDOW_OFFSET_DISABLE interpretation is not admitted. */
+        if(!HAVE(c,GRAS_SC_VIEWPORT_SCISSOR_TL_0) || !HAVE(c,GRAS_SC_VIEWPORT_SCISSOR_BR_0) ||
+            !sgpu_raster_rectangle_inside(VALUE(c,GRAS_SC_VIEWPORT_SCISSOR_TL_0),VALUE(c,GRAS_SC_VIEWPORT_SCISSOR_BR_0),tl,br) ||
+            VALUE(c,GRAS_SC_VIEWPORT_SCISSOR_TL_0)!=stl || VALUE(c,GRAS_SC_VIEWPORT_SCISSOR_BR_0)!=sbr)return sgpu_raster_failure(c,RASTER_TARGET);
+    }
+    c->width=right+1;c->height=bottom+1;c->pitch=(uint32_t)pitch;c->layer_bytes=(uint32_t)layer;return true;
+}
+static bool SGPU_RASTER_FN sgpu_raster_vertex(struct sgpu_raster_context *c,uint32_t vertices,uint32_t instances)
+{
+    if(instances!=1 || !vertices || vertices>65536 || !HAVE(c,VFD_CONTROL_0) || VALUE(c,VFD_CONTROL_0)!=1 ||
+        !HAVE(c,VFD_FETCH_0_BASE_LO) || !HAVE(c,VFD_FETCH_0_BASE_HI) || VALUE(c,VFD_FETCH_0_BASE_HI) ||
+        !HAVE(c,VFD_FETCH_0_SIZE) || !HAVE(c,VFD_FETCH_0_STRIDE) || !HAVE(c,VFD_INDEX_OFFSET) ||
+        !HAVE(c,VFD_DECODE_0_INSTR) || !HAVE(c,VFD_DECODE_0_STEP_RATE) || !HAVE(c,VFD_DEST_CNTL_0_INSTR))return sgpu_raster_failure(c,RASTER_VERTEX);
+    uint32_t decode=VALUE(c,VFD_DECODE_0_INSTR),dest=VALUE(c,VFD_DEST_CNTL_0_INSTR),stride=VALUE(c,VFD_FETCH_0_STRIDE);
+    if((decode&31) || (decode&(1u<<17)) || ((decode>>20)&255)!=E_VFMT5_32_32_FLOAT ||
+        (dest&15)!=15 || ((dest>>4)&255)!=0 || VALUE(c,VFD_DECODE_0_STEP_RATE)!=1 || stride<8 || stride>65536)return sgpu_raster_failure(c,RASTER_VERTEX);
+    uint64_t last=(uint64_t)VALUE(c,VFD_INDEX_OFFSET)+vertices-1,bytes=last*stride+8;
+    if(bytes>VALUE(c,VFD_FETCH_0_SIZE) || !sgpu_raster_owned(c,VALUE(c,VFD_FETCH_0_BASE_LO),VALUE(c,VFD_FETCH_0_SIZE),false,NULL))return sgpu_raster_failure(c,RASTER_VERTEX);
+    return true;
+}
+static bool SGPU_RASTER_FN sgpu_raster_constants_ready(const struct sgpu_raster_stage *s)
+{
+    /* Real quad uses only c1.x: Mesa initializes scalar4, not an invented
+     * c0 prefix. Require EVERY decoded operand/repeated scalar and keep
+     * constant_scalars separately as the HLSQ cache-footprint bound. */
+    for(unsigned i=0;i<32;i++)if(s->load.constant_reads[i]&~s->constants[i])return false;
+    return true;
+}
+static bool SGPU_RASTER_FN sgpu_raster_stage_ready(struct sgpu_raster_context *c,unsigned stage)
+{
+    struct sgpu_raster_stage *s=&c->stage[stage];
+    if(!s->object_ready || !s->load_ready || s->object_va!=s->load_va || s->object.extent!=s->load.extent ||
+        s->units!=s->load.extent/128 || !sgpu_raster_constants_ready(s))return sgpu_raster_failure(c,RASTER_SHADER);
+    if((s->load.sampler_mask&~s->sampler_mask) || (s->load.texture_mask&~s->texture_mask))return sgpu_raster_failure(c,RASTER_DESCRIPTOR);
+    for(unsigned i=0;i<16;i++)if((s->load.texture_mask>>i)&1) {
+        struct sgpu_texture_result checked;
+        if(!sgpu_sampler_subset(s->samplers[i],4) || !sgpu_texture_subset(s->textures[i],12,c->readable,c->range_count,&checked))return sgpu_raster_failure(c,RASTER_DESCRIPTOR);
+        /* Render-target feedback is not an admitted initial UI sampling mode. */
+        if(checked.handle==c->target_handle)return sgpu_raster_failure(c,RASTER_DESCRIPTOR);
+    }
+    return true;
+}
+static bool SGPU_RASTER_FN sgpu_raster_config_ready(struct sgpu_raster_context *c)
+{
+    const uint32_t required[]={R_HLSQ_VS_CONSTLEN,R_HLSQ_FS_CONSTLEN,R_HLSQ_VS_INSTRLEN,R_HLSQ_FS_INSTRLEN,
+        R_HLSQ_VS_CONFIG,R_HLSQ_FS_CONFIG,R_SP_VS_CONFIG,R_SP_FS_CONFIG,R_SP_VS_CTRL_REG0,R_SP_FS_CTRL_REG0,
+        R_HLSQ_VS_CNTL,R_HLSQ_FS_CNTL,R_SP_FS_OUTPUT_0_REG,R_RB_FS_OUTPUT_CNTL,R_RB_RENDER_COMPONENTS,
+        R_SP_VS_OUT_0_REG,R_RB_RENDER_CONTROL0,R_HLSQ_CONTROL_4_REG,R_VPC_SO_BUF_CNTL};
+    for(unsigned i=0;i<sizeof(required)/sizeof(required[0]);i++)if(!sgpu_raster_have(c,required[i]))return sgpu_raster_failure(c,RASTER_CONFIG);
+    uint32_t vc=VALUE(c,HLSQ_VS_CONSTLEN),fc=VALUE(c,HLSQ_FS_CONSTLEN);
+    if(vc>127 || fc>127-vc || VALUE(c,HLSQ_VS_INSTRLEN)!=c->stage[0].units || VALUE(c,HLSQ_FS_INSTRLEN)!=c->stage[1].units ||
+        c->stage[0].units+c->stage[1].units>64 || c->stage[0].load.constant_scalars>vc*16 || c->stage[1].load.constant_scalars>fc*16 ||
+        VALUE(c,HLSQ_VS_CONFIG)!=VALUE(c,SP_VS_CONFIG) || VALUE(c,HLSQ_FS_CONFIG)!=VALUE(c,SP_FS_CONFIG) ||
+        !F_CFG_ENABLED(VALUE(c,SP_VS_CONFIG)) || !F_CFG_ENABLED(VALUE(c,SP_FS_CONFIG)) ||
+        F_CFG_CONSTOBJECTOFFSET(VALUE(c,SP_VS_CONFIG)) || F_CFG_CONSTOBJECTOFFSET(VALUE(c,SP_FS_CONFIG))!=vc ||
+        F_CFG_SHADEROBJOFFSET(VALUE(c,SP_VS_CONFIG)) || F_CFG_SHADEROBJOFFSET(VALUE(c,SP_FS_CONFIG))!=64-c->stage[1].units ||
+        VALUE(c,HLSQ_VS_CNTL)!=c->stage[0].units*2 || VALUE(c,HLSQ_FS_CNTL)!=c->stage[1].units*2)return sgpu_raster_failure(c,RASTER_CONFIG);
+    if(F_CTRL_FULLREGFOOTPRINT(VALUE(c,SP_VS_CTRL_REG0))<c->stage[0].load.registers ||
+        F_CTRL_FULLREGFOOTPRINT(VALUE(c,SP_FS_CTRL_REG0))<c->stage[1].load.registers ||
+        F_CTRL_HALFREGFOOTPRINT(VALUE(c,SP_VS_CTRL_REG0)) || F_CTRL_HALFREGFOOTPRINT(VALUE(c,SP_FS_CTRL_REG0)) ||
+        F_CTRL_BRANCHSTACK(VALUE(c,SP_VS_CTRL_REG0)) || F_CTRL_BRANCHSTACK(VALUE(c,SP_FS_CTRL_REG0)) ||
+        F_CTRL_PIXLODENABLE(VALUE(c,SP_FS_CTRL_REG0))!=(c->stage[1].load.samples!=0) ||
+        VALUE(c,RB_FS_OUTPUT_CNTL)!=1 || VALUE(c,RB_RENDER_COMPONENTS)!=15 || VALUE(c,VPC_SO_BUF_CNTL))return sgpu_raster_failure(c,RASTER_CONFIG);
+    uint32_t output=VALUE(c,SP_FS_OUTPUT_0_REG)&255;
+    uint64_t defined[4];for(unsigned i=0;i<4;i++)defined[i]=c->stage[1].load.written[i];
+    uint32_t input_reads=(uint32_t)c->stage[1].load.input_reads[0];
+    struct sgpu_ir3_result *fs=&c->stage[1].load;
+    bool varying=fs->bary_instructions!=0;
+    if(c->stage[1].load.input_reads[1] || c->stage[1].load.input_reads[2] || c->stage[1].load.input_reads[3] || input_reads&~3u)return sgpu_raster_failure(c,RASTER_CONFIG);
+    if(input_reads && !varying) {
+        uint32_t xy=(VALUE(c,HLSQ_CONTROL_4_REG)>>16)&255,mask=(VALUE(c,RB_RENDER_CONTROL0)>>6)&15;
+        if(xy || (mask&input_reads)!=input_reads)return sgpu_raster_failure(c,RASTER_CONFIG);
+        defined[0]|=input_reads;
+    }
+    /* Exact capture/source-derived packed link, no guessed varying mapping.
+     * Slots0,1 come from VS r1.xy, both actually written; r0.xyzw is position
+     * at location2. FS receives the I/J pair r0.xy, not FragCoord. Extra slots,
+     * input banks, sparse/uninitialized output or mixed tuples stay refused. */
+    if(varying && (fs->bary_instructions!=2 || !fs->input_released || fs->varying_reads[0]!=3 || fs->varying_reads[1] ||
+        fs->bary_inputs[0]!=3 || fs->bary_inputs[1] || fs->bary_inputs[2] || fs->bary_inputs[3] || input_reads!=3 ||
+        !sgpu_raster_all_lanes(c->stage[0].load.written,4,2)))return sgpu_raster_failure(c,RASTER_CONFIG);
+    if(F_CTRL_VARYING(VALUE(c,SP_FS_CTRL_REG0))!=varying)return sgpu_raster_failure(c,RASTER_CONFIG);
+    for(unsigned i=0;i<sizeof(raster_ui_bindings)/sizeof(raster_ui_bindings[0]);i++) {
+        const struct sgpu_raster_ui_binding *b=&raster_ui_bindings[i];
+        if(!sgpu_raster_have(c,b->index) || c->registers[b->index]!=(varying?b->quad:b->plain))return sgpu_raster_failure(c,RASTER_CONFIG);
+    }
+    if(VALUE(c,RB_RENDER_CONTROL0)!=(varying?1u:input_reads?0xc8u:0u) || !HAVE(c,GRAS_CNTL) ||
+        VALUE(c,GRAS_CNTL)!=VALUE(c,RB_RENDER_CONTROL0) ||
+        VALUE(c,HLSQ_CONTROL_4_REG)!=(varying?0xfcfcfcfcu:input_reads?0x0200fcfcu:0xfcfcfcfcu))return sgpu_raster_failure(c,RASTER_CONFIG);
+    if(!sgpu_raster_all_lanes(defined,output,4) || !sgpu_raster_all_lanes(c->stage[0].load.defined,0,4))return sgpu_raster_failure(c,RASTER_CONFIG);
+    uint32_t vc_tex=HAVE(c,TPL1_VS_TEX_COUNT)?VALUE(c,TPL1_VS_TEX_COUNT):0;
+    uint32_t fc_tex=HAVE(c,TPL1_FS_TEX_COUNT)?VALUE(c,TPL1_FS_TEX_COUNT):0;
+    if(vc_tex>16 || fc_tex>16 || (c->stage[0].load.texture_mask&~((1u<<vc_tex)-1)) ||
+        (c->stage[1].load.texture_mask&~((1u<<fc_tex)-1)))return sgpu_raster_failure(c,RASTER_DESCRIPTOR);
+    return true;
+}
+static uint32_t SGPU_RASTER_FN sgpu_raster_check_state(void *opaque,const struct sgpu_pm4_state *state)
+{
+    struct sgpu_raster_context *c=opaque;
+    unsigned stage=state->block==12 || state->block==4;
+    struct sgpu_raster_stage *s=&c->stage[stage];
+    if(state->block==0 || state->block==4) {
+        if(state->shader_object || state->destination || !state->units || state->units>16 || state->type>1)return sgpu_raster_failure(c,RASTER_STATE);
+        for(unsigned i=0;i<state->units;i++) {
+            struct sgpu_texture_result checked;
+            bool valid=state->type?sgpu_texture_subset(state->words+i*12,12,c->readable,c->range_count,&checked):sgpu_sampler_subset(state->words+i*4,4);
+            if(!valid)return sgpu_raster_failure(c,RASTER_DESCRIPTOR);
+        }
+        if(state->type) {memcpy(s->textures,state->words,state->bytes);s->texture_mask=(1u<<state->units)-1;}
+        else {memcpy(s->samplers,state->words,state->bytes);s->sampler_mask=(1u<<state->units)-1;}
+        return state->bytes;
+    }
+    if(state->block!=8 && state->block!=12)return sgpu_raster_failure(c,RASTER_STATE);
+    if(state->type==1) {
+        if(state->shader_object || state->destination>512 || state->units>512-state->destination)return sgpu_raster_failure(c,RASTER_CONSTANT);
+        for(uint32_t i=0;i<state->units*4;i++) {uint32_t scalar=state->destination*4+i;s->constants[scalar/64]|=UINT64_C(1)<<(scalar%64);}
+        return state->bytes;
+    }
+    struct sgpu_ir3_limits limits={.constant_scalars=2048,.samplers=16,.textures=16,.varying_scalars=stage?128:0,.inputs={3,0,0,0}};
+    struct sgpu_ir3_result result;
+    if(state->type || !sgpu_ir3_subset(state->words,state->available_bytes,&limits,&result))return sgpu_raster_failure(c,RASTER_SHADER);
+    if(state->shader_object) {s->object=result;s->object_va=state->gpu_va;s->object_ready=true;}
+    else {s->load=result;s->load_va=state->gpu_va;s->load_ready=true;s->units=state->units;}
+    return result.extent;
+}
+static bool SGPU_RASTER_FN sgpu_raster_check_registers(void *opaque,uint32_t reg,const uint32_t *words,uint32_t count)
+{
+    struct sgpu_raster_context *c=opaque;
+    for(uint32_t i=0;i<count;i++) {
+        int found=sgpu_raster_index_for(reg+i);if(found<0)return sgpu_raster_failure(c,RASTER_REGISTER);
+        uint32_t index=(uint32_t)found,value=words[i];
+        if(index>=R_GRAS_CL_VPORT_XOFFSET_0 && index<=R_GRAS_CL_VPORT_ZSCALE_0 && !sgpu_raster_finite_viewport(value))return sgpu_raster_failure(c,RASTER_REGISTER);
+        if(index==R_GRAS_SU_POINT_MINMAX && ((value>>16)<16 || (value>>16)>65472))return sgpu_raster_failure(c,RASTER_REGISTER);
+        if(index==R_GRAS_SU_POINT_SIZE && value!=8 && value!=16)return sgpu_raster_failure(c,RASTER_REGISTER);
+        if((index==R_HLSQ_VS_CONSTLEN || index==R_HLSQ_FS_CONSTLEN) && value>127)return sgpu_raster_failure(c,RASTER_REGISTER);
+        if((index==R_HLSQ_VS_INSTRLEN || index==R_HLSQ_FS_INSTRLEN) && value>64)return sgpu_raster_failure(c,RASTER_REGISTER);
+        if((index==R_TPL1_VS_TEX_COUNT || index==R_TPL1_FS_TEX_COUNT) && value>16)return sgpu_raster_failure(c,RASTER_REGISTER);
+        if((index==R_SP_HS_CONFIG || index==R_SP_DS_CONFIG || index==R_SP_GS_CONFIG ||
+            index==R_HLSQ_HS_CONFIG || index==R_HLSQ_DS_CONFIG || index==R_HLSQ_GS_CONFIG) && F_CFG_ENABLED(value))return sgpu_raster_failure(c,RASTER_REGISTER);
+        c->registers[index]=value;c->seen[index]=true;
+    }
+    return true;
+}
+static bool SGPU_RASTER_FN sgpu_raster_check_draw(void *opaque,uint32_t op,const uint32_t *p,uint32_t n)
+{
+    struct sgpu_raster_context *c=opaque;
+    /* Mesa AUTO_INDEX triangle list/fan/strip, no indexed/indirect/tessellation
+     * or stream-output program in this restricted first raster profile. */
+    if(op!=0x38 || n!=3 || (p[0]&63)<4 || (p[0]&63)>6 || ((p[0]>>6)&3)!=2 ||
+        !sgpu_raster_target(c,false) || !sgpu_raster_vertex(c,p[2],p[1]) || !sgpu_raster_stage_ready(c,0) || !sgpu_raster_stage_ready(c,1) || !sgpu_raster_config_ready(c))return sgpu_raster_failure(c,RASTER_CONFIG);
+    c->draws++;return true;
+}
+static bool SGPU_RASTER_FN sgpu_raster_check_packet(void *opaque,uint32_t op,const uint32_t *p,uint32_t n)
+{
+    struct sgpu_raster_context *c=opaque;
+    switch(op) {
+    case 0x6c:
+        if(n!=5 || p[0]!=1 || p[1] || p[2] || p[3] || p[4])return sgpu_raster_failure(c,RASTER_CONTROL);
+        c->bypass=true;return true;
+    case 0x64:
+        if(n!=1 || p[0]!=1)return sgpu_raster_failure(c,RASTER_CONTROL);c->visibility=true;return true;
+    case 0x1d:
+        if(n!=1 || p[0])return sgpu_raster_failure(c,RASTER_CONTROL);c->skip_disabled=true;return true;
+    case 0x43:
+        if(n!=3 || p[0]!=(1u<<18) || p[1] || p[2])return sgpu_raster_failure(c,RASTER_CONTROL);c->groups_reset=true;return true;
+    case 0x46:
+        if(n==1)return (p[0]==25 || p[0]==38) && c->bypass?true:sgpu_raster_failure(c,RASTER_CONTROL);
+        if(n!=4 || !c->bypass)return sgpu_raster_failure(c,RASTER_CONTROL);
+        if(p[0]==30) {
+            if(!HAVE(c,RB_BLIT_CNTL) || VALUE(c,RB_BLIT_CNTL)!=E_BLIT_MRT0 || !HAVE(c,RB_CLEAR_CNTL) ||
+                VALUE(c,RB_CLEAR_CNTL)!=0xf2 || !sgpu_raster_target(c,true))return sgpu_raster_failure(c,RASTER_TARGET);
+            c->clears++;return true;
+        }
+        if(p[0]!=4 && p[0]!=28 && p[0]!=29)return sgpu_raster_failure(c,RASTER_CONTROL);
+        if(!c->draws && !c->clears)return sgpu_raster_failure(c,RASTER_CONTROL);
+        return true;
+    case 0x38:return n==3;
+    case 0x10:case 0x26:case 0x13:case 0x12:case 0x37:case 0x3f:case 0x30:return true;
+    default:return sgpu_raster_failure(c,RASTER_CONTROL);
+    }
+}
+void SGPU_RASTER_FN sgpu_raster_policy(struct sgpu_raster_context *c,struct sgpu_pm4_policy *policy)
+{
+    *policy=(struct sgpu_pm4_policy){.rules=raster_rules,.count=RASTER_REGISTERS,.draw=true,
+        .events_without_address=(UINT64_C(1)<<25)|(UINT64_C(1)<<38),.state_check=sgpu_raster_check_state,.state_context=c,
+        .register_check=sgpu_raster_check_registers,.draw_check=sgpu_raster_check_draw,.packet_check=sgpu_raster_check_packet};
+}
+bool SGPU_RASTER_FN sgpu_raster_init(struct sgpu_raster_context *c,const struct sgpu_graphics_range *ranges,uint32_t count)
+{
+    if(!c || !ranges || !count || count>64)return false;
+    memset(c,0,sizeof(*c));c->ranges=ranges;c->range_count=count;
+    for(uint32_t i=0;i<count;i++) {
+        if(!ranges[i].handle || !ranges[i].bytes || (ranges[i].flags!=SGPU_GRAPHICS_RO && ranges[i].flags!=SGPU_GRAPHICS_RW))return sgpu_raster_failure(c,RASTER_INPUT);
+        c->readable[i]=(struct sgpu_descriptor_range){ranges[i].handle,ranges[i].gpu_va,ranges[i].bytes};
+    }
+    return true;
+}
+#endif /* ARM64_BOARD_CONFIG_SANTONI */
diff --git a/bsd/dev/santoni_gpu_raster.h b/bsd/dev/santoni_gpu_raster.h
new file mode 100644
--- /dev/null
+++ b/bsd/dev/santoni_gpu_raster.h
@@ -0,0 +1,29 @@
+#ifndef SANTONI_RASTER_DRAFT_H
+#define SANTONI_RASTER_DRAFT_H
+#include "santoni_gpu_pm4.h"
+#include "santoni_gpu_ir3.h"
+#include "santoni_gpu_descriptors.h"
+#define RASTER_MAX_REGS 512u
+struct sgpu_raster_stage {
+    struct sgpu_ir3_result object,load;
+    uint32_t object_va,load_va,units,sampler_mask,texture_mask;
+    uint64_t constants[32];
+    uint32_t samplers[16][4],textures[16][12];
+    bool object_ready,load_ready;
+};
+enum sgpu_raster_error { RASTER_OK,RASTER_INPUT,RASTER_REGISTER,RASTER_SHADER,RASTER_STATE,
+    RASTER_TARGET,RASTER_VERTEX,RASTER_CONSTANT,RASTER_DESCRIPTOR,RASTER_CONFIG,RASTER_CONTROL };
+struct sgpu_raster_context {
+    const struct sgpu_graphics_range *ranges;uint32_t range_count;
+    struct sgpu_descriptor_range readable[64];
+    uint32_t registers[RASTER_MAX_REGS];bool seen[RASTER_MAX_REGS];
+    struct sgpu_raster_stage stage[2];
+    uint32_t draws,clears,error,target_handle,width,height,pitch,layer_bytes;
+    bool bypass,visibility,skip_disabled,groups_reset;
+};
+/* Kernel-independent, unshipped restricted profile. Same-owner public ranges
+ * must be supplied by the actual BO core; it does not establish ownership or
+ * hardware acceptance. Unknown register semantics remain source-pattern-only. */
+bool sgpu_raster_init(struct sgpu_raster_context *,const struct sgpu_graphics_range *,uint32_t);
+void sgpu_raster_policy(struct sgpu_raster_context *,struct sgpu_pm4_policy *);
+#endif
diff --git a/bsd/dev/santoni_gpu_raster_batch.c b/bsd/dev/santoni_gpu_raster_batch.c
new file mode 100644
--- /dev/null
+++ b/bsd/dev/santoni_gpu_raster_batch.c
@@ -0,0 +1,24 @@
+#include "santoni_gpu_raster_batch.h"
+#if defined(ARM64_BOARD_CONFIG_SANTONI)
+#define SGPU_RASTER_BATCH_FN __attribute__((noinline))
+static bool SGPU_RASTER_BATCH_FN sgpu_raster_batch_run(struct sgpu_raster_context *context,uint32_t profile,
+    const struct sgpu_graphics_snapshot *snapshots,uint32_t ns,
+    const struct sgpu_graphics_command *roots,uint32_t ni,
+    const struct sgpu_graphics_range *ranges,uint32_t nr,bool prepare)
+{
+    if(profile>SGPU_GRAPHICS_VM_WIDE || !sgpu_raster_init(context,ranges,nr))return false;
+    struct sgpu_pm4_policy policy;sgpu_raster_policy(context,&policy);policy.vm_profile=profile;
+    return prepare?sgpu_pm4_prepare(&policy,snapshots,ns,roots,ni,ranges,nr):
+        sgpu_pm4_validate(&policy,snapshots,ns,roots,ni,ranges,nr);
+}
+bool SGPU_RASTER_BATCH_FN sgpu_raster_prepare_batch(struct sgpu_raster_context *context,uint32_t profile,
+    const struct sgpu_graphics_snapshot *snapshots,uint32_t ns,
