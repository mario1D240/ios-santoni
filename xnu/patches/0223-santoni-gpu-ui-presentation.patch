+/* Kernel-only framebuffer caller supplies a retained wired IOSurface, not a
+ * userspace pointer. Recheck EVERY 4K PA on each call; no contiguity assumption.
+ * Surface holds are released only by the caller after a returned completed
+ * handoff, or quarantined on -1. No borrowed object is freed in this adapter. */
+int __attribute__((noinline)) santoni_gpu_ui_copy(const void *source,uint32_t bytes,
+    uint32_t width,uint32_t height,uint32_t stride,const void **out,uint32_t *out_stride)
+{
+    if (!out || !out_stride) return 0;
+    *out=NULL; *out_stride=0;
+    lck_mtx_lock(&sgpu_ui_lock);
+    if (!sgpu_ui_published || page_shift!=12 || page_size!=SGPU_PAGE || !source ||
+        ((uintptr_t)source&(SGPU_PAGE-1)) || bytes!=SGPU_RENDER_BYTES ||
+        width!=SGPU_RENDER_WIDTH || height!=SGPU_RENDER_HEIGHT || stride!=SGPU_RENDER_STRIDE ||
+        (uintptr_t)source>UINTPTR_MAX-bytes) {
+        lck_mtx_unlock(&sgpu_ui_lock);
+        return 0;
+    }
+    sgpu_ui_import=(struct sgpu_ui_image){.va=source,.pa=sgpu_ui_import_pas,
