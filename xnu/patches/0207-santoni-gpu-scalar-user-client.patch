+/* Scalar user bridge: CPU-only admission/snapshots under the adapter mutex.
+ * No user packet can choose an owner, GPU VA, register, IB or physical page. */
+bool sgpu_client_open(struct sgpu_client *client, const struct sgpu_session_queue *q,
+    uint64_t owner, bool privileged, bool enabled)
+{
+    if (!client || !q || !owner || !privileged || !enabled || !q->initialized ||
+        q->status.state!=SG_SESSION_READY || q->status.admitted || q->status.outstanding ||
+        q->status.active || client->attempted || client->closed || client->owner) return false;
+    client->owner=owner; client->attempted=true;
+    return true; /* task lifetime is retained by the adapter until reboot */
+}
+
+void sgpu_client_close(struct sgpu_client *client, struct sgpu_session_queue *q)
+{
+    if (!client || !q || !client->attempted || client->closed) return;
+    client->closed=true;
+    (void)sgpu_session_close(q,SGPU_SESSION_OWNER);
+}
+
+static bool __attribute__((noinline)) sgpu_client_packet_valid(uint32_t command,
+    const struct sgpu_user_packet *packet)
+{
+    if (!packet || packet->version!=SGPU_USER_VERSION || packet->bytes!=sizeof(*packet) ||
+        (command!=SGPU_USER_INFO && command!=SGPU_USER_SUBMIT &&
+         command!=SGPU_USER_POLL && command!=SGPU_USER_CLOSE)) return false;
+    if (command==SGPU_USER_POLL) {
+        if (!packet->id || packet->id>SGPU_SESSION_LIMIT) return false;
+    } else if (packet->id) return false;
+    const uint8_t *bytes=(const uint8_t *)(const void *)packet;
+    for (unsigned i=12;i<sizeof(*packet);i++)
+        if (!(command==SGPU_USER_SUBMIT && i>=16 && i<32) && bytes[i]) return false;
+    return true;
+}
+
+uint32_t sgpu_client_call(struct sgpu_client *client, struct sgpu_session_queue *q,
+    uint64_t owner, uint32_t command, struct sgpu_user_packet *packet, uint32_t idle)
+{
+    if (!client || !client->attempted || !owner || owner!=client->owner) return SG_CLIENT_DENIED;
+    if (!q || !q->initialized) return SG_CLIENT_INACTIVE;
+    if (!sgpu_client_packet_valid(command,packet)) return SG_CLIENT_BAD_PACKET;
+    struct sgpu_user_packet reply={.version=SGPU_USER_VERSION,.bytes=sizeof(reply),.id=packet->id};
+    if (command==SGPU_USER_SUBMIT) {
+        reply.rc=client->closed ? SG_SESSION_IS_CLOSED :
+            sgpu_session_enqueue(q,SGPU_SESSION_OWNER,SGPU_SESSION_WRITE4,packet->value,&reply.id);
+    } else if (command==SGPU_USER_CLOSE) sgpu_client_close(client,q);
+    else if (command==SGPU_USER_POLL) {
+        struct sgpu_session_result result={0};
+        if (!sgpu_session_get(q,SGPU_SESSION_OWNER,packet->id,&result)) reply.rc=SG_SESSION_NOT_READY;
+        else {
+            reply.result_state=result.state; reply.result_seq=result.sequence;
+            reply.result_wptr=result.wptr; reply.result_writes=result.writes;
+            reply.result_error=result.error; reply.result_phase=result.phase;
+            reply.publish_attempted=result.publish_attempted ? 1u : 0u;
+        }
+        /* Raw failure old/written/got values may contain kernel/physical
+         * addresses. They deliberately have no field in this public ABI. */
+    }
+    const struct sgpu_session_status *s=&q->status;
+    reply.state=s->state; reply.reason=s->reason; reply.admitted=s->admitted;
+    reply.outstanding=s->outstanding; reply.active=s->active; reply.committed=s->committed;
+    reply.submitted=s->submitted; reply.completed=s->completed; reply.cancelled=s->cancelled;
+    reply.failed=s->failed; reply.writes=s->writes; reply.last_seq=s->last_sequence;
+    reply.wptr=s->wptr; reply.error=s->error; reply.failed_id=s->first_failed_id; reply.idle=idle;
+    *packet=reply; /* zeroed, by-value reply; never a pointer into live state */
+    return SG_CLIENT_OK;
+}
 #endif
