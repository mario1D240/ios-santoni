+/* Mesa ir3-common.xml: GPR61 is a0.*, GPR62 is p0.*. Neither special
+ * bank is admitted. Remaining r63.* forms are refused as well. */
+#define IR3_SCALARS (61u*4u)
+struct execution {
+    struct sgpu_ir3_result r;
+    uint64_t pending[4],borrowed[4];
+    uint32_t alu_ready[IR3_SCALARS],sam_ready[IR3_SCALARS];
+};
+enum access {READ_ALU,READ_SAM,WRITE_ALU,WRITE_SAM};
+static bool SGPU_IR3_FN sgpu_ir3_reg(struct execution *e,uint32_t scalar,uint32_t count,enum access access)
+{
+    struct sgpu_ir3_result *r=&e->r;
+    if(!count || scalar>=IR3_SCALARS || count>IR3_SCALARS-scalar)return false;
+    for(uint32_t i=0;i<count;i++) {
+        uint32_t s=scalar+i;uint64_t bit=UINT64_C(1)<<(s%64);
+        /* ir3_legalize.c: outstanding SAM destinations need SY before reads
+         * OR writes (including a second SAM). NOPs/END without SY do not
+         * substitute for that wait. Never publish a result on failure. */
+        if(e->pending[s/64]&bit)return false;
+        if(access==WRITE_ALU || access==WRITE_SAM) {
+            /* ir3_legalize.c needs_ss_or_sy_war: SAM need not have consumed
+             * its coordinate registers yet. Only an explicit SY in this
+             * subset releases them; arbitrary intervening NOPs do not. */
+            if(e->borrowed[s/64]&bit)return false;
+            r->defined[s/64]|=bit;r->written[s/64]|=bit;
+            if(access==WRITE_SAM) {
+                e->pending[s/64]|=bit;e->alu_ready[s]=e->sam_ready[s]=0;
+            } else {
+                /* Pinned A5xx ir3_compiler.c/ir3_delay.c: 3 intervening
+                 * cycles ALU->ALU, 6 ALU->SAM. Conservatively do not use
+                 * MAD source2's late-read optimization. Repeats are actual
+                 * scalar cycles, not a single destination footprint check. */
+                e->alu_ready[s]=r->steps+4;e->sam_ready[s]=r->steps+7;
+            }
+        } else {
+            if(!(r->defined[s/64]&bit))return false;
+            if(r->steps<(access==READ_SAM?e->sam_ready[s]:e->alu_ready[s]))return false;
+            if(!(r->written[s/64]&bit))r->input_reads[s/64]|=bit;
+        }
+    }
+    uint32_t registers=(scalar+count+3)/4;
+    if(r->registers<registers)r->registers=registers;
+    return true;
+}
+static bool SGPU_IR3_FN sgpu_ir3_constant(struct sgpu_ir3_result *r,const struct sgpu_ir3_limits *l,uint32_t scalar)
+{
+    if(scalar>=l->constant_scalars)return false;
+    r->constant_reads[scalar/64]|=UINT64_C(1)<<(scalar%64);
+    if(r->constant_scalars<scalar+1)r->constant_scalars=scalar+1;
+    return true;
+}
+static bool SGPU_IR3_FN sgpu_ir3_full_type(uint32_t type) {return type==1 || type==3 || type==5;}
+static bool SGPU_IR3_FN sgpu_ir3_src2(struct execution *e,const struct sgpu_ir3_limits *l,uint32_t value,uint32_t increment)
+{
+    /* ir3-common.xml #multisrc-gpr/const. Relative, integer immediate,
+     * half and undocumented constant bit13 are refused. ABSNEG/LAST remain
+     * supported only on previously admitted direct register forms. */
+    uint32_t mode=value&0x3fffu;
+    if((mode&0x3c00u)==0 || (mode&0x3c00u)==0x400u)
+        return !(mode&0x300u) && sgpu_ir3_reg(e,(mode&255u)+increment,1,READ_ALU);
+    if((mode&0x3800u)==0x1000u)
+        return sgpu_ir3_constant(&e->r,l,(mode&0x7ffu)+increment);
+    /* Exact observed full-precision FLUT lookup1=.5. Do not strip bit10,
+     * modifiers or high lookup bits and accidentally admit a different
+     * encoding. ir3_rpt.c supports incrementing immediates ONLY for BARY/
+     * FLAT; MUL FLUT must not carry an incrementing-source flag. */
+    return value==0x2801u && !increment;
+}
+static bool SGPU_IR3_FN sgpu_ir3_src3(struct execution *e,const struct sgpu_ir3_limits *l,uint32_t value,uint32_t increment)
+{
+    /* ir3-cat3.xml: GPR may carry LAST bit10; direct constants use bit12
+     * and must have bit11 clear. Addition is on decoded scalar indices,
+     * never encoded words (which could wrap into relative/special banks). */
+    if((value&0x1b00u)==0)return sgpu_ir3_reg(e,(value&255u)+increment,1,READ_ALU);
+    return (value&0x1800u)==0x1000u && sgpu_ir3_constant(&e->r,l,(value&0x7ffu)+increment);
+}
+static bool SGPU_IR3_FN sgpu_ir3_pending(const struct execution *e)
+{return e->pending[0] || e->pending[1] || e->pending[2] || e->pending[3];}
+static void SGPU_IR3_FN sgpu_ir3_synchronize(struct execution *e)
+{
+    for(unsigned i=0;i<4;i++)e->pending[i]=e->borrowed[i]=0;
+    e->r.synchronizations++;
+}
+bool SGPU_IR3_FN sgpu_ir3_subset(const uint32_t *words,uint32_t available,const struct sgpu_ir3_limits *limits,struct sgpu_ir3_result *result)
+{
+    if(!words || ((uintptr_t)words&3) || !limits || !result || available<128 ||
+        limits->constant_scalars>2048 || limits->samplers>16 || limits->textures>16 ||
+        limits->varying_scalars>128 || (limits->inputs[3]>>52))return false;
+    struct execution e={0};struct sgpu_ir3_result *r=&e.r;
+    for(unsigned i=0;i<4;i++)r->defined[i]=limits->inputs[i];
+    /* available is an owned readable BO tail, not the shader extent. Only
+     * complete instructions are decoded; END must have zero alignment pad
+     * inside a whole128-byte unit, matching its LOAD_STATE4 request. */
+    uint32_t count=available/8;if(count>IR3_MAX_INSTRUCTIONS)count=IR3_MAX_INSTRUCTIONS;
+    for(uint32_t i=0;i<count;i++) {
+        uint64_t value=(uint64_t)words[i*2]|((uint64_t)words[i*2+1]<<32);
+        const struct ir3_rule *rule=NULL;
+        for(unsigned j=0;j<sizeof(rules)/sizeof(rules[0]);j++)if((value&rules[j].mask)==rules[j].value) {rule=&rules[j];break;}
+        if(!rule)return false;
+        r->instructions++;
+        switch(rule->kind) {
+        case IR3_NOP:r->steps+=1+IR3_NOP_REPEAT(value);break;
+        case IR3_END: {
+            if(IR3_END_SY(value))sgpu_ir3_synchronize(&e);
+            if(sgpu_ir3_pending(&e) || (r->bary_instructions && !r->input_released))return false;
+            uint32_t extent=((i+1)*8u+127u)&~127u;if(extent>available)return false;
+            for(uint32_t pad=i+1;pad<extent/8;pad++)if(words[pad*2] || words[pad*2+1])return false;
+            r->steps++;r->extent=extent;*result=*r;return true;
+        }
+        case IR3_MOV_IMMED:
+            if(!sgpu_ir3_full_type(IR3_MOV_IMMED_SRC_TYPE(value)) || !sgpu_ir3_full_type(IR3_MOV_IMMED_DST_TYPE(value)) ||
+                !sgpu_ir3_reg(&e,IR3_MOV_IMMED_DST(value),1,WRITE_ALU))return false;
+            r->steps++;break;
+        case IR3_MOV_CONST:
+            if(!sgpu_ir3_full_type(IR3_MOV_CONST_SRC_TYPE(value)) || !sgpu_ir3_full_type(IR3_MOV_CONST_DST_TYPE(value)) ||
+                !sgpu_ir3_constant(r,limits,IR3_MOV_CONST_SRC(value)) || !sgpu_ir3_reg(&e,IR3_MOV_CONST_DST(value),1,WRITE_ALU))return false;
+            r->steps++;break;
+        case IR3_MOV_GPR:
+            if(!sgpu_ir3_full_type(IR3_MOV_GPR_SRC_TYPE(value)) || !sgpu_ir3_full_type(IR3_MOV_GPR_DST_TYPE(value)) ||
+                !sgpu_ir3_reg(&e,IR3_MOV_GPR_SRC(value),1,READ_ALU) || !sgpu_ir3_reg(&e,IR3_MOV_GPR_DST(value),1,WRITE_ALU))return false;
+            r->steps++;break;
+        case IR3_MUL: {
+            uint32_t repeat=IR3_MUL_REPEAT(value),a=IR3_MUL_SRC1_R(value),b=IR3_MUL_SRC2_R(value);
+            /* With repeat0 these bits mean a nop-encoding override, not an
+             * incrementing operand. That distinct form is NOT admitted. */
+            if(!repeat && (a || b))return false;
+            if((a && IR3_MUL_SRC1(value)==0x2801u) || (b && IR3_MUL_SRC2(value)==0x2801u))return false;
+            if(IR3_MUL_SY(value))sgpu_ir3_synchronize(&e);
+            for(uint32_t n=0;n<=repeat;n++) {
+                if(!sgpu_ir3_src2(&e,limits,IR3_MUL_SRC1(value),a?n:0) || !sgpu_ir3_src2(&e,limits,IR3_MUL_SRC2(value),b?n:0) ||
+                    !sgpu_ir3_reg(&e,IR3_MUL_DST(value)+n,1,WRITE_ALU))return false;
+                r->steps++;
+            }
+            break;
+        }
+        case IR3_MAD: {
+            uint32_t repeat=IR3_MAD_REPEAT(value),a=IR3_MAD_SRC1_R(value),b=IR3_MAD_SRC2_R(value),c=IR3_MAD_SRC3_R(value);
+            if(!repeat && (a || b || c))return false;
+            if(IR3_MAD_SY(value))sgpu_ir3_synchronize(&e);
+            for(uint32_t n=0;n<=repeat;n++) {
+                if(!sgpu_ir3_src3(&e,limits,IR3_MAD_SRC1(value),a?n:0) ||
+                    !sgpu_ir3_reg(&e,IR3_MAD_SRC2(value)+(b?n:0),1,READ_ALU) ||
+                    !sgpu_ir3_src3(&e,limits,IR3_MAD_SRC3(value),c?n:0) || !sgpu_ir3_reg(&e,IR3_MAD_DST(value)+n,1,WRITE_ALU))return false;
+                r->steps++;
+            }
+            break;
+        }
+        case IR3_BARY: {
+            uint32_t inloc=IR3_BARY_SRC1(value),ij=IR3_BARY_SRC2(value);
+            /* Packed varying slot is a NONNEGATIVE integer immediate, no
+             * modifiers/half/repeat. A5xx cannot rpt BARY. The second source
+             * is the full I/J pair from ir3_compiler_nir.c, not one scalar.
+             * The concrete raster binder must prove this system input pair. */
+            if((inloc&~0x3ffu)!=0x2000u || (inloc&0x3ffu)>=limits->varying_scalars ||
+                (ij&~255u) || r->input_released || !sgpu_ir3_reg(&e,ij,2,READ_ALU) ||
+                !sgpu_ir3_reg(&e,IR3_BARY_DST(value),1,WRITE_ALU))return false;
+            uint32_t slot=inloc&0x3ffu;r->varying_reads[slot/64]|=UINT64_C(1)<<(slot%64);
+            for(unsigned lane=0;lane<2;lane++)r->bary_inputs[(ij+lane)/64]|=UINT64_C(1)<<((ij+lane)%64);
+            r->input_released=IR3_BARY_EI(value)!=0;r->bary_instructions++;r->steps++;break;
+        }
+        case IR3_SAM: {
+            if(!IR3_SAM_FULL(value) || IR3_SAM_TYPE(value)!=1 || IR3_SAM_SAMP(value)>=limits->samplers ||
+                IR3_SAM_TEX(value)>=limits->textures || !sgpu_ir3_reg(&e,IR3_SAM_SRC1(value),2,READ_SAM))return false;
+            uint32_t mask=IR3_SAM_WRMASK(value),dst=IR3_SAM_DST(value);if(!mask)return false;
+            uint32_t coord=IR3_SAM_SRC1(value);
+            for(unsigned lane=0;lane<2;lane++)e.borrowed[(coord+lane)/64]|=UINT64_C(1)<<((coord+lane)%64);
+            for(unsigned lane=0;lane<4;lane++)if((mask>>lane)&1)if(!sgpu_ir3_reg(&e,dst+lane,1,WRITE_SAM))return false;
+            r->sampler_mask|=1u<<IR3_SAM_SAMP(value);r->texture_mask|=1u<<IR3_SAM_TEX(value);
+            r->samples++;r->steps++;break;
+        }
+        }
+    }
+    return false; /* missing unconditional END within hard instruction budget */
+}
+#endif /* ARM64_BOARD_CONFIG_SANTONI */
