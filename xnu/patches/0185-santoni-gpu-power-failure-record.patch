+/* Keep the first forward failure immutable across cleanup. A second record is
+ * reserved for rollback: restored=1 alone did not locate the original failure.
+ * These are failure-only traces, not new hardware accesses or extra sleeps. */
+static void __attribute__((noinline)) sgpu_failure(struct probe *p,
+    enum sgpu_failure_kind kind, enum sgpu_block block, uint32_t off,
+    uint32_t mask, uint32_t want, uint32_t old, uint32_t written, uint32_t got,
+    uint32_t elapsed_us, uint32_t budget_us)
+{
+    struct sgpu_failure *f = p->restoring ? &p->report->rollback_failure : &p->report->failure;
+    if (f->kind != SG_FAIL_NONE) return;
+    *f = (struct sgpu_failure){.kind=kind, .stage=p->report->stage,
+        .block=block, .offset=off, .mask=mask, .want=want, .old=old,
+        .written=written, .got=got, .elapsed_us=elapsed_us,
+        .budget_us=budget_us, .saved_count=p->saved_count};
+    trace(p, p->restoring ? "ROLLBACK_FAIL stage/kind/block" : "FAIL stage/kind/block",
+        f->stage, f->kind, f->block);
+    trace(p, p->restoring ? "ROLLBACK_FAIL offset/mask/want" : "FAIL offset/mask/want",
+        f->offset, f->mask, f->want);
+    trace(p, p->restoring ? "ROLLBACK_FAIL old/written/got" : "FAIL old/written/got",
+        f->old, f->written, f->got);
+    trace(p, p->restoring ? "ROLLBACK_FAIL elapsed/budget/saved" : "FAIL elapsed/budget/saved",
+        f->elapsed_us, f->budget_us, f->saved_count);
