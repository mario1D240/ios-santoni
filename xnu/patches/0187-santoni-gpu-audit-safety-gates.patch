+static bool __attribute__((noinline)) checked_write32(struct probe *p, enum sgpu_block b, uint32_t off,
+    uint32_t mask, uint32_t value)
+{
+    uint32_t old = read32(p, b, off);
+    write32(p, b, off, value);
+    uint32_t got = read32(p, b, off);
+    if ((got & mask) == (value & mask)) return true;
+    sgpu_failure(p, SG_FAIL_READBACK, b, off, mask, value & mask, old, value, got, 0, 0);
+    return false;
+}
+
+static bool __attribute__((noinline)) checked_write64(struct probe *p, enum sgpu_block b, uint32_t off, uint64_t value)
+{
+    uint64_t old = p->ops->read64(p->ops->ctx, b, off);
+    write64(p, b, off, value);
+    uint64_t got = p->ops->read64(p->ops->ctx, b, off);
+    if (got == value) return true;
+    unsigned shift = (uint32_t)got == (uint32_t)value ? 32u : 0u;
+    sgpu_failure(p, SG_FAIL_READBACK, b, off + shift / 8, ~0u,
+        (uint32_t)(value >> shift), (uint32_t)(old >> shift),
+        (uint32_t)(value >> shift), (uint32_t)(got >> shift), 0, 0);
+    return false;
+}
