diff --git a/bsd/dev/santoni_gpu_descriptors.c b/bsd/dev/santoni_gpu_descriptors.c
new file mode 100644
--- /dev/null
+++ b/bsd/dev/santoni_gpu_descriptors.c
@@ -0,0 +1,52 @@
+#include "santoni_gpu_descriptors.h"
+#include <stddef.h>
+#if defined(ARM64_BOARD_CONFIG_SANTONI)
+#define SGPU_DESCRIPTOR_FN __attribute__((noinline))
+#include "santoni_gpu_descriptor_fields.h"
+bool SGPU_DESCRIPTOR_FN sgpu_sampler_subset(const uint32_t *words,uint32_t count)
+{
+    if(!words || ((uintptr_t)words&3) || count!=4 || words[3])return false;
+    /* Mesa fd5_texture.c limits non-mipmap LOD to 0.125 = 32/256 so HW
+     * can select min/mag filtering at level0. No border/compare/aniso/mipmap
+     * mode or unknown field is admitted in this initial two-dimensional path. */
+    if(words[0]&~UINT32_C(0x3ffe) || words[1]&~UINT32_C(0xffffff10) ||
+        words[2]&127u || D_SAMP_XY_MAG(words)>1 || D_SAMP_XY_MIN(words)>1 ||
+        D_SAMP_WRAP_S(words)>2 || D_SAMP_WRAP_T(words)>2 || D_SAMP_WRAP_R(words)>2 ||
+        D_SAMP_MIN_LOD(words)>D_SAMP_MAX_LOD(words) || D_SAMP_MAX_LOD(words)>32 ||
+        D_SAMP_BCOLOR_OFFSET(words)>31)return false;
+    return true;
+}
+bool SGPU_DESCRIPTOR_FN sgpu_texture_subset(const uint32_t *words,uint32_t count,const struct sgpu_descriptor_range *ranges,uint32_t nr,
+    struct sgpu_texture_result *result)
+{
+    if(!words || ((uintptr_t)words&3) || count!=12 || !ranges || !nr || nr>64 || !result)return false;
+    /* Field offsets/shifts are from a5xx.xml; the only pixel format here is
+     * TFMT5_8_8_8_8_UNORM =0x30. Limits below are engineering scope, not a
+     * claim of every hardware-supported tiling/format/filter combination. */
+    if(D_TEX_TILE_MODE(words) || D_TEX_MIPLVLS(words) || D_TEX_SAMPLES(words) || D_TEX_FMT(words)!=0x30 ||
+        (words[0]&8u) || D_TEX_SWIZ_X(words)>5 || D_TEX_SWIZ_Y(words)>5 || D_TEX_SWIZ_Z(words)>5 || D_TEX_SWIZ_W(words)>5 ||
+        (words[1]&0xc0000000u) || (words[2]&0x70u) || D_TEX_BUFFER(words) || D_TEX_TYPE(words)!=1 ||
+        (words[3]&~0x3fffu) || (words[4]&31u) || words[5]!=(1u<<17))return false;
+    for(unsigned i=6;i<12;i++)if(words[i])return false;
+    uint32_t width=D_TEX_WIDTH(words),height=D_TEX_HEIGHT(words),pitch=D_TEX_PITCH(words),align=D_TEX_PITCHALIGN(words);
+    uint64_t layer=(uint64_t)D_TEX_ARRAY_PITCH(words)<<12;
+    if(!width || !height || width>4096 || height>4096 || align>6 || pitch<(uint64_t)width*4 ||
+        pitch&((64u<<align)-1) || !layer || layer>UINT32_MAX || (uint64_t)pitch*height>layer)return false;
+    uint32_t va=words[4];
+    if(!va || (uint64_t)va+layer>UINT64_C(0x100000000))return false;
+    const struct sgpu_descriptor_range *owned=NULL;
+    for(uint32_t i=0;i<nr;i++) {
+        const struct sgpu_descriptor_range *r=&ranges[i];
+        if(!r->handle || !r->gpu_va || (r->gpu_va&4095) || !r->bytes ||
+            (uint64_t)r->gpu_va+r->bytes>UINT64_C(0x100000000))return false;
+        for(uint32_t j=0;j<i;j++)if((uint64_t)r->gpu_va<(uint64_t)ranges[j].gpu_va+ranges[j].bytes &&
+            (uint64_t)ranges[j].gpu_va<(uint64_t)r->gpu_va+r->bytes)return false;
+        if(va>=r->gpu_va && va-r->gpu_va<=r->bytes && layer<=r->bytes-(va-r->gpu_va)) {
+            if(owned)return false; /* ambiguous supplied ownership is refused */
+            owned=r;
+        }
+    }
+    if(!owned)return false;
+    struct sgpu_texture_result checked={owned->handle,va,width,height,pitch,(uint32_t)layer};*result=checked;return true;
+}
+#endif /* ARM64_BOARD_CONFIG_SANTONI */
