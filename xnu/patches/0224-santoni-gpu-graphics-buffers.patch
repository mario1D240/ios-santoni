+static bool __attribute__((noinline)) sgpu_graphics_hw_stop(void)
+{
+    struct probe *p=&session_core.p;uint32_t wptr=sgpu_graphics_hw.wptr;
+    if (!sgpu_graphics_hw_tables() || !sgpu_graphics_hw_state(wptr,0,0x1127,0)) return sgpu_graphics_hw_fail(SG_BAD_MEMORY);
+    sgpu_graphics_hw.exposed=true;
