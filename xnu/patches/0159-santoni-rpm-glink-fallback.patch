+/*
+ * GLINK-RPM native transport (ported from ios-sailfish bsd/dev/sweet_rpm.c,
+ * silicon-proven on msm8996): if the second msg-ram bank ends with a "grt0"
+ * TOC, this RPM firmware speaks glink for data and the SMD channel state
+ * machine is just a facade -- discover the ap2r/r2ap FIFOs from the TOC and
+ * run the VERSION/OPEN/TX_DATA handshake on them.  Only used after the SMD
+ * data path stays silent; the doorbell is the same APCS1 IPC bit 0.
+ */
+#define GLINK_TOC_MAGIC         0x67727430u     /* "grt0" */
+#define GLINK_FIFO_AP2R         0x61703272u
+#define GLINK_FIFO_R2AP         0x72326170u
+#define GLINK_LCID              1u
+#define GLINK_CMD_VERSION       0u
+#define GLINK_CMD_VERSION_ACK   1u
+#define GLINK_CMD_OPEN          2u
+#define GLINK_CMD_OPEN_ACK      4u
+#define GLINK_CMD_TX_DATA       9u
+#define GLINK_CMD_READ_NOTIF    13u
