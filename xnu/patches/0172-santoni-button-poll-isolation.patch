@@ -580,6 +582,13 @@
 }
 
 /* key: 0 power (side button), 1 volume up, 2 volume down, 3 home */
+extern "C" bool
+sweet_hid_buttons_ready(void)
+{
+	SweetHIDButtons *buttons = __atomic_load_n(&gSweetButtons, __ATOMIC_ACQUIRE);
+	return buttons && buttons->hasClients();
+}
