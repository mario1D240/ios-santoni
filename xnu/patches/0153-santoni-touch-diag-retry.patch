+	 * Every press does this for the first two minutes (24 presses, one
+	 * every fTestSecs): the Lock Screen can appear long after boot on a
+	 * slow root mount and an early swipe is simply ignored.  Start at
+	 * y = 1270 (the dock background, still inside the 48 px edge-tip
+	 * zone) so a swipe on the Home Screen cannot hit the Safari icon.
 	 */
-	if (press && gSweetTouch && self->fTestCount < 6) {
+	if (press && gSweetTouch && self->fTestCount < 48) {
 		int cx = 360;
