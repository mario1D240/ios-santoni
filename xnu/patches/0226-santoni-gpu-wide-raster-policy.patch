new file mode 100644
--- /dev/null
+++ b/bsd/dev/santoni_gpu_vm.c
@@ -0,0 +1,71 @@
+#include "santoni_gpu_vm.h"
+#include <stddef.h>
+#include <string.h>
+#if defined(ARM64_BOARD_CONFIG_SANTONI)
+#define GVM_FN __attribute__((noinline))
+_Static_assert(SGPU_PAGE==4096,"actual Santoni4K geometry");
+_Static_assert(GVM_BASE==0x02000000u && GVM_L2_FIRST+GVM_L3_PAGES<=512,"32-bit L2 aperture");
+static bool GVM_FN gvm_fail(struct gvm *v,uint32_t error) {if(!v->error)v->error=error;return false;}
+static bool GVM_FN gvm_memory_valid(struct gvm *v,const struct gvm_memory *m,const struct gvm_ops *ops)
+{
+    if(!m || !ops || !ops->owned_private || !ops->page_pa || !ops->reserved_pa || !m->va ||
+        ((uintptr_t)m->va&(SGPU_PAGE-1)) || !m->cookie || m->bytes!=GVM_TABLE_PAGES*SGPU_PAGE ||
+        (uintptr_t)m->va>UINTPTR_MAX-m->bytes)return gvm_fail(v,GVM_INPUT);
+    uintptr_t base=(uintptr_t)m->va,end=base+m->bytes,metadata=(uintptr_t)m;
+    if(metadata>UINTPTR_MAX-sizeof(*m) || (base<metadata+sizeof(*m) && metadata<end) ||
+        (base<(uintptr_t)v+sizeof(*v) && (uintptr_t)v<end))return gvm_fail(v,GVM_INPUT);
+    if(!ops->owned_private(ops->context,m))return gvm_fail(v,GVM_OWNER);
+    for(uint32_t i=0;i<GVM_TABLE_PAGES;i++) {
+        uint64_t pa=m->pa[i];
+        if((pa&(SGPU_PAGE-1)) || pa<SGPU_DMA_MIN || pa>SGPU_DMA_END-SGPU_PAGE ||
+            ops->page_pa(ops->context,m,i)!=pa)return gvm_fail(v,GVM_PAGE);
+        if(ops->reserved_pa(ops->context,pa))return gvm_fail(v,GVM_RESERVED);
+        for(uint32_t j=0;j<i;j++)if(m->pa[j]==pa)return gvm_fail(v,GVM_PAGE);
+    }
+    return true;
+}
+bool GVM_FN gvm_prepare(struct gvm *v,const struct gvm_memory *memory,const struct gvm_ops *ops)
+{
+    if(!v || v->prepared || v->memory.va || v->error)return false;
+    if(!gvm_memory_valid(v,memory,ops))return false;
+    /* Fresh private pages must be zero. Unknown scratch/live content is never
+     * silently erased to manufacture an allocator/table proof. */
+    const uint64_t *words=(const uint64_t *)(const void *)memory->va;
+    for(uint32_t i=0;i<memory->bytes/8;i++)if(words[i])return gvm_fail(v,GVM_NONZERO);
+    v->memory=*memory;v->ops=*ops;
+    memset(v->ptes,0,sizeof(v->ptes));
+    for(unsigned i=0;i<GVM_L3_PAGES;i++)v->l2[i]=memory->pa[i]|3u;
+    v->ptes[0]=memory->pa[GVM_FENCE_PAGE]|GVM_PTE_RW;
+    ((uint64_t *)(void *)memory->va)[0]=v->ptes[0];
+    v->prepared=true;return true;
+}
+bool GVM_FN gvm_verify(struct gvm *v)
+{
+    if(!v || !v->prepared || v->error)return false;
+    if(!gvm_memory_valid(v,&v->memory,&v->ops))return false;
+    if(v->ptes[0]!=(v->memory.pa[GVM_FENCE_PAGE]|GVM_PTE_RW))return gvm_fail(v,GVM_CHANGED);
+    const uint64_t *words=(const uint64_t *)(const void *)v->memory.va;
+    for(uint32_t i=0;i<GVM_PAGES;i++)if(words[i]!=v->ptes[i])return gvm_fail(v,GVM_CHANGED);
+    for(unsigned i=0;i<GVM_L3_PAGES;i++)if(v->l2[i]!=(v->memory.pa[i]|3u))return gvm_fail(v,GVM_CHANGED);
+    return true;
+}
+bool GVM_FN gvm_propose_l2(struct gvm *v,const uint64_t *current,uint64_t *candidate)
+{
+    if(!v || !current || !candidate || ((uintptr_t)current&7) || ((uintptr_t)candidate&7))return false;
+    uintptr_t old=(uintptr_t)current,next=(uintptr_t)candidate,size=512u*8u;
+    if(old>UINTPTR_MAX-size || next>UINTPTR_MAX-size || (old<next+size && next<old+size))return gvm_fail(v,GVM_ROOT);
+    if(!gvm_verify(v))return false;
+    uintptr_t table=(uintptr_t)v->memory.va;
+    if((next<table+v->memory.bytes && table<next+size) ||
+        (next<(uintptr_t)v+sizeof(*v) && (uintptr_t)v<next+size))return gvm_fail(v,GVM_ROOT);
+    for(unsigned i=0;i<GVM_L3_PAGES;i++)if(current[GVM_L2_FIRST+i])return gvm_fail(v,GVM_ROOT);
+    memcpy(candidate,current,size);
+    for(unsigned i=0;i<GVM_L3_PAGES;i++)candidate[GVM_L2_FIRST+i]=v->l2[i];
+    return true; /* caller has not published or modified the original root */
+}
+bool GVM_FN gvm_index(const struct gvm *v,uint32_t va,uint32_t *index)
+{
+    if(!v || !v->prepared || v->error || !index || va<GVM_BASE || (va&(SGPU_PAGE-1)) || va-GVM_BASE>=GVM_BYTES)return false;
+    *index=(va-GVM_BASE)/SGPU_PAGE;return true;
+}
+#endif /* ARM64_BOARD_CONFIG_SANTONI */
