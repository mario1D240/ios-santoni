+/* PAS cache view: an AT translation reads attributes without reading a page
+ * whose permission may be under investigation. IRQ exclusion keeps PAR_EL1
+ * paired with this translation; restore the prior interrupt state always. */
+static bool __attribute__((noinline)) sgpu_pas_cache_view(vm_offset_t va, uint64_t pa, uint32_t attribute)
+{
+    if (!va || !pa || (va & 4095u) || (pa & 4095u)) return false;
+    boolean_t interrupts = ml_set_interrupts_enabled(FALSE);
+    uint64_t par;
+    __asm__ volatile("dsb ish\n\tat s1e1r, %1\n\tisb\n\tmrs %0, par_el1"
+        : "=r"(par) : "r"(va) : "memory");
+    (void)ml_set_interrupts_enabled(interrupts);
+    return !(par & 1u) && (par & 0x0000fffffffff000ull) == pa &&
+        (uint32_t)(par >> 56) == attribute;
+}
+
+/* PAS cache policy: no SCM or GPU work. Fresh owned spans only. The current
+ * probe uses test bytes, not firmware; future PAS must set memory.exposed
+ * before its first address-bearing call, after which release refuses all work. */
+struct sgpu_pas_cached_span {
+    struct sgpu_pas_memory memory;
+    uint32_t converted_pages;
+    bool uncertain;
+};
+
+static bool __attribute__((noinline)) sgpu_pas_cached_views(const struct sgpu_pas_memory *memory,
+    uint32_t offset, uint32_t attribute)
+{
+    if (!memory || !memory->va || !memory->pa || memory->exposed ||
+        (memory->va & (SGPU_PAGE - 1u)) || (memory->pa & (SGPU_PAGE - 1u)) ||
+        !memory->bytes || memory->bytes > SG_PAS_MAX_BYTES ||
+        (memory->bytes & (SGPU_PAGE - 1u)) || offset >= memory->bytes ||
+        (offset & (SGPU_PAGE - 1u)) || memory->pa > 0x100000000ull - memory->bytes ||
+        memory->va > ~(vm_offset_t)0 - memory->bytes) return false;
+    uint64_t pa = memory->pa + offset;
+    if (((uint64_t)pmap_find_phys(kernel_pmap, memory->va + offset) << 12) != pa) return false;
+    vm_offset_t aperture = (vm_offset_t)phystokv(pa);
+    return sgpu_pas_cache_view(memory->va + offset, pa, attribute) &&
+        sgpu_pas_cache_view(aperture, pa, attribute);
+}
+
+static bool __attribute__((noinline)) sgpu_pas_cached_prepare(struct sgpu_pas_cached_span *span)
+{
+    if (!span || span->converted_pages || span->uncertain || span->memory.exposed ||
+        !span->memory.bytes || span->memory.bytes > SG_PAS_MAX_BYTES ||
+        (span->memory.bytes & (SGPU_PAGE - 1u))) return false;
+    /* Establish all page identities and leaf eligibility before changing any
+     * cache policy. Reclaimed block/hinted mappings fail without a live split. */
+    for (uint32_t off = 0; off < span->memory.bytes; off += SGPU_PAGE) {
+        if (!sgpu_pas_cached_views(&span->memory, off, 0xff) ||
+            !pmap_santoni_pas_cache_control((ppnum_t)((span->memory.pa + off) >> 12),
+                VM_WIMG_DEFAULT, VM_WIMG_DEFAULT)) return false;
+    }
+    CleanPoC_DcacheRegion_Force(span->memory.va, span->memory.bytes);
+    for (uint32_t off = 0; off < span->memory.bytes; off += SGPU_PAGE) {
+        span->uncertain = true; /* a failed transition may have changed an alias */
+        if (!pmap_santoni_pas_cache_control((ppnum_t)((span->memory.pa + off) >> 12),
+                VM_WIMG_DEFAULT, VM_WIMG_WCOMB) ||
+            !sgpu_pas_cached_views(&span->memory, off, 0x44)) return false;
+        span->converted_pages++;
+        span->uncertain = false;
+    }
+    return true;
+}
+
+static bool __attribute__((noinline)) sgpu_pas_cached_release(struct sgpu_pas_cached_span *span)
+{
+    if (!span || span->memory.exposed || span->uncertain ||
+        span->memory.bytes > SG_PAS_MAX_BYTES || (span->memory.bytes & (SGPU_PAGE - 1u)) ||
+        span->converted_pages > span->memory.bytes / SGPU_PAGE) return false;
+    if (!span->memory.bytes) return !span->memory.va && !span->memory.pa;
+    if (!span->memory.va || !span->memory.pa ||
+        (span->memory.va & (SGPU_PAGE - 1u)) || (span->memory.pa & (SGPU_PAGE - 1u)) ||
+        span->memory.pa > 0x100000000ull - span->memory.bytes ||
+        span->memory.va > ~(vm_offset_t)0 - span->memory.bytes) return false;
+    while (span->converted_pages) {
+        uint32_t off = (span->converted_pages - 1u) * SGPU_PAGE;
+        if (!sgpu_pas_cached_views(&span->memory, off, 0x44)) {
+            span->uncertain = true;
+            return false;
+        }
+        span->uncertain = true;
+        if (!pmap_santoni_pas_cache_control((ppnum_t)((span->memory.pa + off) >> 12),
+                VM_WIMG_WCOMB, VM_WIMG_DEFAULT) ||
+            !sgpu_pas_cached_views(&span->memory, off, 0xff)) return false;
+        span->converted_pages--;
+        span->uncertain = false;
+    }
+    return sgpu_pas_release(&span->memory);
+}
