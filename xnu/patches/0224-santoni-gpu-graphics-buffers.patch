+        !poll(p,SG_GPU,SG_STATUS,SG_IDLE_MASK,0,10000) ||
+        !checked_write32(p,SG_SMMU,SG_S2CR0,~0u,SG_S2CR_FAULT) ||
+        !checked_write32(p,SG_SMMU,SG_CB,~0u,0x1126) ||
+        !sgpu_graphics_hw_state(wptr,3,0x1126,SG_S2CR_FAULT) || !sgpu_graphics_hw_tables())
+        return sgpu_graphics_hw_fail(SG_BAD_SMMU);
