+static bool __attribute__((noinline)) sgpu_a505_halt(struct probe *p, uint32_t site)
+{
+    /* Preserve inherited fields as the vendor A5xx fault-stop path does.
+     * Echo rejection is a conservative diagnostic gate, not an idle proof. */
+    uint32_t old = read32(p, SG_GPU, SG_ME_CNTL);
+    uint32_t written = old | SG_CP_STOP_MASK;
+    write32(p, SG_GPU, SG_ME_CNTL, written);
+    uint32_t got = read32(p, SG_GPU, SG_ME_CNTL);
+    /* 1=handoff, 2=after reset, 3=cleanup, 4=after recovery reset. No pause. */
+    trace(p, "A505 CP halt site/old/got", site, old, got);
+    if ((got & SG_CP_STOP_MASK) == SG_CP_STOP_MASK) return true;
+    sgpu_failure(p, SG_FAIL_READBACK, SG_GPU, SG_ME_CNTL, SG_CP_STOP_MASK,
+        SG_CP_STOP_MASK, old, written, got, 0, 0);
+    return false;
+}
