 	/*
-	 * Per-CPU CPU-interface setup. Every core needs its own PMR/BPR/CTLR or it
-	 * never takes an IRQ; only CPU 0 used to do this, which is why the secondaries
-	 * came up but stayed deaf (hence single-core boot).
+	 * GICv2 SGI/PPI group, priority, enable and active state is banked too.
+	 * Linux gic_cpu_init()/gic_cpu_config() resets it on EVERY CPU, not just
+	 * the CPU performing distributor initialization. Do not inherit firmware
+	 * PPIs/priorities on secondaries or disturb another CPU's private bank.
 	 */
 	if (gicd_base && gicc_base) {
+		vm_offset_t gicd = gicd_base;
 		uint64_t mpidr = __builtin_arm_rsr64("MPIDR_EL1");
