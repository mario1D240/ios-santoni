 static LCK_GRP_DECLARE(mockfs_mtx_grp, "mockfs-mutex");
 
 int mockfs_mountroot(mount_t mp, vnode_t rvp, __unused vfs_context_t ctx);
+#if defined(ARM64_BOARD_CONFIG_SANTONI)
+static int mockfs_santoni_mount(mount_t mp, vnode_t devvp, user_addr_t data, vfs_context_t ctx)
+{
+    struct sgpu_launch_mount input={0};
+    const uint32_t required=MNT_RDONLY|MNT_NOSUID|MNT_NOATIME;
+    if (!vfs_context_iskernel(ctx) || !(mp->mnt_kern_flag&MNTK_KERNEL_MOUNT) ||
+        (mp->mnt_flag&required)!=required ||
+        (mp->mnt_flag&(MNT_UPDATE|MNT_RELOAD|MNT_ROOTFS|MNT_NOEXEC)) || devvp ||
+        !santoni_gpu_user_launch_mount_args((const void *)(uintptr_t)data,&input)) return EINVAL;
+    mockfs_mount_t m=kalloc_type(struct mockfs_mount,Z_WAITOK|Z_ZERO);
+    if (!m) return ENOMEM;
+    lck_mtx_init(&m->mockfs_mnt_mtx,&mockfs_mtx_grp,LCK_ATTR_NULL);
+    m->mockfs_memory_backed=TRUE;
+    m->santoni_probe_kva=input.kva;
+    m->santoni_probe_file_bytes=input.file_bytes;
+    m->santoni_probe_span_bytes=input.span_bytes;
+    mp->mnt_data=(typeof(mp->mnt_data))m;
+    mockfs_fsnode_t root=NULL,dev=NULL,file=NULL;
+    int error=mockfs_fsnode_create(mp,MOCKFS_ROOT,&root);
+    if (!error) error=mockfs_fsnode_create(mp,MOCKFS_DEV,&dev);
+    if (!error) error=mockfs_fsnode_create(mp,MOCKFS_FILE,&file);
+    if (!error) error=mockfs_fsnode_adopt(root,dev);
+    if (!error) error=mockfs_fsnode_adopt(root,file);
+    if (!error) { m->mockfs_root=root; return 0; }
+    /* No vnode has been requested before returning a successful mount.
+     * Adopt state determines which tree owns the file during cleanup. */
+    if (file && !file->parent) (void)mockfs_fsnode_destroy(file);
+    if (dev && !dev->parent) (void)mockfs_fsnode_destroy(dev);
+    if (root) (void)mockfs_fsnode_destroy(root);
+    mp->mnt_data=NULL;
+    lck_mtx_destroy(&m->mockfs_mnt_mtx,&mockfs_mtx_grp);
+    kfree_type(struct mockfs_mount,m);
+    return error;
+}
+#endif
 
