+/* Versioned scalar-only Santoni GPU diagnostic ABI. No pointers or BO maps. */
+#ifndef SANTONI_GPU_UAPI_H
+#define SANTONI_GPU_UAPI_H
+#include <stdint.h>
+
+#define SGPU_USER_VERSION 1u
+#define SGPU_USER_BYTES 128u
+/* Darwin _IOWR('G', N, struct sgpu_user_packet), checked again in the adapter. */
+#define SGPU_USER_INFO   0xc0804701u
+#define SGPU_USER_SUBMIT 0xc0804702u
+#define SGPU_USER_POLL   0xc0804703u
+#define SGPU_USER_CLOSE  0xc0804704u
+
+struct sgpu_user_packet {
+    uint32_t version, bytes, id, rc;
+    uint32_t value[4];
+    uint32_t state, reason, admitted, outstanding, active, committed, submitted, completed;
+    uint32_t cancelled, failed, writes, last_seq, wptr, error, failed_id, idle;
+    uint32_t result_state, result_seq, result_wptr, result_writes;
+    uint32_t result_error, result_phase, publish_attempted, reserved;
+};
+_Static_assert(sizeof(struct sgpu_user_packet)==SGPU_USER_BYTES, "fixed pointer-free GPU ABI");
+#endif
