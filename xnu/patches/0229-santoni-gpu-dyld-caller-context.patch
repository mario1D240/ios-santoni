+    if(call!=90)return ENOPOLICY;
+    flags=santoni_gpu_graphics_dyld_flags(process);
+    int error=ENOPOLICY;
+    unsigned stage=1;
+    if(flags) {
+        stage=2;
+        if(copyin(arg,args,sizeof(args))!=0)error=EFAULT;
+        else if(!args[1]) {stage=3;error=EFAULT;}
+        else {stage=4;error=copyout(&flags,(user_addr_t)args[1],sizeof(flags));}
+    }
+    /* One fixed scalar line per selector90 query, only with explicit renderer
+     * opt-in. No user pointers/strings; printk's return cannot change policy.
+     * stage1=denied,2=copyin failed,3=null output,4=copyout attempted. */
+    int renderer=0;
+    PE_parse_boot_argn("santonigpu_renderer",&renderer,sizeof(renderer));
+    if(renderer==1) {
+        int pid=process?proc_pid(process):0;
+        unsigned uid=process?proc_getuid(process):~0u;
+        printf("SANTONI GPU: dyld syscall90 pid=%d uid=%u flags=%llx stage=%u error=%d\n",
+            pid,uid,(unsigned long long)flags,stage,error);
+    }
+    return error;
 }

