 /*
+ * Publish fresh wired kernel memory as a surface, the way a userspace
+ * IOSurfaceCreate() would. Used for display frames the kernel composes
+ * itself, where the panel memory cannot be published directly (a 24-bit
+ * panel is not a 32-bit IOSurface).
+ */
+SweetSurface *sweet_surface_create_buffer(uint32_t width, uint32_t height,
+    uint32_t bytesPerRow, uint32_t pixelFormat);
