+        bool ready=santoni_gpu_user_launch_worker_ready(sg.mode);
+        bool mounted=santoni_gpu_user_launch_mount_published();
+        printf("SANTONI GPU: USER LAUNCH LATE mode=%u worker_ready=%u mounted=%u; CPU snapshot; EL0 RESULT still required\n",
+            sg.mode,ready?1u:0u,mounted?1u:0u);
+    }
     return true;
 }
 
