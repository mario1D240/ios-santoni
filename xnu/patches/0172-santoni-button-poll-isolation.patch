 {
@@ -588,17 +597,19 @@
 		kHIDUsage_Csmr_VolumeDecrement, kHIDUsage_Csmr_Menu,
 	};
 
-	if (gSweetButtons && key >= 0 && key < (int)(sizeof(usages) / sizeof(usages[0]))) {
