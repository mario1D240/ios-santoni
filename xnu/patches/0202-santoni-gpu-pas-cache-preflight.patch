+/* pmap_ttne() deliberately panics on a block in MACH_ASSERT builds. This
+ * bounded read-only variant rejects such an aperture without attempting to
+ * demote it. The kernel aperture's parent tables are fixed at bootstrap. */
+static pt_entry_t *
+pmap_santoni_pas_aperture_pte(vm_map_address_t va)
+{
+	const pt_attr_t *attr = pmap_get_pt_attr(kernel_pmap);
+	if (!attr || !kernel_pmap->tte || va < kernel_pmap->min || va >= kernel_pmap->max ||
+	    attr->pta_root_level > PMAP_TT_L3_LEVEL || attr->pta_max_level != PMAP_TT_L3_LEVEL ||
+	    pt_attr_page_size(attr) != 4096) {
+		return PT_ENTRY_NULL;
+	}
+	tt_entry_t *table = kernel_pmap->tte;
+	for (unsigned level = attr->pta_root_level; level <= PMAP_TT_L3_LEVEL; level++) {
+		tt_entry_t *entry = &table[ttn_index(attr, va, level)];
+		if (level == PMAP_TT_L3_LEVEL) {
+			return (pt_entry_t *)entry;
+		}
+		if ((*entry & (ARM_TTE_TYPE_MASK | ARM_TTE_VALID)) !=
+		    (ARM_TTE_TYPE_TABLE | ARM_TTE_VALID)) {
+			return PT_ENTRY_NULL;
+		}
+		pmap_paddr_t next = *entry & ARM_TTE_TABLE_MASK;
+		if (!next || !pa_valid(next)) {
+			return PT_ENTRY_NULL;
+		}
+		table = (tt_entry_t *)phystokv(next);
+	}
+	return PT_ENTRY_NULL;
+}
