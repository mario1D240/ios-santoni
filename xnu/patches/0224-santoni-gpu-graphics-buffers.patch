diff --git a/bsd/dev/santoni_gpu_pm4.c b/bsd/dev/santoni_gpu_pm4.c
new file mode 100644
index 0000000..e0711fc
--- /dev/null
+++ b/bsd/dev/santoni_gpu_pm4.c
@@ -0,0 +1,214 @@
+#include "santoni_gpu_pm4.h"
+#include <string.h>
+#if defined(ARM64_BOARD_CONFIG_SANTONI)
+#define PM4_FN __attribute__((noinline))
+/* Opcode/header layouts: msm-4.9-main/drivers/gpu/msm/adreno_pm4types.h.
+ * A5xx DRAW/SET_DRAW_STATE fields: the local adreno_pm4.xml and KGSL
+ * adreno_cp_parser.c. A6xx-only draw-state mode bits are NOT admitted. */
+struct pm4_walk {
+    const struct sgpu_pm4_policy *policy;
+    const struct sgpu_graphics_snapshot *snapshots;
+    const struct sgpu_graphics_range *ranges;
+    uint32_t ns,nr,words,nodes,depth;
+    uint32_t active_va[SGPU_PM4_DEPTH],active_bytes[SGPU_PM4_DEPTH];
+    bool prepare;
+};
+static uint32_t PM4_FN sgpu_pm4_parity(uint32_t value)
+{
+    uint32_t p=1;
+    for (;value;value>>=1)p^=value&1;
+    return p;
+}
+static bool PM4_FN sgpu_pm4_header(uint32_t h,uint32_t *op,uint32_t *count,uint32_t *type)
+{
+    *type=h>>28;
+    if (*type==4) {
+        *count=h&127;*op=(h>>8)&0x3ffff;
+        return *count && h==(0x40000000u|*count|(sgpu_pm4_parity(*count)<<7)|
+            (*op<<8)|(sgpu_pm4_parity(*op)<<27));
+    }
+    if (*type==7) {
+        *count=h&0x3fff;*op=(h>>16)&127;
+        return h==(0x70000000u|*count|(sgpu_pm4_parity(*count)<<15)|
+            (*op<<16)|(sgpu_pm4_parity(*op)<<23));
+    }
+    return false;
+}
+static bool PM4_FN sgpu_pm4_data(const struct pm4_walk *w,uint64_t va,uint32_t bytes,bool write)
+{
+    if (!bytes || va>UINT32_MAX || (va&3)) return false;
+    for (uint32_t i=0;i<w->nr;i++) {
+        const struct sgpu_graphics_range *r=&w->ranges[i];
+        if ((!write || r->flags==SGPU_GRAPHICS_RW) && va>=r->gpu_va &&
+            va-r->gpu_va<=r->bytes && bytes<=r->bytes-(va-r->gpu_va)) return true;
+    }
+    return false;
+}
+static const struct sgpu_graphics_snapshot *PM4_FN sgpu_pm4_snapshot(
+    const struct pm4_walk *w,uint32_t va,uint32_t bytes,bool original)
+{
+    for (uint32_t i=0;i<w->ns;i++) {
+        const struct sgpu_graphics_snapshot *s=&w->snapshots[i];
+        uint32_t base=original?s->source_va:s->gpu_va;
+        if (va>=base && va-base<=s->bytes && bytes<=s->bytes-(va-base)) return s;
+    }
+    return NULL;
+}
+static const struct sgpu_pm4_rule *PM4_FN sgpu_pm4_rule(const struct pm4_walk *w,uint32_t reg)
+{
+    /* CP/RBBM, VBIF and the adapter's protected/security window are never
+     * exposed through a register policy. SG_* are documented byte offsets;
+     * PM4 registers are word indices. See core.h and vendor a5xx_reg.h. */
+    if (reg<0xa00 || (reg>=SG_VBIF_VERSION/4 && reg<0x4000) || reg>=0x3c000/4) return NULL;
+    for (uint32_t i=0;i<w->policy->count;i++)if(w->policy->rules[i].reg==reg)return &w->policy->rules[i];
+    return NULL;
+}
+static bool PM4_FN sgpu_pm4_registers(struct pm4_walk *w,uint32_t reg,const uint32_t *p,uint32_t count)
+{
+    for (uint32_t i=0;i<count;) {
+        const struct sgpu_pm4_rule *r=sgpu_pm4_rule(w,reg+i);
+        if (!r || (p[i]&~r->allowed_bits) || (p[i]&r->required_mask)!=r->required_value) return false;
+        if (r->kind==SG_PM4_VALUE) {i++;continue;}
+        if ((r->kind!=SG_PM4_READ64 && r->kind!=SG_PM4_WRITE64) || i+1>=count ||
+            p[i+1] || r->shift>12 || !r->alignment || (r->alignment&(r->alignment-1)) ||
+            r->alignment>SGPU_PAGE || !r->minimum_bytes ||
+            (p[i]&r->address_flags)!=r->address_value) return false;
+        uint64_t va=(uint64_t)(p[i]&~r->address_flags)<<r->shift;
+        if (va&(r->alignment-1) || !sgpu_pm4_data(w,va,r->minimum_bytes,r->kind==SG_PM4_WRITE64)) return false;
+        i+=2;
+    }
+    return true;
+}
+static bool sgpu_pm4_walk(struct pm4_walk *,uint32_t,uint32_t);
+static bool PM4_FN sgpu_pm4_child(struct pm4_walk *w,uint32_t *lo,uint32_t hi,uint32_t words)
+{
+    if (hi || !words || words>SGPU_GRAPHICS_IB_BYTES/4 || (*lo&3)) return false;
+    uint32_t bytes=words*4,va=*lo;
+    if (w->prepare) {
+        const struct sgpu_graphics_snapshot *s=sgpu_pm4_snapshot(w,va,bytes,true);
+        if (s) {va=s->gpu_va+va-s->source_va;*lo=va;}
+        else if (!sgpu_pm4_snapshot(w,va,bytes,false)) return false;
+    } else if (!sgpu_pm4_snapshot(w,va,bytes,false)) return false;
+    return sgpu_pm4_walk(w,va,bytes);
+}
+static bool PM4_FN sgpu_pm4_draw(struct pm4_walk *w,uint32_t op,const uint32_t *p,uint32_t n)
+{
+    if (!w->policy->draw || !n || (p[0]&~0xfffu) || (p[0]&63)>0x1fu) return false;
+    uint32_t source=(p[0]>>6)&3,index=(p[0]>>10)&3;
+    if (index>2) return false;
+    if (op==0x38) { /* A5xx DRAW_INDX_OFFSET: AUTO4 or DMA7, NOT the A4xx six-word form */
+        if (n==4) return source==2 && p[1] && p[1]<=65535 && p[2] && p[2]<=1048576 && p[3]<=1048576-p[2];
+        if (n!=7 || source || !p[1] || p[1]>65535 || !p[2] || p[3]>p[6] || p[2]>p[6]-p[3]) return false;
+        uint64_t bytes=(uint64_t)p[6]*(1u<<index);
+        return bytes && bytes<=UINT32_MAX && sgpu_pm4_data(w,(uint64_t)p[4]|((uint64_t)p[5]<<32),(uint32_t)bytes,false);
+    }
+    if (op==0x28) return n==3 && source==2 && sgpu_pm4_data(w,(uint64_t)p[1]|((uint64_t)p[2]<<32),16,false);
+    if (op==0x29) {
+        if (n!=6 || source) return false;
+        uint64_t bytes=(uint64_t)p[3]*(1u<<index);
+        return bytes && bytes<=UINT32_MAX && sgpu_pm4_data(w,(uint64_t)p[1]|((uint64_t)p[2]<<32),(uint32_t)bytes,false) &&
+            sgpu_pm4_data(w,(uint64_t)p[4]|((uint64_t)p[5]<<32),20,false);
+    }
+    return false;
+}
+static bool PM4_FN sgpu_pm4_packet(struct pm4_walk *w,uint32_t op,uint32_t *p,uint32_t n)
+{
+    switch (op) {
+    case 0x10:return true; /* CP_NOP: payload intentionally opaque */
+    case 0x12:case 0x13:case 0x26:return n==0; /* vendor WAIT_MEM_WRITES / WAIT_FOR_ME / WAIT_FOR_IDLE */
+    case 0x37:case 0x3f:return n==3 && sgpu_pm4_child(w,&p[0],p[1],p[2]);
+    case 0x43: /* 32 A5xx groups; bits20..22 are A6xx-only and rejected */
+        if (!n || n%3) return false;
+        for (uint32_t i=0;i<n;i+=3) {
+            uint32_t control=p[i],count=control&0xffff;
+            if (control&~0x1f0fffffu) return false;
+            if ((control&(3u<<17)) || !count) {
+                if (count || p[i+1] || p[i+2]) return false;
+            } else if (!sgpu_pm4_child(w,&p[i+1],p[i+2],count)) return false;
+        }
+        return true;
+    case 0x3d: /* CP_MEM_WRITE: 64-bit address then bounded data */
+        return n>=3 && sgpu_pm4_data(w,(uint64_t)p[0]|((uint64_t)p[1]<<32),(n-2)*4,true);
+    case 0x46: /* No private/kernel fence address is admitted from userspace. */
+        if (n==1)return p[0]<64 && ((w->policy->events_without_address>>p[0])&1);
+        return n==4 && (p[0]==4 || p[0]==0x1d) &&
+            sgpu_pm4_data(w,(uint64_t)p[1]|((uint64_t)p[2]<<32),4,true);
+    case 0x28:case 0x29:case 0x38:return sgpu_pm4_draw(w,op,p,n);
+    default:return false; /* no secure/protected/preemption/SMMU/compute or unbounded wait packets */
+    }
+}
+static bool PM4_FN sgpu_pm4_walk(struct pm4_walk *w,uint32_t va,uint32_t bytes)
+{
+    if ((va|bytes)&3 || !bytes || w->depth>=SGPU_PM4_DEPTH || w->nodes>=SGPU_PM4_NODES ||
+        bytes/4>SGPU_PM4_WORDS-w->words) return false;
+    const struct sgpu_graphics_snapshot *s=sgpu_pm4_snapshot(w,va,bytes,false);
+    if (!s) return false;
+    for (uint32_t i=0;i<w->depth;i++)
+        if ((uint64_t)va<(uint64_t)w->active_va[i]+w->active_bytes[i] &&
+            (uint64_t)w->active_va[i]<(uint64_t)va+bytes) return false;
+    w->active_va[w->depth]=va;w->active_bytes[w->depth++]=bytes;w->nodes++;w->words+=bytes/4;
+    uint32_t *words=s->words+(va-s->gpu_va)/4;
+    for (uint32_t pos=0;pos<bytes/4;) {
+        uint32_t type,op,count;
+        if (!sgpu_pm4_header(words[pos],&op,&count,&type) || count>bytes/4-pos-1) return false;
+        bool ok=type==4?sgpu_pm4_registers(w,op,&words[pos+1],count):sgpu_pm4_packet(w,op,&words[pos+1],count);
+        if (!ok)return false;
+        pos+=count+1;
+    }
+    w->depth--;return true;
+}
+static bool PM4_FN sgpu_pm4_inputs(const struct sgpu_pm4_policy *policy,
+    const struct sgpu_graphics_snapshot *s,uint32_t ns,const struct sgpu_graphics_command *roots,uint32_t ni,
+    const struct sgpu_graphics_range *r,uint32_t nr)
+{
+    if (!policy || policy->count>256 || (policy->count && !policy->rules) || !s || !ns ||
+        ns>SGPU_GRAPHICS_IBS || !roots || !ni || ni>SGPU_GRAPHICS_IBS || !r || !nr || nr>SGPU_GRAPHICS_BOS) return false;
+    for (uint32_t i=0;i<ns;i++) {
+        if (!s[i].words || ((uintptr_t)s[i].words&3) || !s[i].bytes || s[i].bytes>SGPU_GRAPHICS_IB_BYTES ||
+            ((s[i].source_va|s[i].gpu_va|s[i].bytes)&3) || s[i].source_va>UINT32_MAX-s[i].bytes ||
+            s[i].gpu_va>UINT32_MAX-s[i].bytes || (uintptr_t)s[i].words>UINTPTR_MAX-s[i].bytes ||
+            s[i].source_va<SGPU_RENDER_VA+SGPU_PAGE || s[i].gpu_va<SGPU_RENDER_VA+SGPU_PAGE ||
+            s[i].source_va+s[i].bytes>SGPU_RENDER_VA+SGPU_RENDER_MAX_PAGES*SGPU_PAGE ||
+            s[i].gpu_va+s[i].bytes>SGPU_RENDER_VA+SGPU_RENDER_MAX_PAGES*SGPU_PAGE) return false;
+        for (uint32_t j=0;j<ns;j++) {
+            if ((uint64_t)s[i].source_va<(uint64_t)s[j].gpu_va+s[j].bytes &&
+                (uint64_t)s[j].gpu_va<(uint64_t)s[i].source_va+s[i].bytes) return false;
+            if (j<i && (((uint64_t)s[i].source_va<(uint64_t)s[j].source_va+s[j].bytes &&
+                    (uint64_t)s[j].source_va<(uint64_t)s[i].source_va+s[i].bytes) ||
+                ((uint64_t)s[i].gpu_va<(uint64_t)s[j].gpu_va+s[j].bytes &&
+                    (uint64_t)s[j].gpu_va<(uint64_t)s[i].gpu_va+s[i].bytes))) return false;
+            if (j<i && (uintptr_t)s[i].words<(uintptr_t)s[j].words+s[j].bytes &&
+                (uintptr_t)s[j].words<(uintptr_t)s[i].words+s[i].bytes) return false;
+        }
+    }
+    for (uint32_t i=0;i<nr;i++) {
+        if (!r[i].handle || !r[i].bytes || r[i].gpu_va>UINT32_MAX-r[i].bytes ||
+            r[i].gpu_va<SGPU_RENDER_VA+SGPU_PAGE ||
+            r[i].gpu_va+r[i].bytes>SGPU_RENDER_VA+SGPU_RENDER_MAX_PAGES*SGPU_PAGE ||
+            (r[i].flags!=SGPU_GRAPHICS_RO && r[i].flags!=SGPU_GRAPHICS_RW)) return false;
+        for (uint32_t j=0;j<i;j++)if(r[i].handle==r[j].handle ||
+            ((uint64_t)r[i].gpu_va<(uint64_t)r[j].gpu_va+r[j].bytes &&
+             (uint64_t)r[j].gpu_va<(uint64_t)r[i].gpu_va+r[i].bytes))return false;
+        for (uint32_t j=0;j<ns;j++) if ((uint64_t)r[i].gpu_va<(uint64_t)s[j].gpu_va+s[j].bytes &&
+            (uint64_t)s[j].gpu_va<(uint64_t)r[i].gpu_va+r[i].bytes) return false;
+    }
+    return true;
+}
+static bool PM4_FN sgpu_pm4_run(const struct sgpu_pm4_policy *policy,
+    const struct sgpu_graphics_snapshot *s,uint32_t ns,const struct sgpu_graphics_command *roots,uint32_t ni,
+    const struct sgpu_graphics_range *r,uint32_t nr,bool prepare)
+{
+    if (!sgpu_pm4_inputs(policy,s,ns,roots,ni,r,nr)) return false;
+    struct pm4_walk w={.policy=policy,.snapshots=s,.ranges=r,.ns=ns,.nr=nr,.prepare=prepare};
+    for (uint32_t i=0;i<ni;i++)if(!sgpu_pm4_walk(&w,roots[i].gpu_va,roots[i].bytes))return false;
+    return true;
+}
+bool PM4_FN sgpu_pm4_prepare(const struct sgpu_pm4_policy *policy,
+    const struct sgpu_graphics_snapshot *s,uint32_t ns,const struct sgpu_graphics_command *roots,uint32_t ni,
+    const struct sgpu_graphics_range *r,uint32_t nr)
+{return sgpu_pm4_run(policy,s,ns,roots,ni,r,nr,true);}
+bool PM4_FN sgpu_pm4_validate(const struct sgpu_pm4_policy *policy,
+    const struct sgpu_graphics_snapshot *s,uint32_t ns,const struct sgpu_graphics_command *roots,uint32_t ni,
+    const struct sgpu_graphics_range *r,uint32_t nr)
+{return sgpu_pm4_run(policy,s,ns,roots,ni,r,nr,false);}
+#endif
diff --git a/bsd/dev/santoni_gpu_pm4.h b/bsd/dev/santoni_gpu_pm4.h
new file mode 100644
index 0000000..f4e147d
--- /dev/null
+++ b/bsd/dev/santoni_gpu_pm4.h
@@ -0,0 +1,32 @@
+/* A505 command validation/relocation. Policy tables are kernel-owned. */
+#ifndef SANTONI_GPU_PM4_H
+#define SANTONI_GPU_PM4_H
+#include "santoni_gpu_graphics.h"
+#define SGPU_PM4_DEPTH 8u
+#define SGPU_PM4_NODES 512u
+#define SGPU_PM4_WORDS (SGPU_GRAPHICS_IBS*SGPU_GRAPHICS_IB_BYTES/4u)
+enum sgpu_pm4_kind { SG_PM4_VALUE, SG_PM4_READ64, SG_PM4_WRITE64 };
+struct sgpu_pm4_rule {
+    uint32_t reg,allowed_bits,required_mask,required_value;
+    uint32_t address_flags,address_value,alignment,minimum_bytes,shift;
+    enum sgpu_pm4_kind kind;
+};
+struct sgpu_pm4_policy {
+    const struct sgpu_pm4_rule *rules;
+    uint32_t count;
+    uint64_t events_without_address; /* audited event IDs only; default empty */
+    bool draw; /* explicitly enable only after the adapter's raster-state audit */
+};
+/* Private snapshots cover full command BOs; roots select execute intervals.
+ * Preparation relocates only command pointers, never shader/data pointers.
+ * Unsupported opcodes, control/security register writes and unowned data
+ * addresses are rejected. No GPU/MMIO/platform call is made here. */
+bool sgpu_pm4_prepare(const struct sgpu_pm4_policy *,
+    const struct sgpu_graphics_snapshot *,uint32_t,
+    const struct sgpu_graphics_command *,uint32_t,
+    const struct sgpu_graphics_range *,uint32_t);
+bool sgpu_pm4_validate(const struct sgpu_pm4_policy *,
+    const struct sgpu_graphics_snapshot *,uint32_t,
+    const struct sgpu_graphics_command *,uint32_t,
+    const struct sgpu_graphics_range *,uint32_t);
+#endif
diff --git a/iokit/Kernel/arm/SantoniGraphics.cpp b/iokit/Kernel/arm/SantoniGraphics.cpp
new file mode 100644
index 0000000..db0a280
--- /dev/null
+++ b/iokit/Kernel/arm/SantoniGraphics.cpp
@@ -0,0 +1,287 @@
+/* Opt-in single-owner rendering transport. No framework injection or Metal.
+ * Public buffers share a retained pool; private command pages have a separate
+ * pool which is NEVER returned through user mapping APIs. Pools and task leases
+ * persist until reboot, including after logical frees/close and GPU failure. */
+#if defined(ARM64_BOARD_CONFIG_SANTONI)
+#include <IOKit/IOService.h>
+#include <IOKit/IOUserClient.h>
+#include <IOKit/IOKitKeys.h>
+#include <IOKit/IOLib.h>
+#include <IOKit/IOLocks.h>
+#include <IOKit/IOBufferMemoryDescriptor.h>
+#include <IOKit/IOMemoryDescriptor.h>
+#include <kern/task.h>
+#include <vm/pmap.h>
+#include <pexpert/pexpert.h>
+#include <mach/mach_time.h>
+extern "C" {
+#include "../../../bsd/dev/santoni_gpu_graphics.h"
+#include "../../../bsd/dev/santoni_gpu_graphics_hw.h"
+#include "../../../bsd/dev/santoni_gpu_graphics_uapi.h"
+#include "../../../bsd/dev/santoni_gpu_pm4.h"
+extern ppnum_t pmap_find_phys(pmap_t,addr64_t);
+}
+
+#define GFX_PRIVATE_PAGES (SGPU_GRAPHICS_IBS*SGPU_GRAPHICS_IB_BYTES/SGPU_PAGE)
+#define GFX_PUBLIC_PAGES (SGPU_GRAPHICS_PAGES-GFX_PRIVATE_PAGES)
+struct gfx_pool {
+    IOBufferMemoryDescriptor *memory;
+    uint8_t *bytes;
+    uint64_t pa[SGPU_GRAPHICS_PAGES];
+    uint8_t used[SGPU_GRAPHICS_PAGES];
+    uint32_t pages;
+};
+struct gfx_lease { gfx_pool *pool;uint32_t first,pages;bool live; };
+static struct {
+    IOLock *lock;
+    task_t owner;
+    bool claimed,pools_ready;
+    gfx_pool user,commands;
+    gfx_lease leases[SGPU_GRAPHICS_BOS];
+    sgpu_graphics core;
+    sgpu_graphics_snapshot snapshots[SGPU_GRAPHICS_IBS];
+    uint32_t snapshot_count;
+    sgpu_pm4_policy policy;
+} gfx;
+
+extern "C" {
+static bool __attribute__((noinline)) gfx_ready(void *) { return santoni_gpu_graphics_worker_ready() && gfx.pools_ready && sgpu_graphics_hw_ready(); }
+static bool __attribute__((noinline)) gfx_pool_init(gfx_pool *p,uint32_t pages,bool user)
+{
+    p->pages=pages;
+    IOOptionBits flags=kIODirectionInOut|(user?kIOMemoryKernelUserShared:0);
+    p->memory=IOBufferMemoryDescriptor::inTaskWithOptions(kernel_task,flags,(uint64_t)pages*SGPU_PAGE,SGPU_PAGE);
+    if (!p->memory || p->memory->getLength()!=(uint64_t)pages*SGPU_PAGE) return false;
+    p->bytes=(uint8_t *)p->memory->getBytesNoCopy();
+    if (!p->bytes || ((uintptr_t)p->bytes&(SGPU_PAGE-1))) return false;
+    for (uint32_t i=0;i<pages;i++) {
+        p->pa[i]=(uint64_t)pmap_find_phys(kernel_pmap,(addr64_t)(uintptr_t)(p->bytes+i*SGPU_PAGE))<<12;
+        if (p->pa[i]<SGPU_DMA_MIN || p->pa[i]>SGPU_DMA_END-SGPU_PAGE || sgpu_graphics_hw_reserved(p->pa[i])) return false;
+        for (uint32_t j=0;j<i;j++) if (p->pa[i]==p->pa[j]) return false;
+    }
+    return true;
+}
+static gfx_lease * __attribute__((noinline)) gfx_lease_for(const sgpu_graphics_memory *m)
+{
+    uintptr_t value=m->cookie,first=(uintptr_t)&gfx.leases[0],end=(uintptr_t)&gfx.leases[SGPU_GRAPHICS_BOS];
+    if (value<first || value>=end || (value-first)%sizeof(gfx_lease)) return nullptr;
+    gfx_lease *l=(gfx_lease *)value;
+    return l->live && l->pool && m->va==l->pool->bytes+l->first*SGPU_PAGE && m->pages==l->pages?l:nullptr;
+}
+static bool __attribute__((noinline)) gfx_allocate(void *,uint32_t bytes,bool private_ib,sgpu_graphics_memory *out)
+{
+    if (!bytes || (bytes&(SGPU_PAGE-1)) || !out) return false;
+    gfx_pool *p=private_ib?&gfx.commands:&gfx.user;
+    uint32_t pages=bytes/SGPU_PAGE,first=p->pages,slot=SGPU_GRAPHICS_BOS;
+    if (pages>p->pages) return false;
+    for (uint32_t i=0;i<SGPU_GRAPHICS_BOS;i++) if (!gfx.leases[i].live) {slot=i;break;}
+    for (uint32_t i=0;i<=p->pages-pages;i++) {
+        uint32_t j=0;for (;j<pages && !p->used[i+j];j++) {}
+        if (j==pages) {first=i;break;}i+=j;
+    }
+    if (slot==SGPU_GRAPHICS_BOS || first==p->pages) return false;
+    gfx.leases[slot]={p,first,pages,true};
+    for (uint32_t i=0;i<pages;i++) p->used[first+i]=1;
+    *out={p->bytes+first*SGPU_PAGE,&p->pa[first],(uintptr_t)&gfx.leases[slot],pages};
+    return true;
+}
+static void __attribute__((noinline)) gfx_release(void *,sgpu_graphics_memory *memory)
+{
+    gfx_lease *l=gfx_lease_for(memory);
+    if (!l) return;
+    /* Core already proved CP/CB/TLB unmap. Return the slice to the SAME pool;
+     * existing user aliases cannot ever address the private command pool. */
+    for (uint32_t i=0;i<l->pages;i++) l->pool->used[l->first+i]=0;
+    *l={};
+}
+static uint64_t __attribute__((noinline)) gfx_page_pa(void *,const sgpu_graphics_memory *memory,uint32_t page)
+{
+    if (!gfx_lease_for(memory) || page>=memory->pages) return 0;
+    return (uint64_t)pmap_find_phys(kernel_pmap,(addr64_t)(uintptr_t)(memory->va+page*SGPU_PAGE))<<12;
+}
+static bool __attribute__((noinline)) gfx_reserved(void *,uint64_t pa) { return sgpu_graphics_hw_reserved(pa); }
+static bool __attribute__((noinline)) gfx_map(void *,uint32_t va,const uint64_t *pa,uint32_t pages,uint64_t attr,uint32_t guard)
+{return sgpu_graphics_hw_map(va,pa,pages,attr,guard);}
+static bool __attribute__((noinline)) gfx_unmap(void *,uint32_t va,uint32_t pages,uint32_t guard) {return sgpu_graphics_hw_unmap(va,pages,guard);}
+static uint64_t __attribute__((noinline)) gfx_pte(void *,uint32_t va) { return sgpu_graphics_hw_pte(va); }
+static void __attribute__((noinline)) gfx_clean(void *,const void *address,uint32_t bytes) {sgpu_graphics_hw_clean(address,bytes);}
+static void __attribute__((noinline)) gfx_invalidate(void *,const void *address,uint32_t bytes) {sgpu_graphics_hw_invalidate(address,bytes);}
+static bool __attribute__((noinline)) gfx_prepare(void *,const sgpu_graphics_snapshot *s,uint32_t ns,const sgpu_graphics_command *r,
+    uint32_t nr,const sgpu_graphics_range *ranges,uint32_t count)
+{
+    if (ns>SGPU_GRAPHICS_IBS) return false;
+    memcpy(gfx.snapshots,s,ns*sizeof(*s));gfx.snapshot_count=ns;
+    return sgpu_pm4_prepare(&gfx.policy,s,ns,r,nr,ranges,count);
+}
+static bool __attribute__((noinline)) gfx_validate(void *,const uint32_t *words,uint32_t count,const sgpu_graphics_range *ranges,uint32_t nr)
+{
+    for (uint32_t i=0;i<gfx.snapshot_count;i++) {
+        const sgpu_graphics_snapshot *s=&gfx.snapshots[i];
+        uintptr_t word=(uintptr_t)words,base=(uintptr_t)s->words;
+        if (word>=base && word-base<=s->bytes && count*4<=s->bytes-(word-base)) {
+            sgpu_graphics_command root={s->gpu_va+(uint32_t)(word-base),count*4};
+            return sgpu_pm4_validate(&gfx.policy,gfx.snapshots,gfx.snapshot_count,&root,1,ranges,nr);
+        }
+    }
+    return false;
+}
+static bool __attribute__((noinline)) gfx_publish(void *,const sgpu_graphics_command *c,uint32_t count,uint32_t seq) {return sgpu_graphics_hw_publish(c,count,seq);}
+static void __attribute__((noinline)) gfx_invalidate_fence(void *) {sgpu_graphics_hw_invalidate_fence();}
+static uint32_t __attribute__((noinline)) gfx_fence(void *) {return sgpu_graphics_hw_fence();}
+static bool __attribute__((noinline)) gfx_faulted(void *) {return sgpu_graphics_hw_faulted();}
+static bool __attribute__((noinline)) gfx_idle(void *) {return sgpu_graphics_hw_idle();}
+static uint64_t __attribute__((noinline)) gfx_now(void *) {uint64_t ns;absolutetime_to_nanoseconds(mach_absolute_time(),&ns);return ns/1000;}
+static void __attribute__((noinline)) gfx_wait(void *,uint32_t us) {IOSleep((us+999)/1000);}
+
+} /* closed C callback namespace, easier to audit in the linked kernel */
+
+class SantoniGraphics:public IOService {
+    OSDeclareDefaultStructors(SantoniGraphics);
+public:bool start(IOService *) APPLE_KEXT_OVERRIDE;
+};
+class SantoniGraphicsClient:public IOUserClient {
+    OSDeclareDefaultStructors(SantoniGraphicsClient);
+    task_t fTask;
+    bool fClosed;
+public:
+    bool initWithTask(task_t,void *,UInt32) APPLE_KEXT_OVERRIDE;
+    void free() APPLE_KEXT_OVERRIDE;
+    IOReturn clientClose() APPLE_KEXT_OVERRIDE;
+    IOReturn clientMemoryForType(UInt32,IOOptionBits *,IOMemoryDescriptor **) APPLE_KEXT_OVERRIDE;
+    IOReturn externalMethod(uint32_t,IOExternalMethodArguments *,IOExternalMethodDispatch *,OSObject *,void *) APPLE_KEXT_OVERRIDE;
+};
+OSDefineMetaClassAndStructors(SantoniGraphics,IOService);
+OSDefineMetaClassAndStructors(SantoniGraphicsClient,IOUserClient);
+
+bool SantoniGraphics::start(IOService *provider)
+{
+    int enabled=0,mode=0,render=0,ui=0;
+    PE_parse_boot_argn("santonigpu_graphics",&enabled,sizeof(enabled));
+    if (enabled!=1) return false;
+    PE_parse_boot_argn("santonigpu",&mode,sizeof(mode));PE_parse_boot_argn("santonigpu_render",&render,sizeof(render));
+    PE_parse_boot_argn("santonigpu_ui",&ui,sizeof(ui));
+    if (mode!=3 || render!=1 || ui || !IOService::start(provider)) return false;
+    if (!gfx.lock) gfx.lock=IOLockAlloc();
+    if (!gfx.lock) return false;
+    setProperty(kIOUserClientClassKey,"SantoniGraphicsClient");registerService();
+    IOLog("SANTONI GPU: graphics transport registered; waits for owned VM; shaders not enabled yet\n");
+    return true;
+}
+bool SantoniGraphicsClient::initWithTask(task_t owner,void *security,UInt32 type)
+{
+    fTask=nullptr;fClosed=true;
+    if (!owner || type || clientHasPrivilege(security,kIOClientPrivilegeAdministrator)!=kIOReturnSuccess ||
+        !gfx.lock || !IOUserClient::initWithTask(owner,security,type)) return false;
+    IOLockLock(gfx.lock);bool ok=false;
+    if (!gfx.claimed && santoni_gpu_graphics_worker_ready() && sgpu_graphics_hw_ready()) {
+        gfx.claimed=true;gfx.owner=owner;task_reference(owner);
+        bool pools=gfx_pool_init(&gfx.user,GFX_PUBLIC_PAGES,true) && gfx_pool_init(&gfx.commands,GFX_PRIVATE_PAGES,false);
+        if (pools) for (uint32_t i=0;i<gfx.user.pages;i++) for (uint32_t j=0;j<gfx.commands.pages;j++)
+            if (gfx.user.pa[i]==gfx.commands.pa[j]) pools=false;
+        gfx.pools_ready=pools;
+        if (pools) {
+            sgpu_graphics_ops ops={};ops.fence_pa=sgpu_graphics_hw_fence_pa();
+            ops.ready=gfx_ready;ops.allocate=gfx_allocate;ops.release=gfx_release;ops.page_pa=gfx_page_pa;
+            ops.reserved_pa=gfx_reserved;ops.map=gfx_map;ops.unmap=gfx_unmap;ops.pte=gfx_pte;
+            ops.clean=gfx_clean;ops.invalidate=gfx_invalidate;ops.prepare_ibs=gfx_prepare;ops.validate_ib=gfx_validate;
+            ops.publish=gfx_publish;ops.invalidate_fence=gfx_invalidate_fence;ops.fence=gfx_fence;
+            ops.faulted=gfx_faulted;ops.idle=gfx_idle;ops.now_us=gfx_now;ops.wait_us=gfx_wait;
+            ok=sgpu_graphics_init(&gfx.core,(uint64_t)(uintptr_t)owner,&ops);
+        }
+    }
+    if (ok) {fTask=owner;fClosed=false;}
+    IOLockUnlock(gfx.lock);return ok;
+}
+IOReturn SantoniGraphicsClient::clientClose()
+{
+    if (!gfx.lock || fClosed) return kIOReturnSuccess;
+    IOLockLock(gfx.lock);
+    if (!fClosed) {sgpu_graphics_close(&gfx.core,(uint64_t)(uintptr_t)fTask);fClosed=true;}
+    IOLockUnlock(gfx.lock);return kIOReturnSuccess;
+}
+void SantoniGraphicsClient::free() {clientClose();IOUserClient::free();}
+IOReturn SantoniGraphicsClient::clientMemoryForType(UInt32 handle,IOOptionBits *options,IOMemoryDescriptor **out)
+{
+    if (!options || !out || fClosed || current_task()!=fTask || fTask!=gfx.owner) return kIOReturnNotPermitted;
+    IOLockLock(gfx.lock);IOReturn result=kIOReturnBadArgument;
+    if (fClosed) {IOLockUnlock(gfx.lock);return kIOReturnNotPermitted;}
+    sgpu_graphics_range info;
+    if (sgpu_graphics_info(&gfx.core,(uint64_t)(uintptr_t)fTask,handle,&info)) {
+        for (unsigned i=0;i<SGPU_GRAPHICS_BOS;i++) {
+            sgpu_graphics_bo *b=&gfx.core.bo[i];if (!b->live || b->handle!=handle || b->private_ib) continue;
+            gfx_lease *l=gfx_lease_for(&b->memory);
+            if (!l || l->pool!=&gfx.user) break;
+            IOMemoryDescriptor *memory=IOSubMemoryDescriptor::withSubRange(l->pool->memory,
+                (uint64_t)l->first*SGPU_PAGE,(uint64_t)l->pages*SGPU_PAGE,kIODirectionInOut);
+            if (memory) {*out=memory;*options=0;result=kIOReturnSuccess;}
+            break;
+        }
+    }
+    IOLockUnlock(gfx.lock);return result;
+}
+IOReturn SantoniGraphicsClient::externalMethod(uint32_t selector,IOExternalMethodArguments *a,
+    IOExternalMethodDispatch *,OSObject *,void *)
+{
+    if (!a || fClosed || current_task()!=fTask || fTask!=gfx.owner) return kIOReturnNotPermitted;
+    uint32_t in=selector==SG_GFX_NEW?2:(selector==SG_GFX_FREE || selector==SG_GFX_BO_INFO ||
+        selector==SG_GFX_WAIT || selector==SG_GFX_CPU_PREP)?1:0;
+    uint32_t out=selector==SG_GFX_INFO?10:selector==SG_GFX_NEW?4:selector==SG_GFX_BO_INFO?3:selector==SG_GFX_SUBMIT?1:0;
+    if (selector>SG_GFX_CLOSE || a->scalarInputCount!=in || a->scalarOutputCount!=out ||
+        (in && !a->scalarInput) || (out && !a->scalarOutput) || a->structureInputDescriptor ||
+        a->structureOutputSize || a->structureOutputDescriptor ||
+        (selector==SG_GFX_SUBMIT?(a->structureInputSize!=sizeof(sgpu_graphics_wire_submit) || !a->structureInput):a->structureInputSize!=0)) return kIOReturnBadArgument;
+    IOLockLock(gfx.lock);IOReturn result=kIOReturnBadArgument;uint64_t output[10]={};
+    if (fClosed) {IOLockUnlock(gfx.lock);return kIOReturnNotPermitted;}
+    uint64_t owner=(uint64_t)(uintptr_t)fTask;sgpu_graphics_range info;
+    uint64_t arg=in?a->scalarInput[0]:0;
+    switch (selector) {
+    case SG_GFX_INFO:
+        output[0]=SGPU_GRAPHICS_UAPI_VERSION;output[1]=SGPU_PAGE;output[2]=SGPU_CHIPID;output[3]=SGPU_GMEM_BYTES;
+        output[4]=SGPU_RENDER_VA;output[5]=SGPU_RENDER_MAX_PAGES*SGPU_PAGE;output[6]=SGPU_RENDER_BO_BYTES;
+        output[7]=SGPU_GRAPHICS_IB_BYTES;output[8]=gfx.core.retained_pages*SGPU_PAGE;
+        output[9]=0; /* No GLES capability until the vetted raster-state policy exists. */
+        result=kIOReturnSuccess;break;
+    case SG_GFX_NEW:
+        if (arg && arg<=SGPU_RENDER_BO_BYTES && a->scalarInput[1]<=UINT32_MAX) {
+            uint32_t handle=sgpu_graphics_new(&gfx.core,owner,(uint32_t)arg,(uint32_t)a->scalarInput[1]);
+            if (handle && sgpu_graphics_info(&gfx.core,owner,handle,&info)) {
+                output[0]=handle;output[1]=info.gpu_va;output[2]=info.bytes;output[3]=handle;result=kIOReturnSuccess;
+            } else result=kIOReturnNoMemory;
+        }break;
+    case SG_GFX_FREE:
+        if(arg && arg<=UINT32_MAX)result=sgpu_graphics_free(&gfx.core,owner,(uint32_t)arg)?kIOReturnSuccess:kIOReturnBusy;
+        break;
+    case SG_GFX_BO_INFO:
+        if(arg && arg<=UINT32_MAX && sgpu_graphics_info(&gfx.core,owner,(uint32_t)arg,&info)) {
+            output[0]=info.gpu_va;output[1]=info.bytes;output[2]=info.flags;result=kIOReturnSuccess;
+        }break;
+    case SG_GFX_SUBMIT: {
+        sgpu_graphics_wire_submit request;memcpy(&request,a->structureInput,sizeof(request));
+        bool valid=request.version==SGPU_GRAPHICS_UAPI_VERSION && !request.reserved && request.ibs &&
+            request.ibs<=SGPU_GRAPHICS_UAPI_IBS && request.handles && request.handles<=SGPU_GRAPHICS_UAPI_HANDLES;
+        for(unsigned i=request.ibs;i<SGPU_GRAPHICS_UAPI_IBS && valid;i++)
+            if(request.ib[i].handle || request.ib[i].offset || request.ib[i].bytes)valid=false;
+        for(unsigned i=request.handles;i<SGPU_GRAPHICS_UAPI_HANDLES && valid;i++)if(request.handle[i])valid=false;
+        if(valid) {
+            sgpu_graphics_ib ibs[SGPU_GRAPHICS_IBS];for(unsigned i=0;i<request.ibs;i++)
+                ibs[i]={request.ib[i].handle,request.ib[i].offset,request.ib[i].bytes};
+            uint32_t seq=sgpu_graphics_submit(&gfx.core,owner,ibs,request.ibs,request.handle,request.handles);
+            if(seq) {output[0]=seq;result=kIOReturnSuccess;}else result=kIOReturnNotReady;
+        }break;
+    }
+    case SG_GFX_WAIT:
+        if(arg && arg<=UINT32_MAX)result=sgpu_graphics_wait(&gfx.core,owner,(uint32_t)arg)?kIOReturnSuccess:kIOReturnTimeout;
+        break;
+    case SG_GFX_CPU_PREP:
+        if(arg && arg<=UINT32_MAX && sgpu_graphics_info(&gfx.core,owner,(uint32_t)arg,&info)) {
+            uint8_t *alias=nullptr;
+            bool idle=!gfx.core.active || sgpu_graphics_wait(&gfx.core,owner,gfx.core.active);
+            if(idle && sgpu_graphics_cpu(&gfx.core,owner,(uint32_t)arg,0,info.bytes,&alias))result=kIOReturnSuccess;
+        }break;
+    case SG_GFX_CLOSE:
+        sgpu_graphics_close(&gfx.core,owner);fClosed=true;result=kIOReturnSuccess;break;
+    }
+    if(result==kIOReturnSuccess && out)memcpy(a->scalarOutput,output,out*sizeof(output[0]));
+    IOLockUnlock(gfx.lock);return result;
+}
+#endif
