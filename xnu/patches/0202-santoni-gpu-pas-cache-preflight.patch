+struct sgpu_pas_cache_trial {
+    struct sgpu_pas_cached_span metadata, image;
+    uint32_t forward_error, cleanup_error;
+    bool attempted;
+};
+static struct sgpu_pas_cache_trial sgpu_cache_trial;
+
+static void __attribute__((noinline)) sgpu_pas_cache_trial_run(struct sgpu_pas_cache_trial *trial)
+{
+    if (!trial || trial->attempted) return;
+    trial->attempted = true;
+    if (trial->metadata.memory.va || trial->metadata.memory.pa || trial->metadata.memory.bytes ||
+        trial->metadata.memory.exposed || trial->metadata.converted_pages || trial->metadata.uncertain ||
+        trial->image.memory.va || trial->image.memory.pa || trial->image.memory.bytes ||
+        trial->image.memory.exposed || trial->image.converted_pages || trial->image.uncertain ||
+        trial->forward_error || trial->cleanup_error) {
+        if (!trial->forward_error) trial->forward_error = 6;
+        return; /* unknown prior ownership must never be freed */
+    }
+    if (!sgpu_pas_allocate(&trial->metadata.memory, 8192, SGPU_PAGE)) {
+        trial->forward_error = 1;
+    } else if (!sgpu_pas_allocate(&trial->image.memory, 8192, 0x100000)) {
+        trial->forward_error = 2;
+    } else if (!sgpu_pas_cached_prepare(&trial->metadata)) {
+        trial->forward_error = 3;
+    } else if (!sgpu_pas_cached_prepare(&trial->image)) {
+        trial->forward_error = 4;
+    } else {
+        struct sgpu_pas_cached_span *spans[2] = {&trial->metadata, &trial->image};
+        for (unsigned i = 0; i < 2; i++) {
+            for (uint32_t off = 0; off < spans[i]->memory.bytes; off += SGPU_PAGE) {
+                volatile uint8_t *owned = (volatile uint8_t *)(spans[i]->memory.va + off);
+                const volatile uint8_t *alias = (const volatile uint8_t *)(vm_offset_t)phystokv(spans[i]->memory.pa + off);
+                *owned = (uint8_t)(0xa0u + i + off / SGPU_PAGE);
+                __asm__ volatile("dsb sy" ::: "memory");
+                if (*alias != *owned) {
+                    if (!trial->forward_error) trial->forward_error = 5;
+                    trial->metadata.uncertain = trial->image.uncertain = true;
+                    goto cleanup;
+                }
+            }
+        }
+    }
+cleanup:
+    /* Each cleanup is independent; the first failure is immutable. No exposed
+     * or uncertain span is touched or freed, even when the other release works. */
+    if (!sgpu_pas_cached_release(&trial->image)) trial->cleanup_error = 1;
+    if (!sgpu_pas_cached_release(&trial->metadata) && !trial->cleanup_error) trial->cleanup_error = 2;
+}
