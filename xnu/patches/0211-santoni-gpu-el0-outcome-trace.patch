+/* Observation is available only after successful exec preparation in the exact
+ * boot-only role, and only on this immutable executable backing. */
+bool santoni_gpu_user_launch_trace_ready(uint64_t kva, uint32_t file_bytes,
+    uint32_t span_bytes)
+{
+    uint32_t enabled=0,mode=0;
+    (void)PE_parse_boot_argn("santonigpu_user_exec",&enabled,sizeof(enabled));
+    if (!enabled) return false;
+    (void)PE_parse_boot_argn("santonigpu",&mode,sizeof(mode));
+    return launch_options(mode)==SG_LAUNCH_ON &&
+        __atomic_load_n(&launch.stage,__ATOMIC_ACQUIRE)==LAUNCH_READY &&
+        launch.mounted && kva && kva==launch.mount.kva &&
+        file_bytes==launch.mount.file_bytes && span_bytes==launch.mount.span_bytes;
+}
+
 const char *santoni_gpu_user_launch_path(void)
 {
     uint32_t enabled=0,mode=0;
