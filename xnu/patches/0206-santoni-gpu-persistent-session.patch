+    session_core.working=session_core.startup;
+    session_core.working.error=SG_OK;
+    session_core.start_us=session_core.last_us=session_core.ops.now_us(session_core.ops.ctx);
+    if (session_core.arena.completed>=34 || session_core.wptr>=SGPU_PAGE/4-SG_G3_BATCH_WORDS)
+        return session_fail(SG_BAD_MODE,SG_SESSION_READINESS);
+    session_core.prepared=session_readiness();
+    return session_core.prepared;
+}
+
+void sgpu_session_failure_result(struct sgpu_session_result *out)
+{ if (out) *out=session_core.result; }
+
+void sgpu_session_stop(void)
+{
+    session_core.ready=session_core.prepared=false;
+    session_core.stopped=true; /* deliberate retention, not an engine reset/fault */
+    for (unsigned i=0;i<SG_G3_BOS;i++)
+        if (session_core.arena.bo[i].handle) session_core.arena.bo[i].quarantine=true;
+}
+
+bool sgpu_session_execute(const uint32_t value[4], struct sgpu_session_result *out)
+{
+    if (!out || !value || !session_core.active || !session_core.prepared || session_core.stopped) return false;
+    session_core.prepared=false;
+    struct probe *p=&session_core.p;
+    struct sgpu_g3 *g=&session_core.arena;
+    uint64_t now;
+    if (!session_time(SG_SESSION_CONTENTS,&now)) goto failed;
+    for (unsigned i=0;i<4;i++) session_core.values[i]=value[i];
+    uint32_t *ib=(uint32_t *)(void *)(p->memory.va+g->bo[0].physical[0]*SGPU_PAGE);
+    uint8_t *data=p->memory.va+g->bo[1].physical[0]*SGPU_PAGE;
+    uint8_t *fence=p->memory.va+g->bo[2].physical[0]*SGPU_PAGE;
+    for (unsigned i=0;i<SGPU_PAGE;i++) data[i]=0xa5;
+    *(uint32_t *)(void *)fence=0;
+    for (unsigned i=0;i<4;i++) {
+        ib[i*4]=sgpu_packet7(0x3d,3); ib[i*4+1]=sgpu_g3_va(&g->bo[1])+i*4;
+        ib[i*4+2]=0; ib[i*4+3]=session_core.values[i];
+    }
+    ib[16]=sgpu_packet7(0x26,0);
+    p->ops->clean(p->ops->ctx,ib,SGPU_PAGE);
+    if (!session_time(SG_SESSION_CONTENTS,&now)) goto failed;
+    p->ops->clean(p->ops->ctx,data,SGPU_PAGE);
+    if (!session_time(SG_SESSION_CONTENTS,&now)) goto failed;
+    p->ops->clean(p->ops->ctx,fence,SGPU_PAGE);
+    if (!session_time(SG_SESSION_CONTENTS,&now)) goto failed;
+    uint32_t batch[SG_G3_BATCH_WORDS];
+    if (!sgpu_g3_begin(g,1,g->bo[0].handle,g->bo[1].handle,g->bo[2].handle,17,batch)) {
+        session_fail(SG_BAD_MODE,SG_SESSION_PUBLISH); goto failed;
+    }
+    uint32_t target=session_core.wptr+SG_G3_BATCH_WORDS;
+    session_core.result.sequence=g->busy; session_core.result.wptr=target;
+    uint32_t *ring=(uint32_t *)(void *)(p->memory.va+3*SGPU_PAGE);
+    for (unsigned i=0;i<SG_G3_BATCH_WORDS;i++) ring[session_core.wptr+i]=batch[i];
+    p->ops->clean(p->ops->ctx,ring,SGPU_PAGE);
+    if (!session_time(SG_SESSION_PUBLISH,&now)) goto failed;
+    session_core.result.publish_attempted=true;
+    if (!checked_write32(p,SG_GPU,SG_RB_WPTR,~0u,target)) {
+        session_fail(SG_FAULT,SG_SESSION_PUBLISH); goto failed;
+    }
+    if (!session_poll(SG_GPU,SG_RB_RPTR,~0u,target,POLL_US,SG_SESSION_RPTR) ||
+        !session_poll(SG_GPU,SG_STATUS,SG_BUSY_MASK,0,POLL_US,SG_SESSION_IDLE)) goto failed;
+    uint64_t begin;
+    if (!session_time(SG_SESSION_FENCE,&begin)) goto failed;
+    uint32_t observed=0;
+    for (unsigned i=0;i<=POLL_US/100;i++) {
+        if (!session_time(SG_SESSION_FENCE,&now)) goto failed;
+        p->ops->invalidate(p->ops->ctx,fence,64);
+        observed=*(volatile uint32_t *)(void *)fence;
+        if (!session_time(SG_SESSION_FENCE,&now)) goto failed;
+        if (now-begin>POLL_US) { session_fail(SG_COMMAND_TIMEOUT,SG_SESSION_FENCE); goto failed; }
+        if (observed==g->busy) break;
+        if (observed>g->busy) { session_fail(SG_FAULT,SG_SESSION_FENCE); goto failed; }
+        if (now-begin>=POLL_US || i==POLL_US/100) break;
+        uint64_t left=SGPU_SESSION_BUDGET_US-(now-session_core.start_us);
+        if (left>POLL_US-(now-begin)) left=POLL_US-(now-begin);
+        wait_us(p,left<100 ? (uint32_t)left : 100);
+    }
+    if (observed!=g->busy) { session_fail(SG_COMMAND_TIMEOUT,SG_SESSION_FENCE); goto failed; }
+    p->ops->invalidate(p->ops->ctx,data,SGPU_PAGE);
+    if (!session_time(SG_SESSION_COMPARE,&now)) goto failed;
+    for (unsigned i=0;i<4;i++) if (((volatile uint32_t *)(void *)data)[i]!=session_core.values[i]) {
+        session_fail(SG_MARKER_MISMATCH,SG_SESSION_COMPARE); goto failed;
+    }
+    for (unsigned i=16;i<SGPU_PAGE;i++) if (((volatile uint8_t *)data)[i]!=0xa5) {
+        session_fail(SG_MARKER_MISMATCH,SG_SESSION_COMPARE); goto failed;
+    }
+    if (!session_time(SG_SESSION_FINAL_FAULTS,&now)) goto failed;
+    faults(p);
+    if (has_fault(p->report)) { session_fail(SG_FAULT,SG_SESSION_FINAL_FAULTS); goto failed; }
+    if (!session_time(SG_SESSION_FINAL_FAULTS,&now)) goto failed;
+    if (!sgpu_g3_complete(g,1,g->bo[2].handle,observed)) {
+        session_fail(SG_FAULT,SG_SESSION_FINAL_FAULTS); goto failed;
+    }
+    session_core.wptr=target; session_core.active=false;
+    session_core.result.state=SG_REQUEST_COMPLETE; session_core.result.writes=4;
+    *out=session_core.result;
+    return true;
+failed:
+    *out=session_core.result;
+    return false;
+}
 #endif
