 }
 
 static bool has_fault(const struct sgpu_report *r)
@@ -610,6 +614,7 @@
     write32(p, SG_GPU, SG_PFP_BASE, SGPU_PFP_VA);
     write32(p, SG_GPU, SG_PFP_BASE + 4, 0);
     p->dma_exposed = true; /* ME may fetch immediately; never free after this */
+    p->commands_started = true;
     if (!checked_write32(p, SG_GPU, SG_ME_CNTL, SG_ME_HALT, 0)) return false;
     if (!consume(p, 9)) return false;
     *wptr = 9;
@@ -753,13 +758,23 @@
     report->stage = SG_TRANSLATION;
     trace(&p, "before powered SMMU read/setup", 0x01c40000, 0x10000, 0);
     if (!ops->map(ops->ctx, SG_SMMU, 0x01c40000, 0x10000)) { report->error = SG_NO_MAP; goto done; }
+    /* The logging pause and IRQ-mask handoff are not an ownership lock. */
+    if (!poll(&p, SG_GPU, SG_STATUS, SG_BUSY_MASK, 0, 10000)) {
+        report->error = SG_BUSY; goto done;
+    }
     if (!checked_write32(&p, SG_GPU, SG_INT_MASK, ~0u, 0)) {
         report->error = SG_FAULT; goto done;
     }
-    p.gpu_owned = true; /* only an idle engine with verified IRQ masking is reset */
+    if (!poll(&p, SG_GPU, SG_STATUS, SG_BUSY_MASK, 0, 10000)) {
+        report->error = SG_BUSY; goto done;
+    }
     if (!checked_write32(&p, SG_GPU, SG_ME_CNTL, SG_ME_HALT, SG_ME_HALT)) {
         report->error = SG_FAULT; goto done;
     }
+    if (!poll(&p, SG_GPU, SG_STATUS, SG_BUSY_MASK, 0, 10000)) {
+        report->error = SG_BUSY; goto done;
+    }
+    p.gpu_owned = true; /* reset only after the immediate idle/halt handoff checks */
     write32(&p, SG_GPU, SG_RESET, 1);
     (void)read32(&p, SG_GPU, SG_RESET);
     wait_us(&p, 2);
@@ -810,7 +825,7 @@
         stopped = checked_write32(&p, SG_GPU, SG_ME_CNTL, SG_ME_HALT, SG_ME_HALT) &&
