+static bool __attribute__((noinline)) sgpu_graphics_hw_fail(uint32_t error)
+{
+    if (!sgpu_graphics_hw.error) sgpu_graphics_hw.error=error;
+    sgpu_graphics_hw.failed=true;
+    return false; /* no rollback, unmap or release after an uncertain handoff */
+}
+bool __attribute__((noinline)) sgpu_graphics_hw_ready(void)
+{return sgpu_graphics_hw.initialized && !sgpu_graphics_hw.failed;}
+bool __attribute__((noinline)) sgpu_graphics_hw_reserved(uint64_t pa)
+{
+    for (unsigned i=0;i<SGPU_POOL_PAGES;i++)if(pa==sgpu_graphics_hw.old_pa[i])return true;
+    for (unsigned i=0;i<SGPU_RENDER_TABLE_PAGES;i++)if(pa==sgpu_graphics_hw.owned.table_pa[i])return true;
+    for (unsigned i=0;i<SGPU_RENDER_LIVE_PAGES;i++)if(pa==sgpu_graphics_hw.owned_pa[i])return true;
+    return false;
+}
+static bool __attribute__((noinline)) sgpu_graphics_hw_tables(void)
+{
