diff --git a/bsd/dev/santoni_gpu.c b/bsd/dev/santoni_gpu.c
new file mode 100644
--- /dev/null
+++ b/bsd/dev/santoni_gpu.c
@@ -0,0 +1,205 @@
+/*
+ * Santoni kernel adapter for the guarded, kernel-only A505 diagnostic.
+ * Firmware is carried in the reserved Apple device tree by the local packager,
+ * not committed to git, fetched by CI, or installed into the iOS filesystem.
+ * GPU flag defaults OFF. A separate worker never delays IOFindBSDRoot or HID.
+ */
+#if defined(ARM64_BOARD_CONFIG_SANTONI)
+#include <sys/param.h>
+#include <sys/systm.h>
+#include <kern/clock.h>
+#include <kern/thread.h>
+#include <kern/sched_prim.h>
+#include <mach/mach_time.h>
+#include <pexpert/pexpert.h>
+#include <pexpert/device_tree.h>
+#include <vm/vm_kern.h>
+#include <vm/vm_map.h>
+#include <vm/pmap.h>
+#include "santoni_gpu_core.h"
+
+extern vm_offset_t ml_io_map(vm_offset_t, vm_size_t);
+extern void CleanPoC_DcacheRegion_Force(vm_offset_t, size_t);
+extern ppnum_t pmap_find_phys(pmap_t, addr64_t);
+void santoni_gpu_start(void);
+
+_Static_assert(PAGE_SHIFT == 12, "A505 diagnostic requires Santoni 4K pages");
+static struct {
+    vm_offset_t maps[SG_BLOCKS], pool;
+    uint32_t sizes[SG_BLOCKS], attempted, mode;
+    int wait_channel;
+} sg;
+
+static bool io_map(void *ctx, enum sgpu_block block, uint32_t pa, uint32_t bytes)
+{
+    (void)ctx;
+    static const uint32_t addresses[SG_BLOCKS] = {
+        0x01859000,0x0185b000,0x01845000,0x01812000,0x01c00000,0x01c40000
+    };
+    static const uint32_t lengths[SG_BLOCKS] = {0x1000,0x1000,0x1000,0x1000,0x40000,0x10000};
+    if ((unsigned)block >= SG_BLOCKS || pa != addresses[block] || bytes != lengths[block])
+        return false;
+    if (!sg.maps[block]) sg.maps[block] = ml_io_map(pa, bytes);
+    sg.sizes[block] = bytes;
+    return sg.maps[block] != 0;
+}
+
+static vm_offset_t address(enum sgpu_block block, uint32_t off, uint32_t width)
+{
+    if ((unsigned)block >= SG_BLOCKS || !sg.maps[block] ||
+        (off & (width - 1)) || width > sg.sizes[block] || off > sg.sizes[block] - width)
+        return 0;
+    return sg.maps[block] + off;
+}
+
+static uint32_t __attribute__((noinline)) io_read32(void *ctx, enum sgpu_block block, uint32_t off)
+{
+    (void)ctx;
+    vm_offset_t addr = address(block, off, 4);
+    if (!addr) return ~0u;
+    uint32_t value;
+    __asm__ volatile("ldr %w0, [%1]; dmb sy" : "=r"(value) : "r"(addr) : "memory");
+    return value;
+}
+
+static uint64_t __attribute__((noinline)) io_read64(void *ctx, enum sgpu_block block, uint32_t off)
+{
+    (void)ctx;
+    vm_offset_t addr = address(block, off, 8);
+    if (!addr) return ~0ull;
+    uint64_t value;
+    __asm__ volatile("ldr %0, [%1]; dmb sy" : "=r"(value) : "r"(addr) : "memory");
+    return value;
+}
+
+/* Values use real argument registers: do not let HYP emulation see str wzr/xzr. */
+static void __attribute__((noinline)) sgpu_io_write32(void *ctx, enum sgpu_block block, uint32_t off, uint32_t value)
+{
+    (void)ctx;
+    vm_offset_t addr = address(block, off, 4);
+    if (!addr || (block == SG_GPU && off >= 0x3c000u)) return; /* SECVID never written */
+    __asm__ volatile("dmb sy; str %w0, [%1]; dsb sy" : : "r"(value), "r"(addr) : "memory");
+}
+
+static void __attribute__((noinline)) sgpu_io_write64(void *ctx, enum sgpu_block block, uint32_t off, uint64_t value)
+{
+    (void)ctx;
+    vm_offset_t addr = address(block, off, 8);
+    if (!addr || (block == SG_GPU && off >= 0x3c000u)) return;
+    __asm__ volatile("dmb sy; str %0, [%1]; dsb sy" : : "r"(value), "r"(addr) : "memory");
+}
+
+static uint64_t now_us(void *ctx)
+{
+    (void)ctx;
+    uint64_t ns;
+    absolutetime_to_nanoseconds(mach_absolute_time(), &ns);
+    return ns / 1000u;
+}
+
+static void wait_us(void *ctx, uint32_t us)
+{
+    (void)ctx;
+    if (us < 50) {
+        uint64_t start, now, frequency;
+        __asm__ volatile("mrs %0, cntfrq_el0" : "=r"(frequency));
+        __asm__ volatile("mrs %0, cntvct_el0" : "=r"(start));
+        uint64_t ticks = ((uint64_t)us * frequency + 999999u) / 1000000u;
+        do {
+            __asm__ volatile("yield; mrs %0, cntvct_el0" : "=r"(now) : : "memory");
+        } while (now - start < ticks);
+    } else {
+        uint64_t deadline;
+        clock_interval_to_deadline(us, NSEC_PER_USEC, &deadline);
+        (void)assert_wait_deadline(&sg.wait_channel, THREAD_UNINT, deadline);
+        thread_block(THREAD_CONTINUE_NULL);
+    }
+}
+
+static bool allocate(void *ctx, struct sgpu_memory *m)
+{
+    (void)ctx;
+    if (sg.pool || kmem_alloc(kernel_map, &sg.pool, SGPU_POOL_BYTES,
+        KMA_DATA | KMA_ZERO, VM_KERN_MEMORY_IOKIT) != KERN_SUCCESS) return false;
+    m->va = (uint8_t *)sg.pool;
+    for (unsigned i = 0; i < SGPU_POOL_PAGES; i++)
+        m->pa[i] = (uint64_t)pmap_find_phys(kernel_pmap, sg.pool + i * SGPU_PAGE) << 12;
+    return true;
+}
+
+static void release(void *ctx, struct sgpu_memory *m)
+{
+    (void)ctx;
+    if (m->va && (vm_offset_t)m->va == sg.pool) {
+        kmem_free(kernel_map, sg.pool, SGPU_POOL_BYTES);
+        sg.pool = 0;
+        m->va = NULL;
+    }
+}
+
+static void clean(void *ctx, const void *va, uint32_t size)
+{
+    (void)ctx;
+    CleanPoC_DcacheRegion_Force((vm_offset_t)va, size);
+}
+
+static void __attribute__((noinline)) sgpu_cache_invalidate(void *ctx, const void *va, uint32_t size)
+{
+    (void)ctx;
+    /* Always invalidate, even if XNU assumes coherent device IO. These lines
+     * were cleaned BEFORE DMA and were never subsequently written by the CPU. */
+    uint64_t ctr;
+    __asm__ volatile("mrs %0, ctr_el0; dsb sy" : "=r"(ctr) : : "memory");
+    uintptr_t line = 4ul << ((ctr >> 16) & 15u);
+    uintptr_t start = (uintptr_t)va & ~(line - 1);
+    uintptr_t end = (uintptr_t)va + size;
+    for (uintptr_t addr = start; addr < end; addr += line)
+        __asm__ volatile("dc ivac, %0" : : "r"(addr) : "memory");
+    __asm__ volatile("dsb sy" : : : "memory");
+}
+
+static void trace(void *ctx, const char *message, uint32_t a, uint32_t b, uint32_t c)
+{
+    (void)ctx;
+    printf("SANTONI GPU: %s [%08x %08x %08x]\n", message, a, b, c);
+    /* The existing log ring flushes asynchronously. Bracket new risky stages
+     * so its last completed stage survives a fabric hang/firmware reset. */
+    if (strncmp(message, "before ", 7) == 0) wait_us(NULL, 11000000u);
+}
+
+static void sgpu_kernel_thread(void *arg __unused, wait_result_t result __unused)
+{
+    wait_us(NULL, 40000000u); /* let storage and physical inputs start normally */
+    const void *firmware = NULL;
+    unsigned int firmware_size = 0;
+    DTEntry chosen;
+    if (SecureDTLookupEntry(NULL, "/chosen", &chosen) == kSuccess)
+        (void)SecureDTGetProperty(chosen, "santoni-gpu-firmware", &firmware, &firmware_size);
+    struct sgpu_ops ops = {
+        .map=io_map, .read32=io_read32, .read64=io_read64,
+        .write32=sgpu_io_write32, .write64=sgpu_io_write64, .now_us=now_us, .wait_us=wait_us,
+        .allocate=allocate, .release=release, .clean=clean, .invalidate=sgpu_cache_invalidate,
+        .trace=trace
+    };
+    struct sgpu_report report;
+    printf("SANTONI GPU: start mode=%u; A505 diagnostic only, XO 19.2MHz, kernel 2D test; no UI replacement\n", sg.mode);
+    bool passed = sgpu_probe(&ops, sg.mode, firmware, firmware_size, &report);
+    printf("SANTONI GPU: RESULT pass=%u stage=%u error=%u markers=%u pixels=%u trust=%08x restored=%u retained=%u\n",
+        passed ? 1u : 0u, report.stage, report.error, report.markers, report.pixels,
+        report.trust, report.restored ? 1u : 0u, report.memory_retained ? SGPU_POOL_BYTES : 0u);
+    thread_terminate_self();
+}
+
+void santoni_gpu_start(void)
+{
+    uint32_t mode = 0;
+    (void)PE_parse_boot_argn("santonigpu", &mode, sizeof(mode));
+    if (mode == 0 || mode > 3) return; /* default path has zero GPU side effects */
+    if (__atomic_exchange_n(&sg.attempted, 1, __ATOMIC_ACQ_REL)) return;
+    sg.mode = mode;
+    thread_t worker;
+    if (kernel_thread_start(sgpu_kernel_thread, NULL, &worker) == KERN_SUCCESS)
+        thread_deallocate(worker);
+    else printf("SANTONI GPU: worker creation failed; CPU UI retained\n");
+}
+#endif
diff --git a/bsd/dev/santoni_gpu_core.c b/bsd/dev/santoni_gpu_core.c
new file mode 100644
--- /dev/null
+++ b/bsd/dev/santoni_gpu_core.c
@@ -0,0 +1,661 @@
+/*
+ * Opt-in Santoni Adreno 505 bring-up. Hardware facts: MSM4.9 msm8937-gpu.dtsi,
+ * msm8937.dtsi (CX GDSC override), clock-gcc-8952.c, adreno_a5xx.c,
+ * a5xx_reg.h, arm-smmu.c and io-pgtable-arm.c. No Pixel/SC7280 addresses.
+ *
+ * This is a diagnostic, NOT an IOAccelerator or a user submission API.
+ * mode 1: bounded XO-rate power/readback; mode 2: owned CP memory markers;
+ * mode 3: additionally copy a 16x16 RGBA image with the A5xx 2D primitive,
+ * ONLY if the live GPU is already non-secure. Never write TRUST_CNTL or load
+ * a substitute ZAP. No RPM/PMIC/PLL, GIC, input, storage or panel programming.
+ *
+ * Only 4K pages belonging to one <=96K wired allocation are GPU-mapped.
+ * Firmware, ring and source mappings are read-only, destinations read/write;
+ * holes remain unmapped. A once-only caller bounds retained DMA memory.
+ * Once DMA has been exposed the pool is conservatively kept until reboot,
+ * including on success: an unproven reset never hands live pages to the VM.
+ *
+ * The portable operations boundary makes the ACTUAL state machine executable
+ * under a host MMIO/cache model, without replacing its algorithms.
+ */
+#if defined(ARM64_BOARD_CONFIG_SANTONI)
+#include "santoni_gpu_core.h"
+
+#define COUNT(a) ((uint32_t)(sizeof(a) / sizeof((a)[0])))
+#define BIT(n) (1u << (n))
+#define POLL_US 200000u
+#define PTE_FLAGS (3ull | (1ull << 2) | (2ull << 8) | (1ull << 10) | \
+    (1ull << 11) | (3ull << 53))
+#define PTE_RO (PTE_FLAGS | (3ull << 6))
+#define PTE_RW (PTE_FLAGS | (1ull << 6))
+#define CC_CMD 0u
+#define CC_CFG 4u
+#define CC_GX 0x1cu
+#define CC_CX 0x44u
+#define CC_CFG_MASK 0x371fu
+#define CC_VOTE 0xcu
+#define CC_VOTE_MASK (BIT(1) | BIT(2) | BIT(3))
+
+struct saved_reg { enum sgpu_block block; uint32_t off, mask, value; };
+struct probe {
+    const struct sgpu_ops *ops;
+    struct sgpu_report *report;
+    struct sgpu_memory memory;
+    struct saved_reg saved[32];
+    uint32_t saved_count;
+    bool gpu_live, smmu_live, dma_exposed;
+};
+
+static uint32_t little32(const uint8_t *p)
+{
+    return (uint32_t)p[0] | ((uint32_t)p[1] << 8) |
+        ((uint32_t)p[2] << 16) | ((uint32_t)p[3] << 24);
+}
+
+uint32_t sgpu_crc32(const uint8_t *p, size_t length)
+{
+    uint32_t crc = ~0u;
+    for (size_t i = 0; i < length; i++) {
+        crc ^= p[i];
+        for (unsigned bit = 0; bit < 8; bit++)
+            crc = (crc >> 1) ^ (0xedb88320u & (0u - (crc & 1u)));
+    }
+    return ~crc;
+}
+
+static uint32_t version(const uint8_t *p)
+{
+    uint32_t v = little32(p + 4);
+    return (v & 15u) == 10u ? (v & ~0xfffu) | ((little32(p + 12) >> 12) & 0xfffu) : v;
+}
+
+bool sgpu_firmware_validate(const uint8_t *p, size_t length, struct sgpu_firmware *out)
+{
+    static const uint8_t magic[8] = {'S', 'G', 'P', 'U', 'A', '5', '0', '5'};
+    if (!p || !out || length < SGPU_FW_HEADER) return false;
+    for (unsigned i = 0; i < 8; i++) if (p[i] != magic[i]) return false;
+    if (little32(p + 8) != 1 || little32(p + 12) != SGPU_CHIPID) return false;
+    uint32_t pm4 = little32(p + 16), pfp = little32(p + 20);
+    if (pm4 < 16 || pfp < 16 || pm4 > SGPU_FW_MAX || pfp > SGPU_FW_MAX ||
+        (pm4 & 3u) || (pfp & 3u) || (uint64_t)pm4 + pfp + SGPU_FW_HEADER != length)
+        return false;
+    const uint8_t *a = p + SGPU_FW_HEADER, *b = a + pm4;
+    if (little32(a) != 0 || little32(b) != 0 ||
+        sgpu_crc32(a, pm4) != little32(p + 24) ||
+        sgpu_crc32(b, pfp) != little32(p + 28)) return false;
+    uint32_t av = version(a), bv = version(b);
+    if (!av || !bv || av == ~0u || bv == ~0u) return false;
+    *out = (struct sgpu_firmware){a + 4, b + 4, pm4 - 4, pfp - 4, av, bv};
+    return true; /* CRC detects corruption, NOT authenticity or TZ acceptance. */
+}
+
+uint32_t sgpu_packet7(uint32_t op, uint32_t n)
+{
+    if (op > 0x7fu || n > 0x3fffu) return 0;
+    uint32_t np = 1, op_parity = 1;
+    for (uint32_t v = n; v; v >>= 1) np ^= v & 1u;
+    for (uint32_t v = op; v; v >>= 1) op_parity ^= v & 1u;
+    return 0x70000000u | n | (np << 15) | (op << 16) | (op_parity << 23);
+}
+
+static uint32_t packet4(uint32_t reg, uint32_t n)
+{
+    uint32_t p = 1, np = 1;
+    for (uint32_t v = reg; v; v >>= 1) p ^= v & 1u;
+    for (uint32_t v = n; v; v >>= 1) np ^= v & 1u;
+    return 0x40000000u | (reg << 8) | (p << 27) | n | (np << 7);
+}
+
+bool sgpu_memory_validate(const struct sgpu_memory *m)
+{
+    if (!m || !m->va || ((uintptr_t)m->va & (SGPU_PAGE - 1))) return false;
+    for (unsigned i = 0; i < SGPU_POOL_PAGES; i++) {
+        if ((m->pa[i] & (SGPU_PAGE - 1)) || m->pa[i] < SGPU_DMA_MIN ||
+            m->pa[i] >= SGPU_DMA_END) return false;
+        for (unsigned j = 0; j < i; j++) if (m->pa[i] == m->pa[j]) return false;
+    }
+    return true;
+}
+
+static bool map_pages(struct sgpu_memory *m, uint32_t va, uint32_t first,
+    uint32_t pages, bool writable)
+{
+    if ((va & (SGPU_PAGE - 1)) || !pages || first >= SGPU_POOL_PAGES ||
+        pages > SGPU_POOL_PAGES - first || va < SGPU_VA_BASE ||
+        (uint64_t)va + pages * SGPU_PAGE > SGPU_VA_BASE + 0x200000u) return false;
+    uint64_t *l3 = (uint64_t *)(void *)(m->va + 2 * SGPU_PAGE);
+    unsigned slot = (va / SGPU_PAGE) & 511u;
+    for (unsigned i = 0; i < pages; i++) if (l3[slot + i]) return false;
+    for (unsigned i = 0; i < pages; i++)
+        l3[slot + i] = m->pa[first + i] | (writable ? PTE_RW : PTE_RO);
+    return true;
+}
+
+bool sgpu_tables_build(struct sgpu_memory *m, const struct sgpu_firmware *fw)
+{
+    if (!fw || !sgpu_memory_validate(m) || !fw->pm4 || !fw->pfp ||
+        !fw->pm4_bytes || !fw->pfp_bytes || ((fw->pm4_bytes | fw->pfp_bytes) & 3u) || fw->pm4_bytes > SGPU_FW_MAX - 4 ||
+        fw->pfp_bytes > SGPU_FW_MAX - 4) return false;
+    uint32_t ap = (fw->pm4_bytes + SGPU_PAGE - 1) / SGPU_PAGE;
+    uint32_t bp = (fw->pfp_bytes + SGPU_PAGE - 1) / SGPU_PAGE;
+    if (7u + ap + bp > SGPU_POOL_PAGES) return false;
+    for (unsigned i = 0; i < SGPU_POOL_BYTES; i++) m->va[i] = 0;
+    uint64_t *l1 = (uint64_t *)(void *)m->va;
+    uint64_t *l2 = (uint64_t *)(void *)(m->va + SGPU_PAGE);
+    l1[0] = m->pa[1] | 3;
+    l2[SGPU_VA_BASE >> 21] = m->pa[2] | 3;
+    if (!map_pages(m, SGPU_RING_VA, 3, 1, false) ||
+        !map_pages(m, SGPU_MARKER_VA, 4, 1, true) ||
+        !map_pages(m, SGPU_SOURCE_VA, 5, 1, false) ||
+        !map_pages(m, SGPU_DEST_VA, 6, 1, true) ||
+        !map_pages(m, SGPU_PM4_VA, 7, ap, false) ||
+        !map_pages(m, SGPU_PFP_VA, 7 + ap, bp, false)) return false;
+    for (unsigned i = 0; i < fw->pm4_bytes; i++) m->va[7 * SGPU_PAGE + i] = fw->pm4[i];
+    for (unsigned i = 0; i < fw->pfp_bytes; i++) m->va[(7 + ap) * SGPU_PAGE + i] = fw->pfp[i];
+    return true;
+}
+
+static uint32_t read32(struct probe *p, enum sgpu_block b, uint32_t off)
+{ return p->ops->read32(p->ops->ctx, b, off); }
+static void write32(struct probe *p, enum sgpu_block b, uint32_t off, uint32_t v)
+{ p->ops->write32(p->ops->ctx, b, off, v); }
+static void write64(struct probe *p, enum sgpu_block b, uint32_t off, uint64_t v)
+{ p->ops->write64(p->ops->ctx, b, off, v); }
+static void wait_us(struct probe *p, uint32_t us)
+{ p->ops->wait_us(p->ops->ctx, us); }
+static void trace(struct probe *p, const char *s, uint32_t a, uint32_t b, uint32_t c)
+{ p->ops->trace(p->ops->ctx, s, a, b, c); }
+
+static bool poll(struct probe *p, enum sgpu_block b, uint32_t off,
+    uint32_t mask, uint32_t want, uint32_t us)
+{
+    if (us > POLL_US) return false;
+    uint64_t start = p->ops->now_us(p->ops->ctx);
+    for (unsigned i = 0; i <= us / 100; i++) {
+        if ((read32(p, b, off) & mask) == want) return true;
+        if (p->ops->now_us(p->ops->ctx) - start >= us) break;
+        if (i != us / 100) wait_us(p, 100);
+    }
+    trace(p, "poll timeout", (uint32_t)b, off, read32(p, b, off));
+    return false;
+}
+
+static bool change(struct probe *p, enum sgpu_block b, uint32_t off,
+    uint32_t mask, uint32_t value)
+{
+    uint32_t old = read32(p, b, off);
+    unsigned i;
+    for (i = 0; i < p->saved_count; i++)
+        if (p->saved[i].block == b && p->saved[i].off == off) break;
+    if (i == p->saved_count) {
+        if (i == COUNT(p->saved)) return false;
+        p->saved[i] = (struct saved_reg){b, off, mask, old};
+        p->saved_count++;
+    } else p->saved[i].mask |= mask;
+    write32(p, b, off, (old & ~mask) | (value & mask));
+    return (read32(p, b, off) & mask) == (value & mask);
+}
+
+static bool update_rcg(struct probe *p)
+{
+    write32(p, SG_CC, CC_CMD, read32(p, SG_CC, CC_CMD) | 1u);
+    return poll(p, SG_CC, CC_CMD, 1, 0, 10000);
+}
+
+static bool power(struct probe *p)
+{
+    static const uint32_t branches[] = {0x20, 0x28, 0x30, 0x34, 0x40, 0x4c};
+    uint32_t cx = read32(p, SG_CC, CC_CX), gx = read32(p, SG_CC, CC_GX);
+    trace(p, "GCC inherited CX/GX/CFG", cx, gx, read32(p, SG_CC, CC_CFG));
+    if ((cx | gx) & (BIT(1) | BIT(2)) || (read32(p, SG_CC, CC_CMD) & 1u))
+        return false; /* do not seize a hardware-controlled/overridden domain */
+    /* Keep the root enabled through GDSC transitions. XO / 1, no PLL/voltage writes. */
+    if (!change(p, SG_CC, CC_CMD, 2, 2) ||
+        !poll(p, SG_CC, CC_CMD, BIT(31), 0, 10000) ||
+        !change(p, SG_CC, CC_CFG, CC_CFG_MASK, 1) || !update_rcg(p)) return false;
+    if (!change(p, SG_MISC, 0xc, 1, 0)) return false;
+    const uint32_t waits = 0x00fff000u;
+    if (!change(p, SG_CC, CC_CX, waits | 1u, 0x00282000u)) return false;
+    wait_us(p, 2);
+    if (!poll(p, SG_CC, CC_CX, BIT(31), BIT(31), 10000)) return false;
+    if (!change(p, SG_CC, 0x20, BIT(13) | BIT(14), BIT(13) | BIT(14))) return false;
+    if (!change(p, SG_CC, CC_GX, waits | 1u, 0x00285000u)) return false;
+    wait_us(p, 2);
+    if (!poll(p, SG_CC, CC_GX, BIT(31), BIT(31), 10000)) return false;
+    /* BIMC_GFX depends on APSS_TCU; establish the SMMU votes FIRST. */
+    if (!change(p, SG_VOTE, CC_VOTE, CC_VOTE_MASK, CC_VOTE_MASK)) return false;
+    static const uint32_t tcu[] = {0x10, 0x18, 0x20};
+    for (unsigned i = 0; i < COUNT(tcu); i++)
+        if (!poll(p, SG_TCU, tcu[i], BIT(31), 0, 10000)) return false;
+    for (unsigned i = 0; i < COUNT(branches); i++) {
+        if (!change(p, SG_CC, branches[i], 1, 1) ||
+            !poll(p, SG_CC, branches[i], BIT(31), 0, 10000)) return false;
+    }
+    if (!change(p, SG_CC, 0x24, 1, 1)) return false; /* GMEM is a delay-only gate */
+    wait_us(p, 50);
+    trace(p, "XO power/clocks ready", read32(p, SG_CC, CC_CX),
+        read32(p, SG_CC, CC_GX), read32(p, SG_VOTE, CC_VOTE));
+    return true;
+}
+
+static bool restore_power(struct probe *p)
+{
+    bool ok = true;
+    while (p->saved_count) {
+        struct saved_reg r = p->saved[--p->saved_count];
+        uint32_t now = read32(p, r.block, r.off);
+        write32(p, r.block, r.off, (now & ~r.mask) | (r.value & r.mask));
+        if ((read32(p, r.block, r.off) & r.mask) != (r.value & r.mask)) ok = false;
+        if (r.block == SG_CC && r.off == CC_CFG && !update_rcg(p)) ok = false;
+        if (r.block == SG_CC && (r.off == CC_CX || r.off == CC_GX)) {
+            wait_us(p, 2);
+            /* A firmware vote may keep it powered, but never spin forever. */
+            if (!poll(p, SG_CC, r.off, BIT(31), r.value & BIT(31), 10000)) ok = false;
+        }
+    }
+    return ok;
+}
+
+static void faults(struct probe *p)
+{
+    p->report->status = read32(p, SG_GPU, SG_STATUS);
+    p->report->interrupt_status = read32(p, SG_GPU, SG_INT_STATUS);
+    p->report->smmu_fsr = read32(p, SG_SMMU, SG_CB_FSR);
+    p->report->smmu_global_fsr = read32(p, SG_SMMU, 0x48);
+    trace(p, "CP status/IRQ/CB fault", p->report->status,
+        p->report->interrupt_status, p->report->smmu_fsr);
+    trace(p, "SMMU global/FAR low/high", p->report->smmu_global_fsr,
+        read32(p, SG_SMMU, SG_CB_FAR), read32(p, SG_SMMU, SG_CB_FAR + 4));
+}
+
+struct smmu_saved {
+    uint32_t cr0, smr, s2cr, cbar, cba2r, sctlr, tcr, tcr2, mair0, mair1;
+    uint64_t ttbr0, ttbr1;
+    bool matching, changed;
+};
+
+static bool smmu_start(struct probe *p, struct smmu_saved *s)
+{
+    uint32_t id0 = read32(p, SG_SMMU, 0x20), id1 = read32(p, SG_SMMU, 0x24);
+    uint32_t id2 = read32(p, SG_SMMU, 0x28);
+    trace(p, "SMMU ID0/ID1/ID2", id0, id1, id2);
+    uint32_t bytes = (1u << (((id1 >> 28) & 7u) + 1)) * 8192u;
+    if (!(id0 & BIT(30)) || !(id2 & BIT(12)) || (id1 & BIT(31)) ||
+        !(id1 & 0xffu) || ((id1 >> 16) & 0xffu) || bytes != 0x10000u ||
+        ((id0 & BIT(27)) && !(id0 & 0xffu))) return false;
+    p->smmu_live = true; /* CB offsets are safe only after layout validation. */
+    s->matching = (id0 & BIT(27)) != 0;
+    s->cr0 = read32(p, SG_SMMU, 0);
+    s->smr = s->matching ? read32(p, SG_SMMU, SG_SMR0) : 0;
+    s->s2cr = read32(p, SG_SMMU, SG_S2CR0);
+    s->cbar = read32(p, SG_SMMU, SG_GR1_CBAR0);
+    s->cba2r = read32(p, SG_SMMU, SG_GR1_CBA2R0);
+    s->sctlr = read32(p, SG_SMMU, SG_CB);
+    s->tcr = read32(p, SG_SMMU, SG_CB_TTBCR);
+    s->tcr2 = read32(p, SG_SMMU, SG_CB_TTBCR2);
+    s->mair0 = read32(p, SG_SMMU, SG_CB_MAIR0);
+    s->mair1 = read32(p, SG_SMMU, SG_CB_MAIR0 + 4);
+    s->ttbr0 = p->ops->read64(p->ops->ctx, SG_SMMU, SG_CB_TTBR0);
+    s->ttbr1 = p->ops->read64(p->ops->ctx, SG_SMMU, SG_CB_TTBR1);
+    /* Do not rewrite a valid match for another stream or another CB. */
+    if ((s->matching && (s->smr & BIT(31)) && (s->smr & 0x7fff7fffu)) ||
+        ((s->sctlr & 1u) && (s->cbar & (3u << 16)) != BIT(16))) return false;
+    if (s->matching) {
+        for (unsigned i = 1; i < (id0 & 0xffu); i++) {
+            uint32_t match = read32(p, SG_SMMU, SG_SMR0 + i * 4);
+            if (!(match & BIT(31))) continue;
+            uint32_t mask = (match >> 16) & 0x7fffu, id = match & 0x7fffu;
+            uint32_t route = read32(p, SG_SMMU, SG_S2CR0 + i * 4);
+            if (!(id & ~mask) || (!(route & (3u << 16)) && !(route & 0xffu)))
+                return false; /* no duplicate SID0 match or other owner of CB0 */
+        }
+    }
+    if ((s->matching && (s->smr & BIT(31))) &&
+        !(s->s2cr & (3u << 16)) && (s->s2cr & 0xffu)) return false;
+    s->changed = true;
+    write32(p, SG_SMMU, SG_S2CR0, BIT(16)); /* FAULT while CB is replaced; never bypass */
+    write32(p, SG_SMMU, SG_CB, 0);
+    if (read32(p, SG_SMMU, SG_S2CR0) != BIT(16) || (read32(p, SG_SMMU, SG_CB) & 1u))
+        return false;
+    write32(p, SG_SMMU, SG_GR1_CBA2R0, 1); /* AArch64 context */
+    write32(p, SG_SMMU, SG_GR1_CBAR0, BIT(16) | 0xf300u);
+    /* 32-bit VA / 32-bit PA suffice for this owned window; 4K, outer WBWA. */
+    write32(p, SG_SMMU, SG_CB_TTBCR2, (7u << 15) | BIT(4));
+    write32(p, SG_SMMU, SG_CB_TTBCR, BIT(23) | (2u << 12) | BIT(10) | BIT(8) | 32u);
+    p->dma_exposed = true; /* page-table walk references are DMA too */
+    write64(p, SG_SMMU, SG_CB_TTBR0, p->memory.pa[0] | (1ull << 48));
+    write64(p, SG_SMMU, SG_CB_TTBR1, 1ull << 48);
+    write32(p, SG_SMMU, SG_CB_MAIR0, 0xff44u); /* attr1 WBWA */
+    write32(p, SG_SMMU, SG_CB_MAIR0 + 4, 0);
+    write32(p, SG_SMMU, SG_CB_FSR, ~0u);
+    write32(p, SG_SMMU, 0x48, read32(p, SG_SMMU, 0x48));
+    write32(p, SG_SMMU, SG_CB_TLBIASID, 1);
+    write32(p, SG_SMMU, SG_CB_TLBSYNC, 0);
+    if (!poll(p, SG_SMMU, SG_CB_TLBSTATUS, 1, 0, 10000)) {
+        p->report->error = SG_TLB_TIMEOUT; return false;
+    }
+    /* Faults terminate, not stall, and are polled: CFIE/CFCFG remain OFF. */
+    uint32_t sctlr = BIT(12) | BIT(8) | BIT(5) | BIT(2) | BIT(1) | BIT(0);
+    write32(p, SG_SMMU, SG_CB, sctlr);
+    if (s->matching) write32(p, SG_SMMU, SG_SMR0, BIT(31)); /* ONLY SID 0, mask=0 */
+    write32(p, SG_SMMU, SG_S2CR0, 0); /* translate through CB0 */
+    uint32_t cr0 = (s->cr0 & ~(BIT(0) | BIT(2) | BIT(5))) | BIT(1) | BIT(4) | BIT(10);
+    write32(p, SG_SMMU, 0, cr0); /* reject unmatched streams, no global IRQ */
+    uint64_t ttbr = p->ops->read64(p->ops->ctx, SG_SMMU, SG_CB_TTBR0);
+    bool ok = ttbr == (p->memory.pa[0] | (1ull << 48)) &&
+        read32(p, SG_SMMU, SG_CB) == sctlr &&
+        read32(p, SG_SMMU, SG_S2CR0) == 0 && read32(p, SG_SMMU, 0) == cr0 &&
+        read32(p, SG_SMMU, SG_GR1_CBA2R0) == 1 &&
+        (!s->matching || read32(p, SG_SMMU, SG_SMR0) == BIT(31));
+    trace(p, "owned CB0 TTBR/control/stream", (uint32_t)ttbr,
+        read32(p, SG_SMMU, SG_CB), read32(p, SG_SMMU, SG_S2CR0));
+    return ok;
+}
+
+static bool smmu_restore(struct probe *p, struct smmu_saved *s)
+{
+    if (!s->changed) return true;
+    write32(p, SG_SMMU, SG_S2CR0, BIT(16));
+    write32(p, SG_SMMU, SG_CB, 0);
+    write32(p, SG_SMMU, SG_CB_TLBIASID, 1);
+    write32(p, SG_SMMU, SG_CB_TLBSYNC, 0);
+    if (!poll(p, SG_SMMU, SG_CB_TLBSTATUS, 1, 0, 10000)) return false;
+    write32(p, SG_SMMU, SG_GR1_CBA2R0, s->cba2r);
+    write32(p, SG_SMMU, SG_GR1_CBAR0, s->cbar);
+    write32(p, SG_SMMU, SG_CB_TTBCR2, s->tcr2);
+    write32(p, SG_SMMU, SG_CB_TTBCR, s->tcr);
+    write64(p, SG_SMMU, SG_CB_TTBR0, s->ttbr0);
+    write64(p, SG_SMMU, SG_CB_TTBR1, s->ttbr1);
+    write32(p, SG_SMMU, SG_CB_MAIR0, s->mair0);
+    write32(p, SG_SMMU, SG_CB_MAIR0 + 4, s->mair1);
+    write32(p, SG_SMMU, SG_CB, s->sctlr);
+    if (s->matching) write32(p, SG_SMMU, SG_SMR0, s->smr);
+    write32(p, SG_SMMU, SG_S2CR0, s->s2cr);
+    write32(p, SG_SMMU, 0, s->cr0);
+    return read32(p, SG_SMMU, SG_CB) == s->sctlr &&
+        read32(p, SG_SMMU, SG_S2CR0) == s->s2cr && read32(p, SG_SMMU, 0) == s->cr0;
+}
+
+static void a505_init(struct probe *p, uint32_t pfp_version)
+{
+    /* A50x (ONE SP) HWCG values, not the A530 multi-SP table. */
+    static const uint32_t hwcg[][2] = {
+        {0x1a0,0x02222222},{0x1b0,0x02222220},{0x1c0,0xf3cf},{0x1d0,0x80},
+        {0x128,0x22222222},{0x138,0x22222222},{0x148,0x2222},
+        {0x2c0,0x77777777},{0x2d0,0x77777777},{0x2e0,0x7777},
+        {0x290,0x11111111},{0x2a0,0x11111111},{0x2b0,0x1111},
+        {0x16c,0x22222222},{0x170,0x22222222},{0x174,0x222222},
+        {0x168,0x22222222},{0x178,0xfffff4},{0x17c,2},
+        {0x1e0,0x22222222},{0x1f0,0x222222},{0x208,0x22220},
+        {0x228,0x5522222},{0x22c,0x505555},{0x218,0x4040404},
+        {0x200,0x7444044},{0x230,2},{0x204,0x10011},
+        {0x18c,0x4222222},{0x180,0x2222222},{0x244,0x2222},
+        {0x190,0},{0x188,0x4104004},{0x240,0},{0x198,0},
+        {0x194,0x4000},{0x184,0x200},{0x248,0x2222}
+    };
+    for (unsigned i = 0; i < COUNT(hwcg); i++) write32(p, SG_GPU, hwcg[i][0], hwcg[i][1]);
+    write32(p, SG_GPU, 0x19c, 0x55); /* RBBM_CLOCK_CNTL */
+    static const uint32_t regs[][2] = {
+        {0xc124,3}, {0x24c,1}, /* VBIF RR, RBBM AHB error reporting */
+        {0x3a58,2}, /* UCHE_CACHE_WAYS */
+        {0x3a24,0xffff0000},{0x3a28,0x1ffff}, /* UCHE trap */
+        {0x3a1c,0xffff0000},{0x3a20,0x1ffff}, /* disable write-through bypass */
+        {0x3a2c,0x100000},{0x3a30,0},
+        {0x3a34,0x121fff},{0x3a38,0}, /* 136K GMEM range */
+        {0x2094,0x20},{0x2098,0x400}, /* A505 MEQ, MERCIU */
+        {0x2080,0x40000030},{0x207c,0x20100d0a}, /* A505 ROQ */
+        {0x3a04,0x20000000},{0x20cc,0x02000000},
+        {0x250,0xa6ffffff},{0x254,0x3f}, /* split notification, AHB CNTL2 */
+        {0x3c08,0x80},{0x3318,2} /* highest DDR bank bit 14 */
+    };
+    for (unsigned i = 0; i < COUNT(regs); i++) write32(p, SG_GPU, regs[i][0], regs[i][1]);
+    uint32_t pc = (0x100u << 11) | (0x100u << 22);
+    if (pfp_version >= 0x5ff077u) pc |= BIT(8); /* DT two-pass WFI quirk */
+    write32(p, SG_GPU, 0x3400, pc);
+    write32(p, SG_GPU, 0x3310, read32(p, SG_GPU, 0x3310) | BIT(9));
+    write32(p, SG_GPU, 0x3980, read32(p, SG_GPU, 0x3980) | BIT(10) | BIT(23));
+    write32(p, SG_GPU, 0x3810, read32(p, SG_GPU, 0x3810) & ~BIT(18));
+    static const uint32_t addr[] = {0x2180,0x2f04,0x3204,0x3314,0x3404,
+        0x3814,0x3904,0x3984,0x3a00,0x3b04,0x3c04};
+    for (unsigned i = 0; i < COUNT(addr); i++) write32(p, SG_GPU, addr[i], 1);
+    /* No GPMU/SPTP-PC on this catalog entry; no A530 RBCCU/SP power recipe. */
+}
+
+static bool consume(struct probe *p, uint32_t words)
+{
+    if (!words || words >= SGPU_PAGE / 4) return false;
+    p->ops->clean(p->ops->ctx, p->memory.va + 3 * SGPU_PAGE, SGPU_PAGE);
+    write32(p, SG_GPU, SG_RB_WPTR, words);
+    if (!poll(p, SG_GPU, SG_RB_RPTR, ~0u, words, POLL_US)) return false;
+    return poll(p, SG_GPU, SG_STATUS, SG_BUSY_MASK, 0, POLL_US);
+}
+
+static bool marker_test(struct probe *p, const struct sgpu_firmware *fw, uint32_t *wptr)
+{
+    uint32_t *ring = (uint32_t *)(void *)(p->memory.va + 3 * SGPU_PAGE);
+    uint32_t *marks = (uint32_t *)(void *)(p->memory.va + 4 * SGPU_PAGE + SGPU_MARKER_OFFSET);
+    static const uint32_t me[9] = {0x70c80008,0x2f,3,0x20000000,0,0,0xb,0,0};
+    for (unsigned i = 0; i < COUNT(me); i++) ring[i] = me[i];
+    p->ops->clean(p->ops->ctx, p->memory.va, SGPU_POOL_BYTES);
+    write32(p, SG_GPU, SG_RB_RPTR_ADDR, SGPU_MARKER_VA);
+    write32(p, SG_GPU, SG_RB_RPTR_ADDR + 4, 0);
+    write32(p, SG_GPU, SG_RB_CNTL, BIT(27) | (2u << 8) | 9u); /* 4K / 8 */
+    write32(p, SG_GPU, SG_RB_BASE, SGPU_RING_VA);
+    write32(p, SG_GPU, SG_RB_BASE_HI, 0);
+    write32(p, SG_GPU, SG_PM4_BASE, SGPU_PM4_VA);
+    write32(p, SG_GPU, SG_PM4_BASE + 4, 0);
+    write32(p, SG_GPU, SG_PFP_BASE, SGPU_PFP_VA);
+    write32(p, SG_GPU, SG_PFP_BASE + 4, 0);
+    p->dma_exposed = true; /* ME may fetch immediately; never free after this */
+    write32(p, SG_GPU, SG_ME_CNTL, 0);
+    if (!consume(p, 9)) return false;
+    *wptr = 9;
+    trace(p, "ME_INIT consumed; firmware versions", fw->pm4_version, fw->pfp_version, 9);
+    for (unsigned pass = 0; pass < 2; pass++) {
+        for (unsigned i = 0; i < SGPU_MARKERS; i++) {
+            ring[(*wptr)++] = sgpu_packet7(0x3d, 3); /* CP_MEM_WRITE, 64-bit address */
+            ring[(*wptr)++] = SGPU_MARKER_VA + SGPU_MARKER_OFFSET + i * 4;
+            ring[(*wptr)++] = 0;
+            ring[(*wptr)++] = 0xa5050000u ^ (pass << 12) ^ (i * 0x101u);
+        }
+        ring[(*wptr)++] = sgpu_packet7(0x26, 0); /* WAIT_FOR_IDLE */
+        if (!consume(p, *wptr)) return false;
+        p->ops->invalidate(p->ops->ctx, marks, 64);
+        for (unsigned i = 0; i < SGPU_MARKERS; i++) {
+            uint32_t expected = 0xa5050000u ^ (pass << 12) ^ (i * 0x101u);
+            if (((volatile uint32_t *)marks)[i] != expected) {
+                p->report->error = SG_MARKER_MISMATCH;
+                trace(p, "marker mismatch index/got/want", i, marks[i], expected);
+                return false;
+            }
+        }
+        p->report->markers += SGPU_MARKERS;
+        trace(p, "GPU marker pass/count/value", pass, p->report->markers, marks[0]);
+    }
+    return true;
+}
+
+/* Fixed, kernel-owned 16x16 RGBA copy. Mesa fd5_blitter.c / Sailfish emit_blit.
+ * No dimensions, opcodes, addresses or command words are supplied by userland. */
+uint32_t sgpu_blit_commands(uint32_t *out, uint32_t capacity, uint32_t fence)
+{
+    if (!out || capacity < 100 || fence != SGPU_MARKER_VA + 768) return 0;
+    uint32_t n = 0;
+#define EMIT(v) (out[n++] = (v))
+#define REG(r,v) do { EMIT(packet4((r),1)); EMIT(v); } while (0)
+    EMIT(packet4(0xe91,5)); EMIT(0); EMIT(0); EMIT(0); EMIT(0); EMIT(0x12);
+    EMIT(sgpu_packet7(0x26,0));
+    REG(0xe141,8); REG(0x2100,0x86000000); REG(0x2180,0x86000000);
+    REG(0x2184,9); REG(0xe140,1u << 17);
+    REG(0xcc6,2); /* same highest-bank bit 14 as the Santoni startup */
+    REG(0xec2,0xc); REG(0xf02,0x2c4); REG(0xe06,2); REG(0xe000,0x181);
+    EMIT(sgpu_packet7(0x6c,1)); EMIT(5); /* SET_RENDER_MODE BLIT2D */
+    const uint32_t info = 0x30u; /* A5xx RB5_R8G8B8A8_UNORM, linear RGBA */
+    EMIT(packet4(0x2107,9)); EMIT(info);
+    EMIT(SGPU_SOURCE_VA); EMIT(0); EMIT(1u | (16u << 16));
+    for (unsigned i = 0; i < 5; i++) EMIT(0);
+    REG(0x2181,info);
+    EMIT(packet4(0x2110,9)); EMIT(info);
+    EMIT(SGPU_DEST_VA); EMIT(0); EMIT(1u | (16u << 16));
+    for (unsigned i = 0; i < 5; i++) EMIT(0);
+    REG(0x2182,info);
+    EMIT(sgpu_packet7(0x2c,5)); EMIT(1); EMIT(0); EMIT(15u | (15u << 16));
+    EMIT(0); EMIT(15u | (15u << 16));
+    EMIT(sgpu_packet7(0x6c,1)); EMIT(8); /* END2D */
+    EMIT(sgpu_packet7(0x26,0));
+    EMIT(sgpu_packet7(0x46,4)); EMIT(0x1d); EMIT(fence); EMIT(0); EMIT(0);
+    EMIT(sgpu_packet7(0x46,4)); EMIT(4); EMIT(fence); EMIT(0); EMIT(0xa5052d01);
+    EMIT(sgpu_packet7(0x26,0));
+#undef REG
+#undef EMIT
+    return n;
+}
+
+static bool render_test(struct probe *p, uint32_t *wptr)
+{
+    uint8_t *source = p->memory.va + 5 * SGPU_PAGE;
+    uint8_t *dest = p->memory.va + 6 * SGPU_PAGE;
+    for (unsigned y = 0; y < 16; y++) for (unsigned x = 0; x < 16; x++) {
+        unsigned i = y * 64 + x * 4;
+        source[i] = (uint8_t)(x * 13 + 1); source[i+1] = (uint8_t)(y * 11 + 2);
+        source[i+2] = (uint8_t)((x + y) * 7 + 3); source[i+3] = 0xff;
+    }
+    for (unsigned i = 0; i < SGPU_PAGE; i++) dest[i] = 0xa5;
+    p->ops->clean(p->ops->ctx, source, SGPU_PAGE);
+    p->ops->clean(p->ops->ctx, dest, SGPU_PAGE);
+    uint32_t *ring = (uint32_t *)(void *)(p->memory.va + 3 * SGPU_PAGE);
+    uint32_t n = sgpu_blit_commands(ring + *wptr, SGPU_PAGE / 4 - *wptr,
+        SGPU_MARKER_VA + 768);
+    if (!n) return false;
+    *wptr += n;
+    if (!consume(p, *wptr)) return false;
+    p->ops->invalidate(p->ops->ctx, p->memory.va + 4 * SGPU_PAGE + 768, 64);
+    p->ops->invalidate(p->ops->ctx, dest, SGPU_PAGE);
+    if (*(volatile uint32_t *)(void *)(p->memory.va + 4 * SGPU_PAGE + 768) != 0xa5052d01u)
+        return false;
+    for (unsigned i = 0; i < 1024; i++) if (((volatile uint8_t *)dest)[i] != source[i]) return false;
+    for (unsigned i = 1024; i < SGPU_PAGE; i++) if (((volatile uint8_t *)dest)[i] != 0xa5) return false;
+    p->report->pixels = 256;
+    trace(p, "GPU 2D pixels/fence PASS", 256, 0, 0xa5052d01);
+    return true;
+}
+
+bool sgpu_probe(const struct sgpu_ops *ops, uint32_t mode, const uint8_t *blob,
+    size_t blob_size, struct sgpu_report *report)
+{
+    if (!report) return false;
+    *report = (struct sgpu_report){0};
+    if (mode == 0) return true;
+    if (mode > 3 || !ops || !ops->map || !ops->read32 || !ops->write32 ||
+        !ops->read64 || !ops->write64 || !ops->now_us || !ops->wait_us || !ops->allocate ||
+        !ops->release || !ops->clean || !ops->invalidate || !ops->trace) {
+        report->error = SG_BAD_MODE; return false;
+    }
+    struct probe p = {.ops = ops, .report = report};
+    struct sgpu_firmware fw = {0};
+    struct smmu_saved smmu = {0};
+    bool passed = false, stopped = true;
+    report->stage = SG_FIRMWARE;
+    if (mode >= 2 && !sgpu_firmware_validate(blob, blob_size, &fw)) {
+        report->error = SG_BAD_FIRMWARE; return false;
+    }
+    report->pm4_version = fw.pm4_version; report->pfp_version = fw.pfp_version;
+    if (mode >= 2) {
+        report->stage = SG_TABLES;
+        if (!ops->allocate(ops->ctx, &p.memory)) { report->error = SG_NO_MEMORY; return false; }
+        if (!sgpu_tables_build(&p.memory, &fw)) { report->error = SG_BAD_MEMORY; goto done; }
+    }
+    const uint32_t pa[] = {0x01859000,0x0185b000,0x01845000,0x01812000};
+    report->stage = SG_POWER;
+    for (unsigned i = 0; i < COUNT(pa); i++)
+        if (!ops->map(ops->ctx, (enum sgpu_block)i, pa[i], 0x1000)) {
+            report->error = SG_NO_MAP; goto done;
+        }
+    if (!power(&p)) { report->error = SG_POWER_TIMEOUT; goto done; }
+    /* Do not touch an unpowered GPU/SMMU, including on an earlier failure. */
+    report->stage = SG_REGISTERS;
+    trace(&p, "before powered GPU read", 0x01c00000, 0x40000, mode);
+    if (!ops->map(ops->ctx, SG_GPU, 0x01c00000, 0x40000)) { report->error = SG_NO_MAP; goto done; }
+    p.gpu_live = true;
+    report->vbif = read32(&p, SG_GPU, SG_VBIF_VERSION);
+    uint32_t aon = read32(&p, SG_GPU, SG_AON_LO);
+    wait_us(&p, 1000);
+    report->aon_delta = read32(&p, SG_GPU, SG_AON_LO) - aon;
+    report->status = read32(&p, SG_GPU, SG_STATUS);
+    report->trust = ~0u; /* no protected-register read is needed for CP-only proof */
+    trace(&p, "GPU VBIF/AON delta/status", report->vbif, report->aon_delta, report->status);
+    if (!report->vbif || report->vbif == ~0u || !report->aon_delta) { report->error = SG_BAD_ID; goto done; }
+    if (mode == 1) { passed = true; goto done; }
+    if (report->status & SG_BUSY_MASK) { report->error = SG_BUSY; goto done; }
+    report->stage = SG_TRANSLATION;
+    trace(&p, "before powered SMMU read/setup", 0x01c40000, 0x10000, 0);
+    if (!ops->map(ops->ctx, SG_SMMU, 0x01c40000, 0x10000)) { report->error = SG_NO_MAP; goto done; }
+    write32(&p, SG_GPU, SG_INT_MASK, 0); /* no unregistered GPU interrupt */
+    write32(&p, SG_GPU, SG_ME_CNTL, SG_ME_HALT);
+    write32(&p, SG_GPU, SG_RESET, 1);
+    (void)read32(&p, SG_GPU, SG_RESET);
+    wait_us(&p, 2);
+    write32(&p, SG_GPU, SG_RESET, 0);
+    write32(&p, SG_GPU, SG_ME_CNTL, SG_ME_HALT);
+    write32(&p, SG_GPU, SG_INT_MASK, 0);
+    ops->clean(ops->ctx, p.memory.va, SGPU_POOL_BYTES);
+    if (!smmu_start(&p, &smmu)) {
+        if (!report->error) report->error = SG_BAD_SMMU;
+        goto done;
+    }
+    a505_init(&p, fw.pfp_version);
+    report->stage = SG_COMMANDS;
+    trace(&p, "before ME_INIT/owned marker commands", SGPU_RING_VA, SGPU_MARKER_VA, 0);
+    uint32_t wptr = 0;
+    if (!marker_test(&p, &fw, &wptr)) {
+        if (!report->error) report->error = SG_COMMAND_TIMEOUT;
+        goto done;
+    }
+    faults(&p);
+    if (report->smmu_fsr || report->smmu_global_fsr) { report->error = SG_FAULT; goto done; }
+    if (mode == 3) {
+        report->stage = SG_RENDER;
+        trace(&p, "before TRUST read ONLY; no secure writes", SG_TRUST, 0, 0);
+        report->trust = read32(&p, SG_GPU, SG_TRUST);
+        if (report->trust != 0) {
+            report->error = SG_NEEDS_UNSECURE;
+            trace(&p, "CP passed; render gated by TRUST", report->trust, report->markers, 0);
+            goto done;
+        }
+        if (!render_test(&p, &wptr)) { report->error = SG_MARKER_MISMATCH; goto done; }
+        faults(&p);
+        if (report->smmu_fsr || report->smmu_global_fsr) { report->error = SG_FAULT; goto done; }
+    }
+    report->stage = SG_COMPLETE;
+    passed = true;
+done:
+    if (p.gpu_live && p.smmu_live) {
+        faults(&p);
+        write32(&p, SG_GPU, SG_ME_CNTL, SG_ME_HALT);
+        stopped = poll(&p, SG_GPU, SG_ME_CNTL, SG_ME_HALT, SG_ME_HALT, 10000) &&
+            poll(&p, SG_GPU, SG_STATUS, SG_BUSY_MASK, 0, 10000);
+        if (!stopped) {
+            /* A soft reset is vendor-supported on A505, not the A530v1 exception. */
+            write32(&p, SG_GPU, SG_RESET, 1);
+            (void)read32(&p, SG_GPU, SG_RESET);
+            wait_us(&p, 2);
+            write32(&p, SG_GPU, SG_RESET, 0);
+            write32(&p, SG_GPU, SG_ME_CNTL, SG_ME_HALT);
+            stopped = poll(&p, SG_GPU, SG_STATUS, SG_BUSY_MASK, 0, 10000) &&
+                poll(&p, SG_GPU, SG_ME_CNTL, SG_ME_HALT, SG_ME_HALT, 10000);
+        }
+        /* An uncertain engine stays contained in its owned translations. */
+        if (stopped && !smmu_restore(&p, &smmu)) stopped = false;
+    }
+    report->memory_retained = p.dma_exposed;
+    if (p.memory.va && !p.dma_exposed) ops->release(ops->ctx, &p.memory);
+    report->restored = stopped && restore_power(&p);
+    if (!report->restored) {
+        trace(&p, "rollback incomplete; bounded DMA retained", report->error, report->stage,
+            report->memory_retained ? SGPU_POOL_BYTES : 0);
+        if (!report->error) report->error = SG_ROLLBACK_FAILED;
+        passed = false;
+    }
+    return passed;
+}
+#endif
diff --git a/bsd/dev/santoni_gpu_core.h b/bsd/dev/santoni_gpu_core.h
new file mode 100644
--- /dev/null
+++ b/bsd/dev/santoni_gpu_core.h
@@ -0,0 +1,107 @@
+/* Santoni A505 diagnostic interface. No user submissions or display ownership. */
+#ifndef SANTONI_GPU_CORE_H
+#define SANTONI_GPU_CORE_H
+#include <stdint.h>
+#include <stddef.h>
+#include <stdbool.h>
+
+#define SGPU_PAGE 4096u
+#define SGPU_POOL_PAGES 24u
+#define SGPU_POOL_BYTES (SGPU_POOL_PAGES * SGPU_PAGE)
+#define SGPU_FW_MAX 32768u
+#define SGPU_FW_HEADER 32u
+#define SGPU_CHIPID 0x05000500u
+#define SGPU_GMEM_BYTES 139264u
+#define SGPU_DMA_MIN 0x98000000ull
+#define SGPU_DMA_END 0xc0000000ull
+#define SGPU_VA_BASE 0x01000000u
+#define SGPU_PM4_VA (SGPU_VA_BASE + 0x00000u)
+#define SGPU_PFP_VA (SGPU_VA_BASE + 0x10000u)
+#define SGPU_RING_VA (SGPU_VA_BASE + 0x20000u)
+#define SGPU_MARKER_VA (SGPU_VA_BASE + 0x30000u)
+#define SGPU_SOURCE_VA (SGPU_VA_BASE + 0x40000u)
+#define SGPU_DEST_VA (SGPU_VA_BASE + 0x50000u)
+#define SGPU_MARKER_OFFSET 512u
+#define SGPU_MARKERS 8u
+
+enum sgpu_block { SG_CC, SG_MISC, SG_VOTE, SG_TCU, SG_GPU, SG_SMMU, SG_BLOCKS };
+enum sgpu_stage { SG_OFF, SG_FIRMWARE, SG_POWER, SG_REGISTERS, SG_TABLES,
+    SG_TRANSLATION, SG_COMMANDS, SG_RENDER, SG_COMPLETE };
+enum sgpu_error { SG_OK, SG_BAD_MODE, SG_BAD_FIRMWARE, SG_NO_MAP,
+    SG_POWER_TIMEOUT, SG_BUSY, SG_BAD_ID, SG_NO_MEMORY, SG_BAD_MEMORY,
+    SG_BAD_SMMU, SG_TLB_TIMEOUT, SG_COMMAND_TIMEOUT, SG_FAULT,
+    SG_MARKER_MISMATCH, SG_ROLLBACK_FAILED, SG_NEEDS_UNSECURE };
+
+struct sgpu_memory { uint8_t *va; uint64_t pa[SGPU_POOL_PAGES]; };
+struct sgpu_firmware {
+    const uint8_t *pm4, *pfp;
+    uint32_t pm4_bytes, pfp_bytes, pm4_version, pfp_version;
+};
+struct sgpu_ops {
+    void *ctx;
+    bool (*map)(void *, enum sgpu_block, uint32_t, uint32_t);
+    uint32_t (*read32)(void *, enum sgpu_block, uint32_t);
+    uint64_t (*read64)(void *, enum sgpu_block, uint32_t);
+    void (*write32)(void *, enum sgpu_block, uint32_t, uint32_t);
+    void (*write64)(void *, enum sgpu_block, uint32_t, uint64_t);
+    uint64_t (*now_us)(void *);
+    void (*wait_us)(void *, uint32_t);
+    bool (*allocate)(void *, struct sgpu_memory *);
+    void (*release)(void *, struct sgpu_memory *);
+    void (*clean)(void *, const void *, uint32_t);
+    void (*invalidate)(void *, const void *, uint32_t);
+    void (*trace)(void *, const char *, uint32_t, uint32_t, uint32_t);
+};
+struct sgpu_report {
+    uint32_t stage, error, markers, trust, vbif, aon_delta, pixels;
+    uint32_t status, interrupt_status, smmu_fsr, smmu_global_fsr;
+    uint32_t pm4_version, pfp_version;
+    bool memory_retained, restored;
+};
+
+uint32_t sgpu_crc32(const uint8_t *, size_t);
+uint32_t sgpu_packet7(uint32_t, uint32_t);
+bool sgpu_firmware_validate(const uint8_t *, size_t, struct sgpu_firmware *);
+bool sgpu_memory_validate(const struct sgpu_memory *);
+bool sgpu_tables_build(struct sgpu_memory *, const struct sgpu_firmware *);
+uint32_t sgpu_blit_commands(uint32_t *, uint32_t, uint32_t);
+bool sgpu_probe(const struct sgpu_ops *, uint32_t, const uint8_t *, size_t,
+    struct sgpu_report *);
+
+/* Register offsets are BYTES, from MSM4.9 a5xx_reg.h (which uses WORDS). */
+#define SG_RB_BASE 0x2000u
+#define SG_RB_BASE_HI 0x2004u
+#define SG_RB_CNTL 0x2008u
+#define SG_RB_RPTR_ADDR 0x2010u
+#define SG_RB_RPTR 0x2018u
+#define SG_RB_WPTR 0x201cu
+#define SG_ME_CNTL 0x20c8u
+#define SG_PFP_BASE 0x20d4u
+#define SG_PM4_BASE 0x20e0u
+#define SG_STATUS 0x13d4u
+#define SG_AON_LO 0x1348u
+#define SG_VBIF_VERSION 0xc000u
+#define SG_TRUST 0x3d000u
+#define SG_INT_MASK 0xe0u
+#define SG_INT_STATUS 0x1384u
+#define SG_RESET 0x10cu
+#define SG_ME_HALT (1u << 28)
+#define SG_BUSY_MASK 0xfffffffeu
+
+/* SMMU v2 user CB0, from MSM8937 DT gpu-offset=0x48000 and arm-smmu.c. */
+#define SG_CB 0x8000u
+#define SG_SMR0 0x800u
+#define SG_S2CR0 0xc00u
+#define SG_GR1_CBAR0 0x1000u
+#define SG_GR1_CBA2R0 0x1800u
+#define SG_CB_TTBCR2 (SG_CB + 0x10u)
+#define SG_CB_TTBR0 (SG_CB + 0x20u)
+#define SG_CB_TTBR1 (SG_CB + 0x28u)
+#define SG_CB_TTBCR (SG_CB + 0x30u)
+#define SG_CB_MAIR0 (SG_CB + 0x38u)
+#define SG_CB_FSR (SG_CB + 0x58u)
+#define SG_CB_FAR (SG_CB + 0x60u)
+#define SG_CB_TLBIASID (SG_CB + 0x610u)
+#define SG_CB_TLBSYNC (SG_CB + 0x7f0u)
+#define SG_CB_TLBSTATUS (SG_CB + 0x7f4u)
+#endif
