+#if defined(SANTONI)
+/*
+ * GICv2 CPU-interface id per logical CPU on Qualcomm MSM8937 (santoni):
+ * Cluster 1 (MPIDR 0x100..0x103) is mapped as cpu0..cpu3 -> GIC interfaces 4..7.
+ * Cluster 0 (MPIDR 0x000..0x003) is mapped as cpu4..cpu7 -> GIC interfaces 0..3.
+ */
+uint32_t
+sweet_gic_cpu_iface(unsigned int cpu)
+{
+	if (cpu < 4) {
+		return 4 + cpu;
+	} else if (cpu < SWEET_SMP_MAX_CPUS) {
+		return cpu - 4;
+	}
+	return 0xffffffffU;
+}
