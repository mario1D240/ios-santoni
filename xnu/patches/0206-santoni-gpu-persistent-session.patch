+/* Final-address, once-only core ownership. No pointer here names a worker's
+ * departed stack. The adapter holds its independent CPU queue/lock/events. */
+static struct {
+    bool attempted, ready, active, prepared, stopped;
+    struct sgpu_ops ops;
+    struct probe p;
+    struct sgpu_g3 arena;
+    struct sgpu_report startup, working;
+    struct sgpu_session_result result;
+    uint32_t wptr, values[4];
+    uint64_t start_us, last_us;
+} session_core;
+_Static_assert(sizeof(session_core)+sizeof(struct sgpu_session_queue) <= 15360,
+    "reserve at least 1KiB of the 16KiB control cap for adapter data");
+
+static bool session_fail(uint32_t error, uint32_t phase)
+{
+    if (!session_core.stopped) {
+        session_core.result.error=error;
+        session_core.result.phase=phase;
+        session_core.result.failure=session_core.working.failure;
+        session_core.result.state=SG_REQUEST_FAILED;
+        session_core.ready=session_core.prepared=false;
+        session_core.stopped=true;
+        sgpu_g3_abort(&session_core.arena);
+    }
+    return false;
+}
+
+static bool session_time(uint32_t phase, uint64_t *now)
+{
+    if (session_core.stopped) return false;
+    *now=session_core.ops.now_us(session_core.ops.ctx);
+    if (*now<session_core.last_us || *now<session_core.start_us ||
+        *now-session_core.start_us>=SGPU_SESSION_BUDGET_US)
+        return session_fail(SG_COMMAND_TIMEOUT,phase);
+    session_core.last_us=*now;
+    return true;
+}
