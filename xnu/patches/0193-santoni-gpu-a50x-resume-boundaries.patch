     write32(&p, SG_GPU, SG_RESET, 0);
-    if (!sgpu_a505_halt(&p, 2) ||
+    /* adreno.c _soft_reset re-enables A50x regulators immediately afterward. */
+    if (!sgpu_a505_resume(&p) ||
+        !sgpu_a505_halt(&p, 2) ||
