+/* A separate kernel-only producer proves that startup stack lifetime and a
+ * worker idle/wakeup are real. It never reads/writes GPU or shared DMA pages. */
+static void sgpu_session_producer(void *arg __unused, wait_result_t result __unused)
+{
+    unsigned sent=0;
+    uint32_t wave_idle=0;
+    uint64_t start=now_us(NULL);
+    bool done=false;
+    for (unsigned attempt=0;attempt<10000;attempt++) {
+        lck_mtx_lock(&sgpu_session_lock);
+        struct sgpu_session_status state=session_queue.status;
+        bool terminal=state.state==SG_SESSION_CLOSED || state.state==SG_SESSION_FAULTED;
+        bool second_wave=sent>=16 && (state.completed<16 || session_idle_count<=wave_idle);
+        if (!terminal && session_idle_count && !second_wave && sent<SGPU_SESSION_LIMIT) {
+            uint32_t values[4];
+            for (unsigned i=0;i<4;i++) values[i]=0xa5060000u ^ ((sent+1)<<8) ^ i;
+            uint32_t id=0;
+            uint32_t rc=sgpu_session_enqueue(&session_queue,SGPU_SESSION_OWNER,SGPU_SESSION_WRITE4,values,&id);
+            if (rc==SG_SESSION_OK) { sent++; if (sent==16) wave_idle=session_idle_count; }
+            else if (rc!=SG_SESSION_FULL && rc!=SG_SESSION_AT_QUOTA) {
+                (void)sgpu_session_close(&session_queue,SGPU_SESSION_OWNER);
+                terminal=true;
+            }
+        }
+        lck_mtx_unlock(&sgpu_session_lock);
+        thread_wakeup(&session_queue_event);
+        if (terminal) { done=true; break; }
+        uint64_t now=now_us(NULL);
+        if (now<start || now-start>=100000000u) break;
+        sgpu_kernel_wait_us(NULL,10000);
+    }
+    if (!done) {
+        lck_mtx_lock(&sgpu_session_lock);
+        (void)sgpu_session_close(&session_queue,SGPU_SESSION_OWNER);
+        lck_mtx_unlock(&sgpu_session_lock);
+        thread_wakeup(&session_queue_event);
+        printf("SANTONI GPU: SESSION producer deadline; close pending; no hardware retry\n");
+    }
+    thread_terminate_self();
+}
+
+static void __attribute__((noinline)) sgpu_session_loop(void)
+{
+    lck_mtx_lock(&sgpu_session_lock);
+    bool initialized=sgpu_session_queue_init(&session_queue);
+    lck_mtx_unlock(&sgpu_session_lock);
+    if (!initialized) { sgpu_session_stop(); return; }
+    thread_t producer;
+    if (kernel_thread_start(sgpu_session_producer,NULL,&producer)!=KERN_SUCCESS) {
+        lck_mtx_lock(&sgpu_session_lock);
+        session_queue.status.state=SG_SESSION_FAULTED;
+        session_queue.status.reason=SG_SESSION_FAILURE;
+        session_queue.status.error=SG_NO_MEMORY;
+        lck_mtx_unlock(&sgpu_session_lock);
+        sgpu_session_stop();
+        printf("SANTONI GPU: SESSION producer creation failed; state HELD; no retry\n");
+        return;
+    }
+    thread_deallocate(producer);
+    printf("SANTONI GPU: SESSION ready; fixed mappings, kernel WRITE4 only; NO PAS; NO UI\n");
+    for (;;) {
+        struct sgpu_session_request request;
+        lck_mtx_lock(&sgpu_session_lock);
+        bool have=sgpu_session_take(&session_queue,&request);
+        bool terminal=session_queue.status.state==SG_SESSION_CLOSED || session_queue.status.state==SG_SESSION_FAULTED;
+        if (!have) {
+            if (terminal) { lck_mtx_unlock(&sgpu_session_lock); break; }
+            if (session_idle_count!=UINT32_MAX) session_idle_count++;
+            wait_result_t waiting=assert_wait(&session_queue_event,THREAD_UNINT);
+            lck_mtx_unlock(&sgpu_session_lock);
+            if (waiting==THREAD_WAITING) thread_block(THREAD_CONTINUE_NULL);
+            continue; /* predicate and wait registration share the queue lock */
+        }
+        lck_mtx_unlock(&sgpu_session_lock);
+        struct sgpu_session_result result={0};
+        if (!sgpu_session_prepare()) sgpu_session_failure_result(&result);
+        else {
+            lck_mtx_lock(&sgpu_session_lock);
+            bool committed=sgpu_session_commit(&session_queue,request.id);
+            lck_mtx_unlock(&sgpu_session_lock);
+            if (!committed) {
+                sgpu_session_stop();
+                lck_mtx_lock(&sgpu_session_lock);
+                sgpu_session_fault_pending(&session_queue,NULL);
+                lck_mtx_unlock(&sgpu_session_lock);
+                continue;
+            }
+            if (!sgpu_session_execute(request.value,&result) && !result.error)
+                result.error=SG_BAD_MODE;
+        }
+        if (!result.error && result.state!=SG_REQUEST_COMPLETE) result.error=SG_BAD_MODE;
+        lck_mtx_lock(&sgpu_session_lock);
+        bool recorded=sgpu_session_finish(&session_queue,request.id,&result);
+        if (!recorded) {
+            /* Internal contract violation: stop, never manufacture completion. */
+            sgpu_session_fault_pending(&session_queue,&result);
+        }
+        lck_mtx_unlock(&sgpu_session_lock);
+        if (result.error || !recorded) sgpu_session_stop();
+    }
+    sgpu_session_stop();
+    lck_mtx_lock(&sgpu_session_lock);
+    struct sgpu_session_status state=session_queue.status;
+    struct sgpu_session_result first={0};
+    if (state.first_failed_id && state.first_failed_id<=SGPU_SESSION_LIMIT)
+        first=session_queue.entry[state.first_failed_id-1].result;
+    uint32_t idle=session_idle_count;
+    lck_mtx_unlock(&sgpu_session_lock);
+    bool passed=state.state==SG_SESSION_CLOSED && state.reason==SG_SESSION_QUOTA &&
+        state.admitted==32 && state.committed==32 && state.submitted==32 && state.completed==32 &&
+        state.writes==128 && state.last_sequence==34 && state.wptr==522 && !state.error &&
+        !state.cancelled && !state.failed && !state.active && !state.outstanding && idle>=2;
+    sgpu_failure_summary("SESSION FIRST_FAIL",&state.failure);
+    if (state.error)
+        printf("SANTONI GPU: SESSION failure phase=%u seq=%u attempted_wptr=%u publish_attempted=%u; state retained\n",
+            first.phase,first.sequence,first.wptr,first.publish_attempted?1u:0u);
+    printf("SANTONI GPU: SESSION RESULT pass=%u admitted=%u committed=%u submitted=%u completed=%u cancelled=%u failed=%u writes=%u\n",
+        passed?1u:0u,state.admitted,state.committed,state.submitted,state.completed,state.cancelled,state.failed,state.writes);
+    printf("SANTONI GPU: SESSION STATE state=%u reason=%u last_seq=%u wptr=%u error=%u failed_id=%u idle=%u retained=%u; NO PAS; NO UI; held until reboot\n",
+        state.state,state.reason,state.last_sequence,state.wptr,state.error,state.first_failed_id,idle,SGPU_POOL_BYTES);
+}
