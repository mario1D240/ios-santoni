@@ -3052,11 +3066,9 @@
 		} else {
 			tlmm_gpio_out_low(tlmm, PIN_SDA);
 		}
-		/* tSU;DAT >= 250 ns; give 15 us so SDA settles before SCL
-		 * rises.  At 47 kohm pull-up and 100 pF: tau ~= 5 us,
-		 * 15 us covers 3 tau = 95% of VDD = 1.71 V > VIH 1.26 V. */
+		/* Preserve the existing 15 us setup/high/low intervals. */
 		delay(15);
-		santoni_i2c_scl_high(tlmm);
+		if (!santoni_i2c_scl_high(tlmm)) return false;
 		/* tHIGH >= 4 us; sample after the bus has settled. */
 		delay(15);
 		tlmm_gpio_out_low(tlmm, PIN_SCL);
@@ -3065,22 +3077,23 @@
 	}
 	tlmm_gpio_in(tlmm, PIN_SDA);
 	delay(15);
-	santoni_i2c_scl_high(tlmm);
+	if (!santoni_i2c_scl_high(tlmm)) return false;
 	delay(15);
 	bool ack = (tlmm_gpio_get(tlmm, PIN_SDA) == 0);
 	tlmm_gpio_out_low(tlmm, PIN_SCL);
 	delay(15);
+	if (!ack) santoni_i2c_diag.error = "NACK";
 	return ack;
 }
 
-static uint8_t
-santoni_i2c_read(vm_offset_t tlmm, bool ack)
+static bool
+santoni_i2c_read(vm_offset_t tlmm, uint8_t *out, bool ack)
 {
 	uint8_t byte = 0;
 	tlmm_gpio_in(tlmm, PIN_SDA);
 	for (int i = 7; i >= 0; i--) {
 		delay(15);
-		santoni_i2c_scl_high(tlmm);
+		if (!santoni_i2c_scl_high(tlmm)) return false;
 		delay(15);
 		if (tlmm_gpio_get(tlmm, PIN_SDA)) {
 			byte |= (1U << i);
@@ -3093,36 +3106,50 @@
 		tlmm_gpio_in(tlmm, PIN_SDA);
 	}
 	delay(15);
-	santoni_i2c_scl_high(tlmm);
+	if (!santoni_i2c_scl_high(tlmm)) return false;
 	delay(15);
 	tlmm_gpio_out_low(tlmm, PIN_SCL);
 	delay(15);
 	tlmm_gpio_in(tlmm, PIN_SDA);
-	return byte;
+	*out = byte;
+	return true;
 }
 
 static bool
 santoni_ft5435_read(vm_offset_t tlmm, uint8_t reg, uint8_t *buf, size_t len)
 {
-	santoni_i2c_start(tlmm);
-	if (!santoni_i2c_write(tlmm, FT5435_ADDR_W)) {
-		santoni_i2c_stop(tlmm);
+	santoni_i2c_diag.reg = reg;
+	santoni_i2c_diag.byte = 0;
+	santoni_i2c_diag.error = "none";
+	santoni_i2c_diag.stage = "start";
+	if (!buf || !len) {
+		santoni_i2c_diag.error = "invalid buffer/length";
 		return false;
 	}
-	if (!santoni_i2c_write(tlmm, reg)) {
-		santoni_i2c_stop(tlmm);
-		return false;
-	}
-	santoni_i2c_start(tlmm); /* repeated start */
-	if (!santoni_i2c_write(tlmm, FT5435_ADDR_R)) {
-		santoni_i2c_stop(tlmm);
-		return false;
-	}
+	if (!santoni_i2c_start(tlmm)) goto failed;
+	santoni_i2c_diag.stage = "write-address";
+	if (!santoni_i2c_write(tlmm, FT5435_ADDR_W)) goto failed;
+	santoni_i2c_diag.stage = "command";
+	if (!santoni_i2c_write(tlmm, reg)) goto failed;
+	santoni_i2c_diag.stage = "repeated-start";
+	if (!santoni_i2c_start(tlmm)) goto failed;
+	santoni_i2c_diag.stage = "read-address";
+	if (!santoni_i2c_write(tlmm, FT5435_ADDR_R)) goto failed;
+	santoni_i2c_diag.stage = "data";
 	for (size_t i = 0; i < len; i++) {
-		buf[i] = santoni_i2c_read(tlmm, i + 1 < len);
-	}
-	santoni_i2c_stop(tlmm);
+		santoni_i2c_diag.byte = i;
+		if (!santoni_i2c_read(tlmm, &buf[i], i + 1 < len)) goto failed;
+	}
+	santoni_i2c_diag.stage = "stop";
+	if (!santoni_i2c_stop(tlmm)) return false;
 	return true;
+failed: {
+	/* Best-effort STOP, always release both lines, preserve first error. */
+	const char *error = santoni_i2c_diag.error;
+	(void)santoni_i2c_stop(tlmm);
+	santoni_i2c_diag.error = error;
+	return false;
+}
 }
 
