+/* PAS callers must own and wire the page. Unlike the ordinary non-PPL cache
+ * API, this also updates the physical aperture. Refuse blocks, hints and
+ * unexpected attributes before any mutation; never split a live mapping.
+ * Both a query (expected == replacement) and a transition are checked.
+ * Based on pmap_set_cache_attributes_priv/update_cache_attributes_locked;
+ * this entry is deliberately separate from unrelated callers' policy. */
+bool __attribute__((noinline))
+pmap_santoni_pas_cache_control(ppnum_t pn, unsigned int expected, unsigned int replacement)
+{
+	pmap_paddr_t pa = ptoa(pn);
+	if (!pn || !pa_valid(pa) || PAGE_SIZE != 4096 || ARM_PGBYTES != 4096 ||
+	    (expected != VM_WIMG_DEFAULT && expected != VM_WIMG_WCOMB) ||
+	    (replacement != VM_WIMG_DEFAULT && replacement != VM_WIMG_WCOMB)) {
+		return false;
+	}
+	unsigned int pai = pa_index(pa);
+	pvh_lock(pai);
+	vm_offset_t kva = phystokv(pa);
+	pt_entry_t *pte = pmap_santoni_pas_aperture_pte(kva);
+	pt_entry_t mask = ARM_PTE_ATTRINDXMASK | ARM_PTE_SHMASK;
+	pt_entry_t wanted = wimg_to_pte(expected, pa) & mask;
+	bool valid = pte && ((*pte & (ARM_TTE_TYPE_MASK | ARM_TTE_VALID)) == ARM_PTE_TYPE) &&
+	    !(*pte & ARM_PTE_HINT_MASK) && pte_to_pa(*pte) == pa &&
+	    ((*pte & mask) == wanted) &&
+	    ((*pte & ARM_PTE_APMASK) == ARM_PTE_AP(AP_RWNA)) &&
+	    ((pmap_cache_attributes(pn) & VM_WIMG_MASK) == expected);
+	if (!valid || expected == replacement) {
+		pvh_unlock(pai);
+		return valid;
+	}
+	pp_attr_t previous, updated;
+	bool changed = false;
+	for (unsigned retry = 0; retry < 64; retry++) {
+		previous = pp_attr_table[pai];
+		updated = (previous & ~PP_ATTR_WIMG_MASK) | PP_ATTR_WIMG(replacement & VM_WIMG_MASK);
+		if (OSCompareAndSwap16(previous, updated, &pp_attr_table[pai])) {
+			changed = true;
+			break;
+		}
+	}
+	if (!changed) {
+		pvh_unlock(pai);
+		return false;
+	}
+	pt_entry_t entry = (*pte & ~mask) | wimg_to_pte(replacement, pa);
+	write_pte_strong(pte, entry);
+	flush_mmu_tlb_region_asid_async(kva, PAGE_SIZE, kernel_pmap, true);
+	/* The existing helper updates every tracked CPU alias under the PVH lock.
+	 * On Santoni (__ARM_PTE_PHYSMAP__ is unset) its aperture branch is absent;
+	 * the explicit update above and final sync cover that otherwise-stale view. */
+	(void)pmap_update_cache_attributes_locked(pn, replacement, true);
+	sync_tlb_flush();
+	valid = (*pte == entry) && ((pmap_cache_attributes(pn) & VM_WIMG_MASK) == replacement);
+	pvh_unlock(pai);
+	pmap_sync_wimg(pn, expected, replacement);
+	return valid;
+}
