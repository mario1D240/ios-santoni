 	SweetHIDButtons *self = (SweetHIDButtons *)owner;
 
 	/*
-	 * Home (Menu) press, then the release 100 ms later; Setup's "Hello"
-	 * screen waits for it. Even counts press, odd counts release.
+	 * Home (Menu) press, then the release 150 ms later.
+	 * Even counts press, odd counts release.
 	 */
 	bool press = (self->fTestCount & 1) == 0;
 	self->key(kHIDUsage_Csmr_Menu, press);
-	if (++self->fTestCount < 60) {
-		sender->setTimeoutMS(press ? 100 : self->fTestSecs * 1000);
-	}
+
+	/*
+	 * Simulate the upward home-indicator swipe that unlocks iPhone X.
+	 * Only the first three presses do this: once SpringBoard is on the
+	 * Home Screen, y = 1220 sits on the Safari dock icon and an endless
+	 * stream of swipes keeps launching Safari.  Start at y = 1270 (the
+	 * dock background, still inside the 48 px edge-tip zone) so even a
+	 * late swipe cannot hit an icon.
+	 */
+	if (press && gSweetTouch && self->fTestCount < 6) {
+		int cx = 360;
+		gSweetTouch->touch(0, true, cx, 1270);
+		for (int cy = 1050; cy >= 450; cy -= 200) {
+			delay_for_interval(10, NSEC_PER_MSEC);
+			gSweetTouch->touch(0, true, cx, cy);
+		}
+		delay_for_interval(10, NSEC_PER_MSEC);
+		gSweetTouch->touch(0, false, cx, 450);
+	}
+
+	self->fTestCount++;
+	if (self->fTestCount >= 6) {
+		IOLog("SWEET HID: unlock sequence complete, synthetic input idle\n");
+		return;		/* sweetfb_stayon keeps the panel lit */
+	}
+	sender->setTimeoutMS(press ? 150 : self->fTestSecs * 1000);
 }
 
