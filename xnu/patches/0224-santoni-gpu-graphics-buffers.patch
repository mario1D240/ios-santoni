+    memcpy(sgpu_graphics_hw.old_l3,p->memory.va+2*SGPU_PAGE,SGPU_PAGE);
+    memcpy(sgpu_graphics_hw.new_l1,m->tables,SGPU_PAGE);
+    memcpy(sgpu_graphics_hw.new_l2,m->tables+SGPU_PAGE,SGPU_PAGE);
+    memcpy(sgpu_graphics_hw.ptes,m->tables+2*SGPU_PAGE,sizeof(sgpu_graphics_hw.ptes));
+    sgpu_graphics_hw.wptr=sgpu_render_live.result.wptr;
+    if (!sgpu_graphics_hw_stop())goto done;
+    uint64_t *l3=(uint64_t *)(void *)(m->tables+2*SGPU_PAGE);
+    for (unsigned i=1;i<SGPU_RENDER_MAX_PAGES;i++)l3[i]=sgpu_graphics_hw.ptes[i]=0;
+    *(uint32_t *)(void *)(m->tables+6*SGPU_PAGE)=0;
