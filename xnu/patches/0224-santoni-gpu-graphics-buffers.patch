+    if (old->va!=sgpu_graphics_hw.old_va || m->tables!=saved->tables || m->pixels!=saved->pixels ||
+        m->pa!=saved->pa || m->pages!=SGPU_RENDER_LIVE_PAGES) return false;
+    for (unsigned i=0;i<SGPU_POOL_PAGES;i++)if(old->pa[i]!=sgpu_graphics_hw.old_pa[i])return false;
+    for (unsigned i=0;i<SGPU_RENDER_TABLE_PAGES;i++)if(m->table_pa[i]!=saved->table_pa[i])return false;
+    for (unsigned i=0;i<SGPU_RENDER_LIVE_PAGES;i++)if(m->pa[i]!=sgpu_graphics_hw.owned_pa[i])return false;
