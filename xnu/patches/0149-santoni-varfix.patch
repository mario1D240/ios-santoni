+#if defined(ARM64_BOARD_CONFIG_SANTONI)
+boolean_t santoni_varfix_enabled(void);
+boolean_t santoni_var_path(const char *path);
+
+/*
+ * SANTONI bring-up: the hand-assembled data volume has no
+ * /private/var/containers/Shared/SystemGroup/systemgroup.* directories.
+ * Daemons such as installcoordinationd run as mobile (501) and cannot create
+ * them below root:wheel 0755, so they abort with EACCES and leave
+ * DataMigration and backboardd's shell check-in waiting forever.
+ *
+ * santoni_varfix=1 retries a failed mkdir below one of the data-volume
+ * subtrees with a root credential and gives the new directory back to the
+ * caller.  This is a bring-up aid, not a general privilege bypass: it is
+ * limited to /private/var and rejects ".." components.  It can be turned off
+ * with santoni_varfix=0 once the volume is provisioned properly.
+ */
+static int santoni_varfix = -1;
+
+boolean_t
+santoni_varfix_enabled(void)
+{
+	int v = 1;
+
+	if (santoni_varfix < 0) {
+		if (!PE_parse_boot_argn("santoni_varfix", &v, sizeof(v))) {
+			v = 1;
+		}
+		santoni_varfix = (v != 0);
+	}
+	return santoni_varfix != 0;
+}
+
+boolean_t
+santoni_var_path(const char *path)
+{
+	const char *rest;
+	const char *p;
+
+	if (path == NULL) {
+		return FALSE;
+	}
+	for (p = path; p[0] != '\0' && p[1] != '\0'; p++) {
+		if (p[0] == '.' && p[1] == '.' &&
+		    (p == path || p[-1] == '/') &&
+		    (p[2] == '\0' || p[2] == '/')) {
+			return FALSE;
+		}
+	}
+	if (strncmp(path, "/private/var", 12) == 0) {
+		rest = path + 12;
+	} else if (strncmp(path, "/var", 4) == 0) {
+		rest = path + 4;
+	} else {
+		return FALSE;
+	}
+	return rest[0] == '\0' || rest[0] == '/';
+}
+
+static int
+santoni_copy_path(user_addr_t path, enum uio_seg segflg, char *buf, size_t bufsz)
+{
+	size_t copied = 0;
+	int error;
+
+	if (UIO_SEG_IS_USER_SPACE(segflg)) {
+		error = copyinstr(path, buf, bufsz, &copied);
+	} else {
+		error = copystr(CAST_DOWN(void *, path), buf, bufsz, &copied);
+	}
+	buf[bufsz - 1] = '\0';
+	return error;
+}
+
+static int
+santoni_chown_created(vfs_context_t rctx, const char *path, uid_t uid, gid_t gid)
+{
+	vnode_t vp = NULLVP;
+	struct vnode_attr va;
+	int error;
+
+	if (uid == 0 && gid == 0) {
+		return 0;
+	}
+	error = vnode_lookup(path, 0, &vp, rctx);
+	if (error != 0) {
+		return error;
+	}
+	VATTR_INIT(&va);
+	VATTR_SET(&va, va_uid, uid);
+	VATTR_SET(&va, va_gid, gid);
+	error = vnode_setattr(vp, &va, rctx);
+	vnode_put(vp);
+	return error;
+}
