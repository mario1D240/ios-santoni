+			    santoni_smd.fifo_off < RPM_MSGRAM_SIZE) {
+				santoni_smd.alt_tried = true;
+				santoni_smd.txfifo = santoni_smd.msgram +
+				    santoni_smd.fifo_off;
+				santoni_smd.rxfifo = santoni_smd.txfifo +
+				    santoni_smd.fifo_size;
+				smd_write32(santoni_smd.txinfo, INFO_HEAD, 0);
+				smd_write32(santoni_smd.rxinfo, INFO_TAIL, 0);
+				santoni_smd_kick();
+				printf("SANTONI RPM: fifo rebased to "
+				    "msgram+%#x, retrying\n",
+				    santoni_smd.fifo_off);
+			}
 		}
 	}
 	if (!santoni_smd.resp_ready) {
-		printf("SANTONI RPM: L%u: no answer\n", ldo);
