Subject: [PATCH] santoni: wire both volume keys and stop synthetic Home presses

diff --git a/bsd/dev/santoni_sdhci.c b/bsd/dev/santoni_sdhci.c
--- a/bsd/dev/santoni_sdhci.c
+++ b/bsd/dev/santoni_sdhci.c
@@ -3160,10 +3160,11 @@
 static bool
 santoni_spmi_read(uint16_t addr, uint8_t *out)
 {
-	static vm_offset_t core, obs;
-	static int obs_apid = -1;
+	static vm_offset_t core, observers[SPMI_APID_MAX];
+	/* This reader addresses SID 0: cache APID + 1 by peripheral ID. */
+	static uint16_t apid_for_periph[256];
 	uint16_t ppid = (addr >> 8) & 0xfffU;
-	int apid = -1;
+	int apid = (int)apid_for_periph[ppid] - 1;
 
 	if (!core) {
 		core = ml_io_map(SPMI_CORE_PHYS, 0x1000);
@@ -3177,10 +3178,11 @@
 	/* v2 (0x20020000 on santoni) uses APID-indexed map at 0x800.
 	 * Linux pmic_arb_apid_map_offset_v2() = 0x800 + 4*APID; v7 uses
 	 * 0x2000 + 4*APID. The 0x2000 PPID table does not exist on v2. */
-	for (int i = 0; i < SPMI_APID_MAX; i++) {
+	for (int i = 0; apid < 0 && i < SPMI_APID_MAX; i++) {
 		uint32_t map = *(volatile uint32_t *)(core + 0x800 + 4 * i);
 		if (map && ((map >> 8) & 0xfffU) == ppid) {
 			apid = i;
+			apid_for_periph[ppid] = (uint16_t)(apid + 1);
 			break;
 		}
 	}
@@ -3188,13 +3190,11 @@
 	if (apid < 0) {
 		return false;
 	}
-	if (apid != obs_apid) {
-		obs = ml_io_map(SPMI_OBS_PHYS + 0x8000UL * (uint32_t)apid, 0x1000);
-		obs_apid = obs ? apid : -1;
-		if (!obs) {
-			return false;
-		}
-	}
+	if (!observers[apid]) {
+		observers[apid] = ml_io_map(SPMI_OBS_PHYS + 0x8000UL * (uint32_t)apid, 0x1000);
+	}
+	vm_offset_t obs = observers[apid];
+	if (!obs) return false;
 	*(volatile uint32_t *)(obs + 0x00) =
 	    SPMI_CMD_EXT_READL | ((uint32_t)(addr & 0xffU) << 4);
 	__asm__ volatile("dsb sy" ::: "memory");
@@ -4374,6 +4374,46 @@
 	    tlmm_cfg_read(tlmm, pin), (unsigned)tlmm_gpio_get(tlmm, pin));
 }
 
+/* Linux pm8941-pwrkey.c: PM8937 SID 0 PON + RT_STS, bit 1 = RESIN pressed. */
+#define SANTONI_PON_RT_STS       0x0810u
+#define SANTONI_PON_RESIN        (1u << 1)
+
+struct santoni_key_state {
+	bool raw, down;
+	unsigned stable;
+};
+
+static void
+santoni_key_sample(struct santoni_key_state *key, int code, bool down)
+{
+	if (down != key->raw) {
+		key->raw = down;
+		key->stable = 1;
+	} else if (key->stable < 3) {
+		key->stable++;
+	}
+	if (key->stable == 3 && down != key->down) {
+		key->down = down;
+		printf("SANTONI KEYS: Vol%s %s\n", code == 1 ? "Up" : "Down",
+		    down ? "PRESSED" : "RELEASED");
+		sweet_hid_key(code, down ? 1 : 0);
+	}
+}
+
+static void
+santoni_volume_poll(vm_offset_t tlmm, struct santoni_key_state *up,
+    struct santoni_key_state *down)
+{
+	santoni_key_sample(up, 1, tlmm_gpio_get(tlmm, PIN_VOL_UP) == 0);
+	uint8_t status;
+	if (santoni_spmi_read(SANTONI_PON_RT_STS, &status)) {
+		santoni_key_sample(down, 2, (status & SANTONI_PON_RESIN) != 0);
+	} else {
+		/* An unreadable PMIC is not a release. Require fresh stable samples. */
+		down->stable = 0;
+	}
+}
+
 static void
 santoni_keys_thread(__unused void *param, __unused wait_result_t wr)
 {
@@ -4446,30 +4486,12 @@
 	bool active[10] = {false};
 	int last_x[10] = {0};
 	int last_y[10] = {0};
-	bool volup_raw = (tlmm_gpio_get(tlmm, PIN_VOL_UP) == 0);
-	bool volup_last = volup_raw;
-	int volup_stable = 0;
+	struct santoni_key_state volup = {0}, voldown = {0};
 	unsigned int tick = 0, nack = 0, bad = 0, reports = 0;
 
 	for (;;) {
-		/* Volume Up with a three-sample debounce (loop is 100 Hz). */
-		bool now = (tlmm_gpio_get(tlmm, PIN_VOL_UP) == 0);
-		if (now == volup_raw) {
-			if (volup_stable < 3) {
-				volup_stable++;
-			}
-		} else {
-			volup_raw = now;
-			volup_stable = 0;
-		}
-		if (volup_stable >= 3 && now != volup_last) {
-			volup_last = now;
-			printf("SANTONI KEYS: VolUp %s (91 in=%u)\n",
-			    now ? "PRESSED" : "RELEASED",
-			    (unsigned)tlmm_gpio_get(tlmm, PIN_VOL_UP));
-			sweet_hid_key(1, now ? 1 : 0);
-			sweet_hid_key(3, now ? 1 : 0);
-		}
+		/* Independent volume keys; neither key is an alias for Home. */
+		santoni_volume_poll(tlmm, &volup, &voldown);
 
 		/* One-line status every 2 s: a single photo of the boot
 		 * console shows exactly where the touch bring-up stands. */
diff --git a/iokit/Kernel/arm/hid/SweetHID.cpp b/iokit/Kernel/arm/hid/SweetHID.cpp
--- a/iokit/Kernel/arm/hid/SweetHID.cpp
+++ b/iokit/Kernel/arm/hid/SweetHID.cpp
@@ -337,8 +337,8 @@
 private:
 	static void testFired(OSObject *owner, IOTimerEventSource *sender);
 	IOTimerEventSource *fTest;
-	UInt32 fTestSecs;
-	UInt32 fTestCount;
+	UInt32 fTestSecs = 0;
+	UInt32 fTestCount = 0;
 };
 OSDefineMetaClassAndStructors(SweetHIDButtons, IOHIDEventService);
 
@@ -378,6 +378,7 @@
 
 static SweetHIDButtons *gSweetButtons;
 static SweetHIDTouch *gSweetTouch;
+static bool gSweetPhysicalInput;
 
 bool
 SweetHIDButtons::start(IOService *provider)
@@ -414,37 +415,36 @@
 SweetHIDButtons::testFired(OSObject *owner, IOTimerEventSource *sender)
 {
 	SweetHIDButtons *self = (SweetHIDButtons *)owner;
-
 	/*
-	 * Home (Menu) press, then the release 150 ms later.
-	 * Even counts press, odd counts release.
+	 * Explicit bring-up aid only (sweethidtest=N). The old timer stopped
+	 * swiping after four attempts but kept pressing Home forever, closing
+	 * whichever app the user opened. Display keep-awake is handled by the
+	 * framebuffer's sweetfb_stayon, not synthetic keyboard events.
 	 */
-	bool press = (self->fTestCount & 1) == 0;
-	self->key(kHIDUsage_Csmr_Menu, press);
-
-	/*
-	 * Simulate the upward home-indicator swipe that unlocks iPhone X.
-	 * Only swipe when backboardd has attached as a client (hasClients()).
-	 * Once 4 swipes have been successfully delivered to backboardd,
-	 * synthetic swipe stops so it does not tap the Home Screen or Safari.
-	 * The timer continues running to keep the display awake.
-	 */
-	static int sSwipeDelivered = 0;
-	if (press && gSweetTouch && gSweetTouch->hasClients() && sSwipeDelivered < 4) {
-		int cx = 360;
-		gSweetTouch->touch(0, true, cx, 1270);
-		for (int cy = 1050; cy >= 450; cy -= 200) {
-			delay_for_interval(10, NSEC_PER_MSEC);
-			gSweetTouch->touch(0, true, cx, cy);
-		}
+	if (__atomic_load_n(&gSweetPhysicalInput, __ATOMIC_ACQUIRE) || self->fTestCount >= 4) {
+		return;
+	}
+	if (!gSweetTouch || !gSweetTouch->hasClients()) {
+		sender->setTimeoutMS(self->fTestSecs * 1000);
+		return;
+	}
+
+	/* Santoni FT reports use IDs 0..4; keep the synthetic contact separate. */
+	const int finger = SWEET_TOUCH_FINGERS - 1;
+	int cy = 1270;
+	gSweetTouch->touch(finger, true, 360, cy);
+	for (int next = 1050; next >= 450; next -= 200) {
 		delay_for_interval(10, NSEC_PER_MSEC);
-		gSweetTouch->touch(0, false, cx, 450);
-		sSwipeDelivered++;
-		IOLog("SWEET HID: unlock swipe %d delivered to backboardd\n", sSwipeDelivered);
-	}
-
+		if (__atomic_load_n(&gSweetPhysicalInput, __ATOMIC_ACQUIRE)) break;
+		cy = next;
+		gSweetTouch->touch(finger, true, 360, cy);
+	}
+	gSweetTouch->touch(finger, false, 360, cy);
 	self->fTestCount++;
-	sender->setTimeoutMS(press ? 150 : self->fTestSecs * 1000);
+	IOLog("SWEET HID: unlock swipe %u delivered to backboardd\n", self->fTestCount);
+	if (self->fTestCount < 4 && !__atomic_load_n(&gSweetPhysicalInput, __ATOMIC_ACQUIRE)) {
+		sender->setTimeoutMS(self->fTestSecs * 1000);
+	}
 }
 
 bool
@@ -587,6 +587,7 @@
 	};
 
 	if (gSweetButtons && key >= 0 && key < (int)(sizeof(usages) / sizeof(usages[0]))) {
+		if (down) __atomic_store_n(&gSweetPhysicalInput, true, __ATOMIC_RELEASE);
 		gSweetButtons->key(usages[key], down != 0);
 	}
 }
@@ -594,7 +595,8 @@
 extern "C" void
 sweet_hid_touch(int finger, int down, int x, int y)
 {
-	if (gSweetTouch) {
+	if (gSweetTouch && finger >= 0 && finger < SWEET_TOUCH_FINGERS) {
+		if (down) __atomic_store_n(&gSweetPhysicalInput, true, __ATOMIC_RELEASE);
 		gSweetTouch->touch(finger, down != 0, x, y);
 	}
 }
