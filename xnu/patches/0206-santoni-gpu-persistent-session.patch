+uint32_t sgpu_session_close(struct sgpu_session_queue *q, uint32_t owner)
+{
+    if (!q || owner!=SGPU_SESSION_OWNER) return SG_SESSION_BAD_REQUEST;
+    if (!q->initialized) return SG_SESSION_NOT_READY;
+    if (!session_terminal(q)) { q->close_requested=true; q->status.state=SG_SESSION_CLOSING; }
+    return SG_SESSION_OK; /* worker observes this before commitment or after its bounded operation */
+}
