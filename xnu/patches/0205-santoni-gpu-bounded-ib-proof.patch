+/* Private kernel-only G3 contracts, included by the portable core.
+ * No platform calls, user mappings, live PTE removal or arbitrary IB packets.
+ * One serialized owner/caller; this is NOT a concurrent IOUserClient API.
+ * VAs use the upper half of the existing Santoni 2MiB L3 window. Physical
+ * pages come only from the unused tail of its validated owned 96KiB pool.
+ * Existing PTE_RO/PTE_RW derive from the actually programmed CB0 attributes.
+ */
+#define SG_G3_FIRST_SLOT (0x100000u / SGPU_PAGE)
+#define SG_G3_SLOTS (0x200000u / SGPU_PAGE)
+#define SG_G3_BOS 6u
+#define SG_G3_MAX_WORDS 64u
+#define SG_G3_BATCH_WORDS 11u
+enum sgpu_g3_role { SG_G3_DATA = 1, SG_G3_IB, SG_G3_FENCE };
+struct sgpu_g3_bo {
+    uint32_t owner, handle, bytes, first, pages, role, last_seq;
+    uint8_t physical[SGPU_POOL_PAGES];
+    bool retired, quarantine;
+};
+struct sgpu_g3 {
+    struct sgpu_memory *memory;
+    struct sgpu_g3_bo bo[SG_G3_BOS];
+    uint8_t physical_used[SGPU_POOL_PAGES], va_used[SG_G3_SLOTS];
+    uint32_t next_handle, submitted, completed, busy;
+    bool sealed, failed;
+};
+
+static struct sgpu_g3_bo *sgpu_g3_lookup(struct sgpu_g3 *g, uint32_t owner, uint32_t handle)
+{
+    if (!g || !owner || !handle) return NULL;
+    for (unsigned i = 0; i < SG_G3_BOS; i++)
+        if (g->bo[i].handle == handle && g->bo[i].owner == owner && !g->bo[i].retired)
+            return &g->bo[i];
+    return NULL;
+}
+
+static bool __attribute__((noinline)) sgpu_g3_init(struct sgpu_g3 *g,
+    struct sgpu_memory *memory, uint32_t first_physical)
+{
+    if (!g || !sgpu_memory_validate(memory) || first_physical < 7 || first_physical >= SGPU_POOL_PAGES)
+        return false;
+    uint64_t *l1 = (uint64_t *)(void *)memory->va;
+    uint64_t *l2 = (uint64_t *)(void *)(memory->va + SGPU_PAGE);
+    uint64_t *l3 = (uint64_t *)(void *)(memory->va + 2 * SGPU_PAGE);
+    if (l1[0] != (memory->pa[1] | 3) || l2[SGPU_VA_BASE >> 21] != (memory->pa[2] | 3)) return false;
+    for (unsigned i = SG_G3_FIRST_SLOT; i < SG_G3_SLOTS; i++) if (l3[i]) return false;
+    /* Reject a supposedly spare physical page referenced by ANY old mapping. */
+    for (unsigned i = 0; i < SG_G3_FIRST_SLOT; i++)
+        for (unsigned j = first_physical; j < SGPU_POOL_PAGES; j++)
+            if ((l3[i] & 0x0000fffffffff000ull) == memory->pa[j]) return false;
+    *g = (struct sgpu_g3){.memory = memory, .next_handle = 1};
+    for (unsigned i = 0; i < first_physical; i++) g->physical_used[i] = 1;
+    return true;
+}
+
+static uint32_t __attribute__((noinline)) sgpu_g3_new(struct sgpu_g3 *g,
+    uint32_t owner, uint32_t bytes, enum sgpu_g3_role role)
+{
+    if (!g || !g->memory || !owner || !bytes || bytes > SGPU_POOL_BYTES ||
+        role < SG_G3_DATA || role > SG_G3_FENCE || g->sealed || g->failed ||
+        !g->next_handle || g->next_handle == UINT32_MAX) return 0;
+    unsigned pages = (bytes + SGPU_PAGE - 1) / SGPU_PAGE;
+    unsigned index = SG_G3_BOS, first = 0, run = 0, count = 0;
+    uint8_t physical[SGPU_POOL_PAGES];
+    uint64_t *l3 = (uint64_t *)(void *)(g->memory->va + 2 * SGPU_PAGE);
+    for (unsigned i = 0; i < SG_G3_BOS; i++) if (!g->bo[i].handle) { index = i; break; }
+    if (index == SG_G3_BOS) return 0;
+    for (unsigned i = SG_G3_FIRST_SLOT; i < SG_G3_SLOTS; i++) {
+        run = g->va_used[i] || l3[i] ? 0 : run + 1;
+        if (run == pages + 1) { first = i - pages; break; }
+    }
+    if (!first) return 0;
+    for (unsigned i = 0; i < SGPU_POOL_PAGES && count < pages; i++)
+        if (!g->physical_used[i]) physical[count++] = (uint8_t)i;
+    if (count != pages) return 0;
+    struct sgpu_g3_bo *b = &g->bo[index];
+    *b = (struct sgpu_g3_bo){.owner=owner, .handle=g->next_handle++, .bytes=bytes,
+        .first=first, .pages=pages, .role=(uint32_t)role};
+    for (unsigned i = 0; i < pages; i++) {
+        b->physical[i] = physical[i];
+        g->physical_used[physical[i]] = 1;
+        g->va_used[first+i] = 1;
+        l3[first+i] = g->memory->pa[physical[i]] | (role == SG_G3_IB ? PTE_RO : PTE_RW);
+    }
+    g->va_used[first+pages] = 1; /* guard reserved in metadata, PTE stays invalid */
+    return b->handle;
+}
+
+static bool __attribute__((noinline)) sgpu_g3_free(struct sgpu_g3 *g, uint32_t owner, uint32_t handle)
+{
+    struct sgpu_g3_bo *b = sgpu_g3_lookup(g, owner, handle);
+    if (!b) return false;
+    if (g->sealed || b->last_seq > g->completed) {
+        b->retired = b->quarantine = true;
+        if (b->last_seq > g->completed) g->failed = true;
+        return false; /* no PTE clear, physical release or VA reuse after exposure */
+    }
+    uint64_t *l3 = (uint64_t *)(void *)(g->memory->va + 2 * SGPU_PAGE);
+    for (unsigned i = 0; i < b->pages; i++) {
+        l3[b->first+i] = 0;
+        g->va_used[b->first+i] = 0;
+        g->physical_used[b->physical[i]] = 0;
+    }
+    g->va_used[b->first+b->pages] = 0;
+    *b = (struct sgpu_g3_bo){0};
+    return true;
+}
+
+static bool sgpu_g3_mapping(struct sgpu_g3 *g, const struct sgpu_g3_bo *b)
+{
+    if (!b || !b->pages || b->pages > SGPU_POOL_PAGES || b->first < SG_G3_FIRST_SLOT ||
+        b->first >= SG_G3_SLOTS || b->pages >= SG_G3_SLOTS - b->first ||
+        !b->bytes || b->bytes > b->pages * SGPU_PAGE || b->retired || b->quarantine) return false;
+    uint64_t *l3 = (uint64_t *)(void *)(g->memory->va + 2 * SGPU_PAGE);
+    for (unsigned i = 0; i < b->pages; i++) {
+        if (b->physical[i] >= SGPU_POOL_PAGES || !g->physical_used[b->physical[i]] ||
+            !g->va_used[b->first+i] || l3[b->first+i] != (g->memory->pa[b->physical[i]] |
+            (b->role == SG_G3_IB ? PTE_RO : PTE_RW))) return false;
+    }
+    return g->va_used[b->first+b->pages] && !l3[b->first+b->pages];
+}
+
+static uint32_t sgpu_g3_va(const struct sgpu_g3_bo *b)
+{ return SGPU_VA_BASE + b->first * SGPU_PAGE; }
+
+/* This first IB contract admits only CP_MEM_WRITE to one declared owned DATA
+ * BO and WAIT_FOR_IDLE. No register packets, nested IB, arbitrary event/fence
+ * writes, relocs or user physical addresses. The kernel owns the immutable IB
+ * page until completion; adding a user client requires a private snapshot. */
+static bool __attribute__((noinline)) sgpu_g3_begin(struct sgpu_g3 *g, uint32_t owner,
+    uint32_t ib_handle, uint32_t data_handle, uint32_t fence_handle, uint32_t words,
+    uint32_t batch[SG_G3_BATCH_WORDS])
+{
+    if (!g || !g->memory || !batch || !g->sealed || g->failed || g->busy ||
+        !words || words > SG_G3_MAX_WORDS || g->submitted == UINT32_MAX) return false;
+    struct sgpu_g3_bo *ib=sgpu_g3_lookup(g,owner,ib_handle), *data=sgpu_g3_lookup(g,owner,data_handle),
+        *fence=sgpu_g3_lookup(g,owner,fence_handle);
+    if (!sgpu_g3_mapping(g,ib) || !sgpu_g3_mapping(g,data) || !sgpu_g3_mapping(g,fence) ||
+        ib->role != SG_G3_IB || data->role != SG_G3_DATA || fence->role != SG_G3_FENCE ||
+        ib->pages != 1 || words * 4 > ib->bytes || fence->bytes < 64) return false;
+    const uint32_t *commands=(const uint32_t *)(const void *)(g->memory->va + ib->physical[0]*SGPU_PAGE);
+    unsigned writes=0;
+    for (unsigned i=0; i<words;) {
+        if (commands[i] == sgpu_packet7(0x26,0)) { i++; continue; }
+        if (commands[i] != sgpu_packet7(0x3d,3) || words-i < 4 || commands[i+2]) return false;
+        uint32_t va=commands[i+1], base=sgpu_g3_va(data);
+        if ((va & 3) || va < base || data->bytes < 4 || va-base > data->bytes-4) return false;
+        writes++; i+=4;
+    }
+    if (!writes) return false;
+    uint32_t seq=g->submitted+1;
+    /* Target stock adreno_pm4types.h: CP_INDIRECT_BUFFER_PFE=0x3f, three
+     * payload dwords for A5xx's 64-bit address. CACHE_FLUSH_TS event4 follows
+     * the existing Santoni blit's event fence, using a GPU VA, never a PA. */
+    uint32_t values[SG_G3_BATCH_WORDS]={sgpu_packet7(0x3f,3),sgpu_g3_va(ib),0,words,
+        sgpu_packet7(0x26,0),sgpu_packet7(0x46,4),4,sgpu_g3_va(fence),0,seq,sgpu_packet7(0x26,0)};
+    g->submitted=g->busy=seq; /* exposure bookkeeping BEFORE caller can submit */
+    ib->last_seq=data->last_seq=fence->last_seq=seq;
+    for (unsigned i=0;i<SG_G3_BATCH_WORDS;i++) batch[i]=values[i];
+    return true;
+}
+
+static bool __attribute__((noinline)) sgpu_g3_complete(struct sgpu_g3 *g, uint32_t owner,
+    uint32_t fence_handle, uint32_t observed)
+{
+    struct sgpu_g3_bo *f=sgpu_g3_lookup(g,owner,fence_handle);
+    if (!g || g->failed || !g->busy || !f || f->role != SG_G3_FENCE ||
+        f->last_seq != g->busy || observed != g->busy) return false;
+    g->completed=observed; g->busy=0;
+    return true; /* physical memory and mappings still retained until reboot */
+}
+
+static void __attribute__((noinline)) sgpu_g3_abort(struct sgpu_g3 *g)
+{
+    g->failed=true;
+    for (unsigned i=0;i<SG_G3_BOS;i++) if (g->bo[i].handle) g->bo[i].quarantine=true;
 }

