+static bool session_check(enum sgpu_block block, uint32_t off, uint32_t want)
+{
+    uint64_t now;
+    if (!session_time(SG_SESSION_READINESS,&now)) return false;
+    if (!sgpu_stock_check32(&session_core.p,block,off,want))
+        return session_fail(SG_BAD_SMMU,SG_SESSION_READINESS);
+    return session_time(SG_SESSION_READINESS,&now);
+}
