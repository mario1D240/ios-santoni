     struct sgpu_memory memory;
     struct saved_reg saved[32];
     uint32_t saved_count;
-    bool gpu_live, smmu_live, dma_exposed, restoring, gpu_owned, gx_touched;
+    bool gpu_live, smmu_live, dma_exposed, restoring, gpu_owned, gx_touched, commands_started;
 };
 
 static uint32_t little32(const uint8_t *p)
@@ -383,18 +383,22 @@
 static void faults(struct probe *p)
 {
     p->report->status = read32(p, SG_GPU, SG_STATUS);
