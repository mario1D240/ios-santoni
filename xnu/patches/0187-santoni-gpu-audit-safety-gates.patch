+/* clock-local2.c accepts clock ON or NOC-FSM-ON, but only exact OFF on disable.
+ * All six target branches use HALT checking; do not confuse enable-bit echo
+ * with completion of a clock-domain transition. */
+static bool __attribute__((noinline)) branch_state(struct probe *p, uint32_t off, bool on)
+{
+    const uint32_t mask = 0xf0000000u;
+    uint64_t start = p->ops->now_us(p->ops->ctx);
+    uint32_t got = 0;
+    for (unsigned i = 0; i <= 100; i++) {
+        got = read32(p, SG_CC, off);
+        uint32_t status = got & mask;
+        if (on ? (status == 0 || status == BIT(29)) : status == BIT(31)) return true;
+        if (p->ops->now_us(p->ops->ctx) - start >= 10000) break;
+        if (i != 100) wait_us(p, 100);
+    }
+    uint64_t elapsed = p->ops->now_us(p->ops->ctx) - start;
+    sgpu_failure(p, SG_FAIL_POLL, SG_CC, off, mask, on ? 0 : BIT(31), 0, 0,
+        got, elapsed > (uint64_t)~0u ? ~0u : (uint32_t)elapsed, 10000);
+    return false;
+}
