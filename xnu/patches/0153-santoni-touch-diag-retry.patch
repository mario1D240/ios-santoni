@@ -3760,6 +3777,44 @@
 			sweet_hid_key(3, now ? 1 : 0);
 		}
 
+		/* One-line status every 2 s: a single photo of the boot
+		 * console shows exactly where the touch bring-up stands. */
+		if ((tick % 200) == 0) {
+			printf("SANTONI DIAG: rpm ch=%d open=%d L10=%d L5=%d "
+			    "rxst=%u pmicL5=%02x pmicL10=%02x probe=%d "
+			    "nack=%u bad=%u rep=%u\n",
+			    santoni_smd.mapped ? 1 : 0,
+			    santoni_smd.open ? 1 : 0,
+			    santoni_diag.l10, santoni_diag.l5,
+			    santoni_smd.mapped ?
+			    smd_read32(santoni_smd.rxinfo, INFO_STATE) : 99u,
+			    santoni_diag.l5_en, santoni_diag.l10_en,
+			    last_rc, nack, bad, reports);
+		}
+
+		/* Retry the rail votes every 10 s until they stick: the RPM
+		 * may not have the channel ready a few seconds into boot.
+		 * Whenever L10 finally lands, re-read the PMIC and pulse
+		 * the touch reset again (power-cycle order). */
+		if (rpm_on && !rails_ok && (tick % 1000) == 0) {
+			printf("SANTONI RPM: retrying touch rails\n");
+			bool l10r = santoni_rpm_ldo(10, 2850000);
+			(void)santoni_rpm_ldo(5, 1800000);
+			santoni_diag.l10 = l10r ? 1 : -1;
+			if (l10r) {
+				rails_ok = true;
+				santoni_pmic_report();
