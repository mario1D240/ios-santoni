+static uint32_t sgpu_render_enabled, sgpu_render_allocation_attempted;
+static vm_offset_t sgpu_render_tables_kva, sgpu_render_pixels_kva;
+static bool sgpu_render_allocation_retained;
+static uint64_t sgpu_render_page_pas[SGPU_RENDER_LIVE_PAGES];
+static struct sgpu_render_memory sgpu_render_owned;
+
+static bool __attribute__((noinline)) sgpu_render_options(uint32_t mode)
+{
+    uint32_t enabled = 0, user_exec = 0, zap = 0, scm = 0, cache = 0;
+    sgpu_render_enabled = 0;
+    (void)PE_parse_boot_argn("santonigpu_render", &enabled, sizeof(enabled));
+    if (enabled == 0) return true;
+    (void)PE_parse_boot_argn("santonigpu_user_exec", &user_exec, sizeof(user_exec));
+    (void)PE_parse_boot_argn("santonigpu_zap", &zap, sizeof(zap));
+    (void)PE_parse_boot_argn("santonigpu_scm", &scm, sizeof(scm));
+    (void)PE_parse_boot_argn("santonigpu_cache", &cache, sizeof(cache));
+    if (enabled != 1 || mode != 3 || sg.stock_unsecure != 1 || sg.stock_pixels != 1 ||
+        sg.g3 != 1 || sg.session != 1 || sg.user || sg.user_test || user_exec || zap || scm || cache) return false;
+    sgpu_render_enabled = 1;
+    return true;
+}
+
+static void __attribute__((noinline)) sgpu_render_release(void)
+{
+    if (sgpu_render_allocation_retained) return;
+    if (sgpu_render_pixels_kva) kmem_free(kernel_map,sgpu_render_pixels_kva,
+        SGPU_RENDER_LIVE_PAGES * SGPU_PAGE);
+    if (sgpu_render_tables_kva) kmem_free(kernel_map,sgpu_render_tables_kva,
+        SGPU_RENDER_TABLE_PAGES * SGPU_PAGE);
+    sgpu_render_pixels_kva = sgpu_render_tables_kva = 0;
+    sgpu_render_owned = (struct sgpu_render_memory){0};
+}
+
+static bool __attribute__((noinline)) sgpu_render_allocate(void)
+{
+    if (sgpu_render_enabled != 1 || sgpu_render_allocation_attempted ||
+        page_shift != 12 || page_size != SGPU_PAGE) return false;
+    sgpu_render_allocation_attempted = 1;
+    if (kmem_alloc(kernel_map,&sgpu_render_tables_kva,SGPU_RENDER_TABLE_PAGES * SGPU_PAGE,
+        KMA_DATA | KMA_ZERO,VM_KERN_MEMORY_IOKIT) != KERN_SUCCESS) return false;
+    if (kmem_alloc(kernel_map,&sgpu_render_pixels_kva,SGPU_RENDER_LIVE_PAGES * SGPU_PAGE,
+        KMA_DATA | KMA_ZERO,VM_KERN_MEMORY_IOKIT) != KERN_SUCCESS) {
+        sgpu_render_release(); return false;
+    }
+    sgpu_render_owned = (struct sgpu_render_memory){.tables=(uint8_t *)sgpu_render_tables_kva,
+        .pixels=(uint8_t *)sgpu_render_pixels_kva,.pa=sgpu_render_page_pas,.pages=SGPU_RENDER_LIVE_PAGES};
+    for (unsigned i = 0; i < SGPU_RENDER_TABLE_PAGES; i++)
+        sgpu_render_owned.table_pa[i] = (uint64_t)pmap_find_phys(kernel_pmap,
+            sgpu_render_tables_kva + i * SGPU_PAGE) << 12;
+    for (unsigned i = 0; i < SGPU_RENDER_LIVE_PAGES; i++)
+        sgpu_render_page_pas[i] = (uint64_t)pmap_find_phys(kernel_pmap,
+            sgpu_render_pixels_kva + i * SGPU_PAGE) << 12;
+    if (!sgpu_render_validate(&sgpu_render_owned)) { sgpu_render_release(); return false; }
+    return true; /* individually verified pages; no physical-contiguity assumption */
+}
+
+static void __attribute__((noinline)) sgpu_render_worker(const struct sgpu_ops *ops,
+    const uint8_t *firmware, size_t bytes, struct sgpu_report *boot)
+{
+    if (sgpu_render_enabled != 1 || !ops || !boot) return;
+    if (!sgpu_render_allocate()) {
+        printf("SANTONI GPU: RENDER allocation rejected; no bootstrap/new GPU access\n");
+        return;
+    }
+    struct sgpu_render_live_result result = {0};
+    sgpu_render_allocation_retained = true; /* never release while the call may expose pages */
+    bool passed = sgpu_render_live_start(ops,sg.mode,sgpu_render_enabled,firmware,bytes,
+        &sgpu_render_owned,boot,&result);
+    if (!result.exposed) {
+        sgpu_render_allocation_retained = false;
+        sgpu_render_release(); /* only newly owned spans; legacy retention is unchanged */
+    }
+    sgpu_failure_summary("RENDER FIRST_FAIL",&result.failure);
+    printf("SANTONI GPU: RENDER RESULT pass=%u phase=%u error=%u submitted=%u completed=%u seq=%u wptr=%u pixels=%u width=%u height=%u stride=%u\n",
+        passed?1u:0u,result.phase,result.error,result.submitted,result.completed,result.sequence,
+        result.wptr,result.pixels,SGPU_RENDER_WIDTH,SGPU_RENDER_HEIGHT,SGPU_RENDER_STRIDE);
+    printf("SANTONI GPU: RENDER STATE started=%u exposed=%u publish_attempted=%u retained_new=%u retained_legacy=%u; OFFSCREEN BGRA ONLY; NO PAS; CPU DISPLAY/INPUT RETAINED\n",
+        result.started?1u:0u,result.exposed?1u:0u,result.publish_attempted?1u:0u,
+        sgpu_render_allocation_retained ? (SGPU_RENDER_TABLE_PAGES + SGPU_RENDER_LIVE_PAGES)*SGPU_PAGE : 0u,
+        boot->memory_retained ? SGPU_POOL_BYTES : 0u);
+}
+
